+// private copy so a render can never read a pair being rewritten. Returns the id
+// to render — on timeout the PREVIOUS id, i.e. render again rather than stall the
+// game loop (the compositor reprojects a repeat far better than it survives a
+// hitch).
+unsigned long long VKQ_VR_EngineAcquire (int timeout_ms)
+{
+	struct timespec ts;
+	vkq_vr_deadline (&ts, timeout_ms);
+	pthread_mutex_lock (&vkq_vr_mtx);
+	while (vkq_vr_active && vkq_vr_pub_id <= vkq_vr_frame_id)
+		if (pthread_cond_timedwait (&vkq_vr_cv, &vkq_vr_mtx, &ts) != 0)
+		{
+			vkq_vr_timeouts_engine++;
+			break;
+		}
+	if (vkq_vr_have)
+	{
+		memcpy (vkq_vr_cur, vkq_vr_pub, sizeof (vkq_vr_cur));
+		vkq_vr_frame_id = vkq_vr_pub_id;
+	}
+	pthread_mutex_unlock (&vkq_vr_mtx);
+	return vkq_vr_frame_id;
