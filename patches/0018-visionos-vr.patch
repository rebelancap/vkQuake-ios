+		// facing, minus wherever the head happens to be pointing, so entering VR
+		// changes nothing about where they are looking.
+		vkq_vr_yaw_init = 0;
+		vkq_vr_body_yaw = anglemod (cl.viewangles[YAW] - vkq_vr_head_yaw);
+		last_sent = cl.viewangles[YAW];
+	}
+	delta = cl.viewangles[YAW] - last_sent;
+	while (delta > 180.0f)
+		delta -= 360.0f;
+	while (delta < -180.0f)
+		delta += 360.0f;
