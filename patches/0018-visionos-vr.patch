+// Head aim (charter A6, gamepad path): whatever this frame's input did to the
+// yaw is absorbed into the BODY yaw — so a stick turn rotates render, aim and
+// movement together — and the sent angles become body + head. Pitch and roll
+// come from the head alone. Reading the delta instead of hooking each input
+// device keeps stick, touch and gyro all working with no input-path edits.
+void VKQ_VR_ApplyHeadAim (void)
+{
+	static float last_sent = 0.0f;
+	float		 delta;
+	if (!vkq_vr_active || !vkq_vr_have)
+	{
+		last_sent = cl.viewangles[YAW];
+		return;
+	}
+	if (vkq_vr_yaw_init)
+	{
