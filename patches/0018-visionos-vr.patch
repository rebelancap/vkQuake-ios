+// The engine's OWN axis bridge is reused deliberately: R_SetupMatrices builds
+// Rx(-90).Rz(90) before the view angles, which maps Quake world (X fwd, Y left,
+// Z up) onto right-up-back — the exact convention ARKit poses and
+// cp_view_get_transform use. No hand-written Quake<->ARKit axis matrix exists
+// anywhere in the VR path, and none should be added (R0 finding 3).
+//
+// Base = Rx(-90).Rz(90).Rz(-bodyYaw).T(-vieworg - heightOfs). Pitch and roll are
+// deliberately absent: the head owns them.
+void VKQ_VR_ComposeView (int eye, float out[16])
+{
+	float base[16], rot[16], trans[16];
+	RotationMatrix (base, -M_PI / 2.0f, 1.0f, 0.0f, 0.0f);
+	RotationMatrix (rot, M_PI / 2.0f, 0.0f, 0.0f, 1.0f);
+	MatrixMultiply (base, rot);
+	RotationMatrix (rot, VKQ_VR_DEG2RAD (-vkq_vr_body_yaw), 0.0f, 0.0f, 1.0f);
+	MatrixMultiply (base, rot);
+	TranslationMatrix (trans, -r_refdef.vieworg[0], -r_refdef.vieworg[1], -(r_refdef.vieworg[2] + vkq_vr_height_ofs));
+	MatrixMultiply (base, trans);
+
+	memcpy (out, vkq_vr_cur[eye & 1].eye_from_player, 16 * sizeof (float));
+	MatrixMultiply (out, base); // out = eyeFromPlayer * base
+}
