 /*
+===============
+R_SetVRFrustum -- vkquake-ios overlay 0018
+
+Cull planes for the immersive VR eye. The stock R_SetFrustum turns the game's
+fov around the game's view vectors; in VR neither is what the eye sees. Take the
+basis and origin straight out of the composed VR view matrix (world -> eye,
+right-up-back, so row 0 is the eye's right axis in world space and row 2 its
+back axis), and the half-angles straight out of the drawable's asymmetric
+tangents.
+
+In eye space a visible point satisfies  tL*d <= x <= tR*d  and  tD*d <= y <= tU*d
+with d = -z the distance along the eye's forward axis, so each inward plane
+normal is a plain combination of the basis vectors — e.g. the left plane is
+right - tL*forward. Asymmetric and canted frustums fall out for free, which is
+exactly what the Vision Pro vends.
+===============
+*/
+void R_SetVRFrustum (void)
+{
+	extern void VKQ_VR_ComposeView (int eye, float out[16]);
+	extern void VKQ_VR_GetTangents (int eye, float *l, float *r, float *u, float *d);
+	extern int	vkq_stereo3d_eye;
+
+	float	v[16];
+	vec3_t	right, up, fwd, eye_org;
+	float	tl, tr, tu, td;
+	int		i;
+	const int e = (vkq_stereo3d_eye == 2) ? 1 : 0;
+
+	VKQ_VR_ComposeView (e, v);
+	VKQ_VR_GetTangents (e, &tl, &tr, &tu, &td);
+
+	// Rows of the rotation part = the eye's world-space axes (column-major [col*4+row]).
+	right[0] = v[0 * 4 + 0], right[1] = v[1 * 4 + 0], right[2] = v[2 * 4 + 0];
+	up[0] = v[0 * 4 + 1], up[1] = v[1 * 4 + 1], up[2] = v[2 * 4 + 1];
+	fwd[0] = -v[0 * 4 + 2], fwd[1] = -v[1 * 4 + 2], fwd[2] = -v[2 * 4 + 2];
+	// Eye origin in world space: p = -R^T * t (R orthonormal, t = column 3).
+	eye_org[0] = -(right[0] * v[3 * 4 + 0] + up[0] * v[3 * 4 + 1] - fwd[0] * v[3 * 4 + 2]);
+	eye_org[1] = -(right[1] * v[3 * 4 + 0] + up[1] * v[3 * 4 + 1] - fwd[1] * v[3 * 4 + 2]);
+	eye_org[2] = -(right[2] * v[3 * 4 + 0] + up[2] * v[3 * 4 + 1] - fwd[2] * v[3 * 4 + 2]);
+
+	for (i = 0; i < 3; i++)
+	{
+		frustum[0].normal[i] = tr * fwd[i] - right[i]; // right plane
+		frustum[1].normal[i] = right[i] - tl * fwd[i]; // left plane
+		frustum[2].normal[i] = up[i] - td * fwd[i];	   // bottom plane
+		frustum[3].normal[i] = tu * fwd[i] - up[i];	   // top plane
+	}
+	for (i = 0; i < 4; i++)
+	{
+		VectorNormalize (frustum[i].normal);
+		frustum[i].type = PLANE_ANYZ;
+		frustum[i].dist = DotProduct (eye_org, frustum[i].normal);
+		frustum[i].signbits = SignbitsForPlane (&frustum[i]);
+	}
+}
+#endif
