+// --- shell side --------------------------------------------------------------
+
+// Publish one frame's eye pair. Returns the frame id the engine must render.
+unsigned long long VKQ_VR_PublishPose (
+	const float *efp_l, const float *proj_l, const float *tan_l, const float *efp_r, const float *proj_r, const float *tan_r)
+{
+	unsigned long long id;
+	pthread_mutex_lock (&vkq_vr_mtx);
+	memcpy (vkq_vr_pub[0].eye_from_player, efp_l, 16 * sizeof (float));
+	memcpy (vkq_vr_pub[0].projection, proj_l, 16 * sizeof (float));
+	vkq_vr_pub[0].tan_l = tan_l[0], vkq_vr_pub[0].tan_r = tan_l[1], vkq_vr_pub[0].tan_u = tan_l[2], vkq_vr_pub[0].tan_d = tan_l[3];
+	memcpy (vkq_vr_pub[1].eye_from_player, efp_r, 16 * sizeof (float));
+	memcpy (vkq_vr_pub[1].projection, proj_r, 16 * sizeof (float));
+	vkq_vr_pub[1].tan_l = tan_r[0], vkq_vr_pub[1].tan_r = tan_r[1], vkq_vr_pub[1].tan_u = tan_r[2], vkq_vr_pub[1].tan_d = tan_r[3];
