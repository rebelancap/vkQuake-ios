+	vkq_vr_dbg_state = (int)cls.state;
+	vkq_vr_dbg_signon = cls.signon;
+	vkq_vr_dbg_keydest = (int)key_dest;
+	vkq_vr_dbg_intermission = cl.intermission;
+	vkq_vr_dbg_demo = cls.demoplayback ? 1 : 0;
