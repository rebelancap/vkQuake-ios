+static void vkq_vr_deadline (struct timespec *ts, int ms)
+{
+	struct timespec now;
+	clock_gettime (CLOCK_REALTIME, &now);
+	long long ns = (long long)now.tv_nsec + (long long)ms * 1000000ll;
+	ts->tv_sec = now.tv_sec + (time_t) (ns / 1000000000ll);
+	ts->tv_nsec = (long)(ns % 1000000000ll);
