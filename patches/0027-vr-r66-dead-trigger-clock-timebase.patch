+
+/*
+ * R6.6 — THE DEAD TRIGGER. This is the root cause, and it is here.
+ *
+ * vkq_vr_af_wclock[] holds ABSOLUTE `attack_finished` values, and `sv.qcvm.time`
+ * RESTARTS AT ZERO on every new server — map, changelevel, restart, load. Nothing
+ * reset these across that boundary: VKQ_VR_ClockReset had exactly one caller, the
+ * VR mode change.
+ *
+ * So a clock saved at t=300 near the end of one level is restored onto the player
+ * edict at t=2 in the next, putting attack_finished ~298 seconds in the future.
+ * And stock weapons.qc is:
+ *
+ *     void() W_WeaponFrame =
+ *     {
+ *         if (time < self.attack_finished)  return;   <- nothing below this runs
+ *         ImpulseCommands ();                         <- the weapon switch
+ *         if (self.button0) { ... W_Attack(); }       <- the shot
+ *     };
+ *
+ * The early return is ABOVE ImpulseCommands, so the pending weapon switch is not
+ * merely delayed — it is never read. The scheduler re-issues it forever, the gate
+ * refuses to fire while a switch is unresolved, and BOTH triggers go dead until
+ * server time catches up to the stale value. That is precisely the user's report:
+ * deterministic at the start of a level, both hands, and "fixes itself eventually".
+ *
+ * Two guards, because one of them alone leaves a hole:
+ *   - the time base going BACKWARDS is a new server; drop every stored clock.
+ *   - any single value further ahead than the slowest stock refire is not a refire,
+ *     it is a leftover from another time base; treat it as expired. This also
+ *     rescues an edict that is ALREADY stuck (a save from an affected build, or a
+ *     clock written before this code ran), which the backwards test cannot.
+ */
+#define VKQ_VR_AF_MAX_AHEAD 2.0f // stock's slowest refire is the RL's 0.8 s
+static float vkq_vr_af_lastt = 0.0f;
+
+static void vkq_vr_clock_timebase (float t)
+{
+	if (t + 0.001f < vkq_vr_af_lastt)
+	{
+		Con_DPrintf ("VR dual clock: server time went backwards (%.2f -> %.2f) — clocks reset\n", vkq_vr_af_lastt, t);
+		memset (vkq_vr_af_wclock, 0, sizeof (vkq_vr_af_wclock));
+		vkq_vr_af_cur = 0;
+	}
+	vkq_vr_af_lastt = t;
 }
 
+static float vkq_vr_clock_sane (float v, float t)
+{
+	return (v > t + VKQ_VR_AF_MAX_AHEAD) ? 0.0f : v;
+}
+
 void VKQ_VR_ClockReset (void)
 {
 	memset (vkq_vr_af_wclock, 0, sizeof (vkq_vr_af_wclock));
 	vkq_vr_af_cur = 0;
+	vkq_vr_af_lastt = 0.0f;
 }
 
