+extern void	  VKQ_iOS_SetupUI (void);		 // shell: attach the native touch overlay
+extern void	  VKQ_iOS_FramePoll (void);		 // shell: per-frame touch visibility/settings
+extern void	  VKQ_iOS_StartFrameLoop (void); // shell: CADisplayLink (ProMotion-aware)
+static double vkq_ios_lasttime;
+// Called by the shell's CADisplayLink once per display refresh (60/120 Hz).
+void VKQ_iOS_EngineFrame (void)
+{
+	double newtime = Sys_DoubleTime ();
+	double dt = newtime - vkq_ios_lasttime;
+	vkq_ios_lasttime = newtime;
+	VKQ_iOS_FramePoll ();
+	Host_Frame (dt);
+}
+#endif
