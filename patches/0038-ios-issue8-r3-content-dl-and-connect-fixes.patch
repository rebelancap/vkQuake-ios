+/*
+===============
+CL_SignonWatchdog
+
+vkquake-ios overlay 0038 (issue #8). A join that stalls between signon stages
+(the server keeps sending nops, so net_messagetimeout's 300 s never trips) sat
+on the loading plaque with nothing drawn and no way out. After 20 s with no
+signon progress, give up cleanly: plaque down, back to the join screen.
+
+Idle time accumulates only from ordinary frames: a step longer than 1 s (the
+synchronous map load inside CL_ParseServerInfo, a hitch, the app in the
+background) is not counted, so a long but legitimate load can never fire it.
+===============
+*/
+#define SIGNON_WATCHDOG_SECONDS 20.0
+static void CL_SignonWatchdog (void)
+{
+	static int	  last_key = -1;
+	static double idle, last_time;
+	double		  now = Sys_DoubleTime ();
+	double		  dt = now - last_time;
+	int			  key;
+
+	last_time = now;
+	if (cls.state != ca_connected || cls.demoplayback || cls.signon >= SIGNONS || sv.active)
+	{
+		last_key = -1;
+		return;
+	}
+	key = cls.signon * 2 + (cl.worldmodel ? 1 : 0);
+	if (key != last_key)
+	{
+		last_key = key;
+		idle = 0;
+		return;
+	}
+	if (dt > 0 && dt < 1.0)
+		idle += dt;
+	if (idle < SIGNON_WATCHDOG_SECONDS)
+		return;
+	last_key = -1;
+	{
+		extern enum m_state_e m_return_state;
+		extern char			 m_return_reason[32];
+		int					 stage = cls.signon;
+		Con_Printf ("\nThe server stopped answering while joining (signon %d, %.0f s). Giving up.\n", stage, SIGNON_WATCHDOG_SECONDS);
+		q_snprintf (m_return_reason, sizeof (m_return_reason), "Join stalled (signon %d)", stage);
+		key_dest = key_menu;
+		m_state = (m_return_state == m_slist || m_return_state == m_lanconfig) ? m_return_state : m_main;
+		IN_Deactivate (true);
+		SCR_EndLoadingPlaque ();
+		cls.demonum = -1; // never fall into the demo loop from a failed join
+		Host_EndGame ("Join stalled at signon %d\n", stage);
+	}
 }
 
