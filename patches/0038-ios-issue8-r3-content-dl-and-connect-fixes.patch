+/*
+ * Host_Connect_f, before anything else. `target` is what is being connected to.
+ *  1. A map/mod plan for a DIFFERENT server is stale: drop it, so its prompt
+ *     cannot block the next one and a running transfer cannot finish and issue
+ *     its own `connect <old server>` over the player's choice. moddl's and
+ *     mapdl's own rejoins (same target) pass through.
+ *  2. If moddl switched game for another server and the game is still the one
+ *     it set, switch back. Returns true then: the caller re-queues its connect
+ *     behind the switch's exec quake.rc / vid_unlock (COM_SwitchGame appends
+ *     them; a connect run now would precede them, inside the VID_Lock window),
+ *     which is the same order as moddl's own MOD_SWITCH rejoin.
+ * "local" (a single-player / listen start) touches neither.
+ */
+qboolean CL_ContentDownload_PreConnect (const char *target)
+{
+	char prev[256];
+
+	if (!target || !*target || !q_strcasecmp (target, "local"))
+		return false;
+	CL_MapDownload_AbandonFor (target);
+	if (mod.state != MOD_IDLE && q_strcasecmp (target, mod.target))
+	{
+		if (mod.state == MOD_FAILED)
+			CL_ModDownload_Cancel ();
+		else
+			mod_abandon (va ("now joining %s", target));
+	}
+	if (!mod_restore_game[0] || !q_strcasecmp (target, mod_restore_target))
+		return false;
+	if (!mod_restore_from[0] || q_strcasecmp (COM_GetGameNames (true), mod_restore_from))
+	{
+		// The player changed game themselves since (Mods menu, `game`): theirs wins.
+		Con_DPrintf ("moddl: game is \"%s\", not the \"%s\" we set; leaving it\n", COM_GetGameNames (true), mod_restore_from);
+		mod_restore_game[0] = 0;
+		return false;
+	}
+	q_strlcpy (prev, mod_restore_game, sizeof (prev));
+	mod_restore_game[0] = 0;
+	// Going back to that server later should switch again: it is not a loop.
+	mod_remove_list (mod_switched, &mod_switched_count, mod_restore_target);
+	Con_Printf ("moddl: leaving \"%s\" (switched for %s); back to \"%s\" to join %s\n", mod_restore_from, mod_restore_target, prev, target);
+	COM_SwitchGame (prev);
+	return true;
+}
