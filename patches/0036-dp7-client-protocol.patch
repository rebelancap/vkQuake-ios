+/*
+==================
+CLDP7_NewServer
+
+svc_serverinfo said 3504. cl was just wiped by CL_ClearState.
+==================
+*/
+void CLDP7_NewServer (void)
+{
+	static qboolean registered;
+	int				i;
+
+	if (!registered)
+	{
+		Cmd_AddCommand ("cl_dp7status", CLDP7_Status_f);
+		registered = true;
+	}
+	cl.protocolflags = PRFL_FLOATCOORD | PRFL_SHORTANGLE;
+
+	if (dp7_numstates != cl.max_edicts)
+	{
+		Mem_Free (dp7_states);
+		dp7_states = (dp7state_t *)Mem_Alloc (cl.max_edicts * sizeof (*dp7_states));
+		dp7_numstates = cl.max_edicts;
+	}
+	for (i = 0; i < dp7_numstates; i++)
+		CLDP7_ResetState (&dp7_states[i]);
+	dp7_frames = dp7_lastframe = dp7_servermoveseq = dp7_skipped_te = dp7_moves = 0;
+}
