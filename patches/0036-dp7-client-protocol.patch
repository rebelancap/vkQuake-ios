+/*
+==================
+CLDP7_WriteMove
+
+DP7 clc_move (DarkPlaces cl_input.c CL_SendMove, PROTOCOL_DARKPLACES7): 56 bytes.
+==================
+*/
+void CLDP7_WriteMove (sizebuf_t *buf, const usercmd_t *cmd)
+{
+	extern int	 in_impulse;
+	int			 dump = buf->cursize;
+	unsigned int bits = cmd->buttons & 3; // attack, jump
+	int			 i;
+
+	if (cmd->buttons & 4)
+		bits |= 256; // vkQuake's +use bit is DP's button 9 ("use")
+
+	MSG_WriteByte (buf, clc_move);
+	MSG_WriteLong (buf, 0);				// movesequence: 0 = not predicted, nothing to replay
+	MSG_WriteFloat (buf, cl.mtime[0]); // last server time, for ping
+	for (i = 0; i < 3; i++)
+		MSG_WriteShort (buf, Q_rint (cl.viewangles[i] * 65536.0 / 360.0) & 65535);
+	MSG_WriteShort (buf, Q_rint (cmd->forwardmove));
+	MSG_WriteShort (buf, Q_rint (cmd->sidemove));
+	MSG_WriteShort (buf, Q_rint (cmd->upmove));
+	MSG_WriteLong (buf, bits);
+	MSG_WriteByte (buf, cmd->impulse & 0xff);
+	// prydon cursor: screen x/y, start, impact, entity -- unused
+	MSG_WriteShort (buf, 0);
+	MSG_WriteShort (buf, 0);
+	for (i = 0; i < 6; i++)
+		MSG_WriteFloat (buf, 0);
+	MSG_WriteShort (buf, 0);
+	in_impulse = 0;
+
+	cl.movecmds[cl.movemessages & MOVECMDS_MASK] = *cmd;
+	dp7_moves++;
+	// as for every protocol: drop the first two, they may carry the last level's input
+	if (++cl.movemessages <= 2)
+		buf->cursize = dump;
+}
