+// cl_dp7.c -- client side of DarkPlaces protocol 7 (3504), vkquake-ios overlay 0036
+//
+// Wire formats ported from DarkPlaces (https://github.com/DarkPlacesEngine/darkplaces,
+// GPLv2, commit 10d48635): cl_ents5.c EntityState5_ReadUpdate /
+// EntityFrame5_CL_ReadFrame, cl_parse.c CL_ParseClientdata (DP7 branch),
+// CL_ParseStartSoundPacket, CL_ParseTempEntity (sizes only), cl_input.c CL_SendMove
+// (DP7 clc_move). FTEQW's DP5_ParseDelta was the cross-check.
+//
+// EVERYTHING here is reached only when cl.protocol == PROTOCOL_DP7, which only a
+// DP7 svc_serverinfo sets. Protocols 15/666/999 (+FTE extensions), single player
+// and every existing demo never enter this file. docs/DP7-PLAN.md has the design.
+//
+// Phase A scope: join, signon, EntityFrame5 entities into vkQuake's delta sink
+// (CL_EntitiesDeltaed, the same path FTE replacement deltas use), DP7 clientdata,
+// DP's opcodes 51-59 (52/54/56 collide with the 2021 rerelease's opcodes, which is
+// why this runs BEFORE the shared switch), DP's svc_sound bits, the 56-byte DP7
+// clc_move and E5 frame acks. Phase B (deferred): DP-only temp entities (skipped by
+// size here), svc_effect, E5 glow/light dlights, colormod, attachments, viewmodel
+// entities, trail effect numbers.
+
+#include "quakedef.h"
+#include "cl_dp7.h"
