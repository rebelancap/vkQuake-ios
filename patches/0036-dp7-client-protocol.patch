+// ---- DarkPlaces protocol.h ----
+#define DP_E5_FULLUPDATE		 (1u << 0)
+#define DP_E5_ORIGIN			 (1u << 1)
+#define DP_E5_ANGLES			 (1u << 2)
+#define DP_E5_MODEL				 (1u << 3)
+#define DP_E5_FRAME				 (1u << 4)
+#define DP_E5_SKIN				 (1u << 5)
+#define DP_E5_EFFECTS			 (1u << 6)
+#define DP_E5_EXTEND1			 (1u << 7)
+#define DP_E5_FLAGS				 (1u << 8)
+#define DP_E5_ALPHA				 (1u << 9)
+#define DP_E5_SCALE				 (1u << 10)
+#define DP_E5_ORIGIN32			 (1u << 11)
+#define DP_E5_ANGLES16			 (1u << 12)
+#define DP_E5_MODEL16			 (1u << 13)
+#define DP_E5_COLORMAP			 (1u << 14)
+#define DP_E5_EXTEND2			 (1u << 15)
+#define DP_E5_ATTACHMENT		 (1u << 16)
+#define DP_E5_LIGHT				 (1u << 17)
+#define DP_E5_GLOW				 (1u << 18)
+#define DP_E5_EFFECTS16			 (1u << 19)
+#define DP_E5_EFFECTS32			 (1u << 20)
+#define DP_E5_FRAME16			 (1u << 21)
+#define DP_E5_COLORMOD			 (1u << 22)
+#define DP_E5_EXTEND3			 (1u << 23)
+#define DP_E5_GLOWMOD			 (1u << 24)
+#define DP_E5_COMPLEXANIMATION	 (1u << 25)
+#define DP_E5_TRAILEFFECTNUM	 (1u << 26)
+
+#define DP_RENDER_STEP			 1
+#define DP_RENDER_EXTERIORMODEL	 8
+
+#define DP_EF_NODRAW			 16
+#define DP_EF_BLUE				 64
+#define DP_EF_RED				 128
+
+#define DP_SU_VIEWHEIGHT		 (1u << 0)
+#define DP_SU_IDEALPITCH		 (1u << 1)
+#define DP_SU_PUNCH1			 (1u << 2)
+#define DP_SU_VELOCITY1			 (1u << 5)
+#define DP_SU_ITEMS				 (1u << 9)
+#define DP_SU_ONGROUND			 (1u << 10)
+#define DP_SU_INWATER			 (1u << 11)
+#define DP_SU_EXTEND1			 (1u << 15)
+#define DP_SU_PUNCHVEC1			 (1u << 16)
+#define DP_SU_VIEWZOOM			 (1u << 19)
+#define DP_SU_EXTEND2			 (1u << 23)
+
+#define DP_SND_VOLUME			 (1 << 0)
+#define DP_SND_ATTENUATION		 (1 << 1)
+#define DP_SND_LOOPING			 (1 << 2) // a flag, no data (vkQuake's SND_FTE_MOREFLAGS reads a byte here)
+#define DP_SND_LARGEENTITY		 (1 << 3)
+#define DP_SND_LARGESOUND		 (1 << 4)
+#define DP_SND_SPEEDUSHORT4000	 (1 << 5)
+
+#define DP_svc_showlmp			 35
+#define DP_svc_hidelmp			 36
+#define DP_svc_downloaddata		 50
+#define DP_svc_effect			 52
+#define DP_svc_effect2			 53
+#define DP_svc_precache			 54
+#define DP_svc_spawnbaseline2	 55
+#define DP_svc_spawnstatic2		 56
+#define DP_svc_entities			 57
+#define DP_svc_csqcentities		 58
+#define DP_svc_spawnstaticsound2 59
