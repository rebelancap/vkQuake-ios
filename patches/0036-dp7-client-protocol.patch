+// the DarkPlaces entity state as the server deltas it (DP's defaultstate is the
+// reset value). Kept per entity so a delta that changes one field (say effects)
+// can still be mapped onto vkQuake's netstate as a whole.
+typedef struct
+{
+	vec3_t		   origin;
+	vec3_t		   angles;
+	unsigned int   effects;
+	unsigned short modelindex;
+	unsigned short frame;
+	unsigned char  flags;
+	unsigned char  skin;
+	unsigned char  alpha; // 255 = opaque
+	unsigned char  scale; // *16
+	unsigned char  colormap;
+	unsigned char  colormod[3]; // *32
+} dp7state_t;
+
+static dp7state_t *dp7_states;
+static int		   dp7_numstates;
+static dp7state_t  dp7_scratch; // updates for entity numbers we cannot store are parsed into this
+
+static int		   dp7_frames;		  // svc_entities frames received this connection
+static int		   dp7_lastframe;	  // the last E5 frame number
+static int		   dp7_servermoveseq; // DP7 servermovesequence (unused: we never predict)
+static int		   dp7_skipped_te;	  // DP-only temp entities skipped (Phase B renders them)
+static int		   dp7_moves;		  // clc_move messages written
+
+extern vec3_t v_punchangles[2];
+extern double v_punchangles_times[2];
+
+// skip n message bytes (a read past the end sets msg_badread, as MSG_ReadByte does)
+static void CLDP7_Skip (int n)
+{
+	while (n-- > 0 && !msg_badread)
+		MSG_ReadByte ();
+}
+
+static void CLDP7_ResetState (dp7state_t *s)
+{
+	memset (s, 0, sizeof (*s));
+	s->alpha = 255;
+	s->scale = 16;
+	s->colormod[0] = s->colormod[1] = s->colormod[2] = 32;
+}
+
+/*
+ * End the game with one line instead of a desync (or a Sys_Error in the shared
+ * temp-entity parser). Same shape as cl_parse.c's CL_RefuseServerProtocol.
+ */
+static void CLDP7_Abort (const char *why)
+{
+	extern enum m_state_e m_return_state;
+	extern char			 m_return_reason[32];
+
+	if (cls.demoplayback)
+		Host_Error ("DarkPlaces demo: %s", why);
+	Con_Printf ("\nDarkPlaces server: %s\n", why);
+	q_snprintf (m_return_reason, sizeof (m_return_reason), "DP server: unsupported data");
+	key_dest = key_menu;
+	m_state = (m_return_state == m_slist || m_return_state == m_lanconfig) ? m_return_state : m_main;
+	IN_Deactivate (true);
+	SCR_EndLoadingPlaque ();
+	cls.demonum = -1;
+	Host_EndGame ("DarkPlaces server: %s\n", why);
+}
+
+static void CLDP7_Status_f (void)
+{
+	int			  i, active = 0;
+	const entity_t *view;
+
+	if (cls.state != ca_connected || cl.protocol != PROTOCOL_DP7)
+	{
+		Con_Printf ("dp7: not connected to a DarkPlaces protocol 7 server\n");
+		return;
+	}
+	for (i = 1; i < cl.num_entities; i++)
+		if (cl.entities[i].update_type)
+			active++;
+	view = (cl.viewentity > 0 && cl.viewentity < cl.num_entities) ? &cl.entities[cl.viewentity] : NULL;
+	Con_Printf (
+		"dp7: signon %i frames %i lastframe %i entities %i moves %i skipped_te %i health %i shells %i viewent %i origin %.1f %.1f %.1f\n", cls.signon,
+		dp7_frames, dp7_lastframe, active, dp7_moves, dp7_skipped_te, cl.stats[STAT_HEALTH], cl.stats[STAT_SHELLS], cl.viewentity, view ? view->origin[0] : 0,
+		view ? view->origin[1] : 0, view ? view->origin[2] : 0);
+}
