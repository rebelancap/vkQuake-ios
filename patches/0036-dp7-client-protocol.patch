+// ---------------------------------------------------------------------------
+// EntityFrame5 (DarkPlaces cl_ents5.c)
+// ---------------------------------------------------------------------------
+
+static unsigned int CLDP7_ReadE5Update (dp7state_t *s)
+{
+	unsigned int bits;
+	int			 i;
+
+	bits = MSG_ReadByte ();
+	if (bits & DP_E5_EXTEND1)
+	{
+		bits |= MSG_ReadByte () << 8;
+		if (bits & DP_E5_EXTEND2)
+		{
+			bits |= MSG_ReadByte () << 16;
+			if (bits & DP_E5_EXTEND3)
+				bits |= (unsigned int)MSG_ReadByte () << 24;
+		}
+	}
+	if (bits & DP_E5_FULLUPDATE)
+		CLDP7_ResetState (s);
+	if (bits & DP_E5_FLAGS)
+		s->flags = MSG_ReadByte ();
+	if (bits & DP_E5_ORIGIN)
+	{
+		for (i = 0; i < 3; i++)
+			s->origin[i] = (bits & DP_E5_ORIGIN32) ? MSG_ReadFloat () : MSG_ReadShort () * (1.0f / 8.0f); // Coord32f / Coord13i
+	}
+	if (bits & DP_E5_ANGLES)
+	{
+		for (i = 0; i < 3; i++)
+			s->angles[i] = (bits & DP_E5_ANGLES16) ? MSG_ReadShort () * (360.0f / 65536.0f) : MSG_ReadByte () * (360.0f / 256.0f); // Angle16i / Angle8i
+	}
+	if (bits & DP_E5_MODEL)
+		s->modelindex = (bits & DP_E5_MODEL16) ? (unsigned short)MSG_ReadShort () : MSG_ReadByte ();
+	if (bits & DP_E5_FRAME)
+		s->frame = (bits & DP_E5_FRAME16) ? (unsigned short)MSG_ReadShort () : MSG_ReadByte ();
+	if (bits & DP_E5_SKIN)
+		s->skin = MSG_ReadByte ();
+	if (bits & DP_E5_EFFECTS)
+	{
+		if (bits & DP_E5_EFFECTS32)
+			s->effects = (unsigned int)MSG_ReadLong ();
+		else if (bits & DP_E5_EFFECTS16)
+			s->effects = (unsigned short)MSG_ReadShort ();
+		else
+			s->effects = MSG_ReadByte ();
+	}
+	if (bits & DP_E5_ALPHA)
+		s->alpha = MSG_ReadByte ();
+	if (bits & DP_E5_SCALE)
+		s->scale = MSG_ReadByte ();
+	if (bits & DP_E5_COLORMAP)
+		s->colormap = MSG_ReadByte ();
+	if (bits & DP_E5_ATTACHMENT)
+	{
+		MSG_ReadShort (); // tagentity -- Phase B
+		MSG_ReadByte ();  // tagindex
+	}
+	if (bits & DP_E5_LIGHT)
+	{
+		for (i = 0; i < 4; i++)
+			MSG_ReadShort (); // light rgb*256, radius -- Phase B
+		MSG_ReadByte ();	  // lightstyle
+		MSG_ReadByte ();	  // lightpflags
+	}
+	if (bits & DP_E5_GLOW)
+	{
+		MSG_ReadByte (); // glowsize -- Phase B
+		MSG_ReadByte (); // glowcolor
+	}
+	if (bits & DP_E5_COLORMOD)
+	{
+		for (i = 0; i < 3; i++)
+			s->colormod[i] = MSG_ReadByte ();
+	}
+	if (bits & DP_E5_GLOWMOD)
+	{
+		for (i = 0; i < 3; i++)
+			MSG_ReadByte ();
+	}
+	if (bits & DP_E5_COMPLEXANIMATION)
+	{
+		// framegroup blends / skeletal poses: no vkQuake equivalent, skipped by their
+		// in-packet sizes (type 4 carries its own bone count)
+		int type = MSG_ReadByte ();
+		switch (type)
+		{
+		case 0:
+			CLDP7_Skip (2 + 2);
+			break;
+		case 1:
+			CLDP7_Skip (2 * 2 + 2 * 2 + 2);
+			break;
+		case 2:
+			CLDP7_Skip (3 * 2 + 3 * 2 + 3);
+			break;
+		case 3:
+			CLDP7_Skip (4 * 2 + 4 * 2 + 4);
+			break;
+		case 4:
+		{
+			int numbones;
+			MSG_ReadShort (); // modelindex
+			numbones = MSG_ReadByte ();
+			CLDP7_Skip (numbones * 7 * 2);
+			break;
+		}
+		default:
+			CLDP7_Abort (va ("unknown E5_COMPLEXANIMATION type %i", type));
+			break;
+		}
+	}
+	if (bits & DP_E5_TRAILEFFECTNUM)
+		MSG_ReadShort (); // DP effectinfo index -- Phase B
+	return bits;
+}
+
+// DarkPlaces state -> vkQuake netstate (the encodings CL_EntitiesDeltaed expects)
+static void CLDP7_ToNetstate (const dp7state_t *s, entity_state_t *n)
+{
+	unsigned int fx = s->effects;
+
+	*n = nullentitystate;
+	VectorCopy (s->origin, n->origin);
+	VectorCopy (s->angles, n->angles);
+	n->modelindex = (s->modelindex < MAX_MODELS && !(fx & DP_EF_NODRAW)) ? s->modelindex : 0;
+	n->frame = s->frame;
+	n->skin = s->skin;
+	n->colormap = s->colormap;
+	// DP effects 1-8 are Quake's; 24-31 are the model-flag trails, which vkQuake reads
+	// from (effects >> 24) the same way. DP's BLUE/RED are the quad/pent glows. The
+	// rest (16 NODRAW handled above, ADDITIVE, FULLBRIGHT, ...) means other things
+	// in vkQuake's numbering (16/32 = the rerelease's quad/pent lights): dropped.
+	n->effects = (fx & 0x0f) | (fx & 0xff000000u) | ((fx & DP_EF_BLUE) ? 16 : 0) | ((fx & DP_EF_RED) ? 32 : 0);
+	// DP: 255 opaque, 0 invisible. vkQuake: 0 default, 1 invisible, a+1 otherwise --
+	// the same mapping CLFTE_ReadDelta applies to FTE's identical encoding.
+	n->alpha = (s->alpha + 1) & 0xff;
+	n->scale = s->scale;
+	n->eflags = ((s->flags & DP_RENDER_STEP) ? EFLAGS_STEP : 0) | ((s->flags & DP_RENDER_EXTERIORMODEL) ? EFLAGS_EXTERIORMODEL : 0);
+	n->colormod[0] = s->colormod[0];
+	n->colormod[1] = s->colormod[1];
+	n->colormod[2] = s->colormod[2];
+}
+
+static void CLDP7_ParseEntities (void)
+{
+	int		  n, num;
+	entity_t *ent;
+
+	dp7_lastframe = MSG_ReadLong ();
+	dp7_servermoveseq = MSG_ReadLong (); // DP7 and later
+	dp7_frames++;
+
+	// ack the E5 frame number (not the netchan sequence the FTE path acks)
+	if (!cls.demoplayback && cl.ackframes_count < countof (cl.ackframes))
+		cl.ackframes[cl.ackframes_count++] = dp7_lastframe;
+
+	for (;;)
+	{
+		n = (unsigned short)MSG_ReadShort ();
+		if (n == 0x8000 || msg_badread)
+			break; // "remove world" is the terminator
+		num = n & 0x7fff;
+
+		if (num <= 0 || num >= cl.max_edicts || num >= dp7_numstates)
+		{
+			// can't hold it: parse the bytes to stay in sync, drop the result
+			if (!(n & 0x8000))
+				CLDP7_ReadE5Update (&dp7_scratch);
+			continue;
+		}
+
+		ent = CL_EntityNum (num);
+		if (n & 0x8000)
+		{ // removal
+			CLDP7_ResetState (&dp7_states[num]);
+			ent->update_type = false;
+			ent->model = NULL;
+			InvalidateTraceLineCache ();
+			continue;
+		}
+
+		CLDP7_ReadE5Update (&dp7_states[num]);
+		CLDP7_ToNetstate (&dp7_states[num], &ent->netstate);
+		if (ent->update_type)
+		{ // simple update (same as the FTE path)
+			if (ent->msgtime == cl.mtime[0])
+				ent->msgtime = cl.mtime[1];
+		}
+		else
+		{ // new entity: no previous copy to lerp from
+			ent->update_type = true;
+			ent->msgtime = 0;
+		}
+	}
+
+	CL_EntitiesDeltaed ();
+
+	if (cls.signon == SIGNONS - 1)
+	{ // first entity frame is the final signon stage (as in CLFTE_ParseEntitiesUpdate)
+		cls.signon = SIGNONS;
+		CL_SignonReply ();
+	}
+}
+
+// ---------------------------------------------------------------------------
+// DP7 clientdata (DarkPlaces cl_parse.c CL_ParseClientdata). Health, ammo, weapon
+// and viewheight arrive as stats; this carries punch, velocity and the flags.
+// ---------------------------------------------------------------------------
+#define CL_SetStati(stat, val) cl.statsf[stat] = (cl.stats[stat] = val)
+
+static void CLDP7_ParseClientdata (void)
+{
+	unsigned int bits;
+	int			 i;
+
+	bits = (unsigned short)MSG_ReadShort ();
+	if (bits & DP_SU_EXTEND1)
+		bits |= MSG_ReadByte () << 16;
+	if (bits & DP_SU_EXTEND2)
+		bits |= (unsigned int)MSG_ReadByte () << 24;
+
+	if (bits & DP_SU_VIEWHEIGHT)
+		CL_SetStati (STAT_VIEWHEIGHT, MSG_ReadChar ());
+	if (bits & DP_SU_IDEALPITCH)
+		CL_SetStati (STAT_IDEALPITCH, MSG_ReadChar ());
+	else
+		CL_SetStati (STAT_IDEALPITCH, 0);
+
+	VectorCopy (cl.mvelocity[0], cl.mvelocity[1]);
+	for (i = 0; i < 3; i++)
+	{
+		cl.punchangle[i] = (bits & (DP_SU_PUNCH1 << i)) ? MSG_ReadShort () * (360.0f / 65536.0f) : 0;
+		if (bits & (DP_SU_PUNCHVEC1 << i))
+			MSG_ReadFloat (); // punchvector: no vkQuake equivalent
+		cl.mvelocity[0][i] = (bits & (DP_SU_VELOCITY1 << i)) ? MSG_ReadFloat () : 0;
+	}
+	if (v_punchangles[0][0] != cl.punchangle[0] || v_punchangles[0][1] != cl.punchangle[1] || v_punchangles[0][2] != cl.punchangle[2])
+	{
+		v_punchangles_times[1] = v_punchangles_times[0];
+		v_punchangles_times[0] = cl.mtime[0];
+		VectorCopy (v_punchangles[0], v_punchangles[1]);
+		VectorCopy (cl.punchangle, v_punchangles[0]);
+	}
+
+	if (bits & DP_SU_ITEMS)
+		CL_SetStati (STAT_ITEMS, MSG_ReadLong ());
+	cl.onground = (bits & DP_SU_ONGROUND) != 0;
+	cl.inwater = (bits & DP_SU_INWATER) != 0;
+	if (bits & DP_SU_VIEWZOOM)
+		CL_ParseStatInt (STAT_VIEWZOOM, (unsigned short)MSG_ReadShort ());
+}
+
+// DarkPlaces svc_sound: bit 2 is a no-data looping flag (not FTE's moreflags byte)
+// and bit 5 a speed short.
+static void CLDP7_ParseSound (void)
+{
+	vec3_t pos;
+	int	   field_mask, volume, channel, ent, sound_num, i;
+	float  attenuation;
+
+	field_mask = MSG_ReadByte ();
+	volume = (field_mask & DP_SND_VOLUME) ? MSG_ReadByte () : DEFAULT_SOUND_PACKET_VOLUME;
+	attenuation = (field_mask & DP_SND_ATTENUATION) ? MSG_ReadByte () / 64.0 : DEFAULT_SOUND_PACKET_ATTENUATION;
+	if (field_mask & DP_SND_SPEEDUSHORT4000)
+		MSG_ReadShort (); // playback speed: our mixer can't, ignore
+	if (field_mask & DP_SND_LARGEENTITY)
+	{
+		ent = (unsigned short)MSG_ReadShort ();
+		channel = MSG_ReadChar (); // DP: negative = "don't override" flags
+		if (channel < 0)
+			channel = 0;
+	}
+	else
+	{
+		channel = (unsigned short)MSG_ReadShort ();
+		ent = channel >> 3;
+		channel &= 7;
+	}
+	sound_num = (field_mask & DP_SND_LARGESOUND) ? (unsigned short)MSG_ReadShort () : MSG_ReadByte ();
+	for (i = 0; i < 3; i++)
+		pos[i] = MSG_ReadCoord (cl.protocolflags);
+
+	// a read past the end returns -1 (and sets msg_badread): never index with it
+	if (msg_badread || sound_num < 0 || sound_num >= MAX_SOUNDS || ent < 0 || channel < 0)
+	{
+		Con_DPrintf ("DP7 svc_sound: bad sound %i / entity %i / channel %i, ignored\n", sound_num, ent, channel);
+		return;
+	}
+	if (ent >= cl.max_edicts)
+		ent = 0; // an entity we can't hold: play it at its position as a world sound
+	S_StartSound (ent, channel, cl.sound_precache[sound_num], pos, volume / 255.0, attenuation);
+}
+
+// Temp entities: Quake's 0-13 and DP's rain/snow (55/56, already in cl_tent.c) go
+// to the shared parser. DP's own types are skipped by size (Phase B draws them);
+// anything else would desync, so it ends the game with a message instead of
+// reaching cl_tent.c's Sys_Error.
+static qboolean CLDP7_TempEntity (void)
+{
+	int type;
+	int vec = 3 * 4; // a DP7 vector: 3 float coords
+
+	if (msg_readcount >= net_message.cursize)
+		return false; // let the shared parser report the bad read
+	type = net_message.data[msg_readcount];
+	if (type <= 13 || type == 55 || type == 56)
+		return false;
+
+	MSG_ReadByte ();
+	switch (type)
+	{
+	case 16: // TE_EXPLOSION3: origin, 3 coord colour
+		CLDP7_Skip (vec + 3 * 4);
+		break;
+	case 17: // TE_LIGHTNING4NEH: model, entity, start, end
+		MSG_ReadString ();
+		CLDP7_Skip (2 + vec + vec);
+		break;
+	case 50: // TE_BLOOD
+	case 51: // TE_SPARK: origin, 3 char vel, byte count
+		CLDP7_Skip (vec + 3 + 1);
+		break;
+	case 52: // TE_BLOODSHOWER: mins, maxs, coord speed, short count
+		CLDP7_Skip (vec + vec + 4 + 2);
+		break;
+	case 53: // TE_EXPLOSIONRGB: origin, 3 byte colour
+		CLDP7_Skip (vec + 3);
+		break;
+	case 54: // TE_PARTICLECUBE: mins, maxs, dir, short count, byte colour, byte gravity, coord randomvel
+		CLDP7_Skip (vec * 3 + 2 + 1 + 1 + 4);
+		break;
+	case 57: // TE_GUNSHOTQUAD
+	case 58: // TE_SPIKEQUAD
+	case 59: // TE_SUPERSPIKEQUAD
+	case 70: // TE_EXPLOSIONQUAD
+	case 72: // TE_SMALLFLASH
+	case 75: // TE_PLASMABURN
+	case 78: // TE_TEI_BIGEXPLOSION
+		CLDP7_Skip (vec);
+		break;
+	case 73: // TE_CUSTOMFLASH: origin, radius, lifetime, rgb
+		CLDP7_Skip (vec + 5);
+		break;
+	case 74: // TE_FLAMEJET: origin, velocity, count
+	case 77: // TE_TEI_SMOKE
+	case 79: // TE_TEI_PLASMAHIT
+		CLDP7_Skip (vec + vec + 1);
+		break;
+	case 76: // TE_TEI_G3: start, end, angles
+		CLDP7_Skip (vec * 3);
+		break;
+	default:
+		CLDP7_Abort (va ("unknown temp entity type %i (a mod-specific effect vkQuake can't parse)", type));
+		return true;
+	}
+	dp7_skipped_te++;
+	return true;
+}
+
+/*
+==================
+CLDP7_ParseCommand
+
+Called by CL_ParseServerMessage BEFORE its switch, only when cl.protocol is
+PROTOCOL_DP7. Returns true when it consumed the message; false lets the shared
+switch handle an opcode whose layout DP7 shares with NetQuake.
+==================
+*/
+qboolean CLDP7_ParseCommand (int cmd)
+{
+	int i;
+
+	switch (cmd)
+	{
+	case svc_sound:
+		CLDP7_ParseSound ();
+		return true;
+	case svc_clientdata:
+		CLDP7_ParseClientdata ();
+		return true;
+	case svc_temp_entity:
+		return CLDP7_TempEntity ();
+	case DP_svc_showlmp: // Nehahra-style overlay pics: not drawn
+		MSG_ReadString ();
+		MSG_ReadString ();
+		MSG_ReadShort ();
+		MSG_ReadShort ();
+		return true;
+	case DP_svc_hidelmp:
+		MSG_ReadString ();
+		return true;
+	case DP_svc_downloaddata: // only sent after a "download" request, which we never make
+		MSG_ReadLong ();
+		i = (unsigned short)MSG_ReadShort ();
+		CLDP7_Skip (i);
+		return true;
+	case svcdp_updatestatbyte:
+		i = MSG_ReadByte ();
+		CL_ParseStatInt (i, MSG_ReadByte ());
+		return true;
+	case DP_svc_effect: // sprite effect -- Phase B
+		CLDP7_Skip (3 * 4 + 4);
+		return true;
+	case DP_svc_effect2:
+		CLDP7_Skip (3 * 4 + 2 + 2 + 1 + 1);
+		return true;
+	case DP_svc_precache: // [short] index (+0x8000 = sound), [string] name
+		CL_ParsePrecache ();
+		return true;
+	case DP_svc_spawnbaseline2:
+		i = MSG_ReadShort ();
+		CL_ParseBaseline (CL_EntityNum (i), 7); // short model, short frame
+		return true;
+	case DP_svc_spawnstatic2:
+		CL_ParseStatic (7);
+		return true;
+	case DP_svc_entities:
+		CLDP7_ParseEntities ();
+		return true;
+	case DP_svc_csqcentities:
+		CLDP7_Abort ("it runs client-side QuakeC (CSQC, e.g. Xonotic), which vkQuake can't run.");
+		return true;
+	case DP_svc_spawnstaticsound2:
+		CL_ParseStaticSound (2); // short sound index
+		return true;
+	case svcdp_trailparticles:
+	case svcdp_pointparticles:
+	case svcdp_pointparticles1:
+		return false; // the shared parser already speaks these (DP effectinfo order)
+	default:
+		// 38-49 and 63+ are rerelease/FTE opcodes in vkQuake's switch; DP7 never sends
+		// them, so seeing one means we've lost sync.
+		if ((cmd >= 38 && cmd <= 49) || cmd >= 63 || cmd == 4 || cmd == 21)
+		{
+			CLDP7_Abort (va ("unexpected message %i", cmd));
+			return true;
+		}
+		return false;
+	}
+}
