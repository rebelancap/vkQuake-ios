+#if !defined(SDL_PLATFORM_TVOS) && !defined(SDL_PLATFORM_VISIONOS)
+/* vkquake-ios SDL patch 0003: apps linked against the iOS 27 SDK that adopt the
+ * UIScene life cycle get UIInterfaceOrientationUnknown (0) from the deprecated
+ * -[UIApplication statusBarOrientation] (measured on the iOS 27.0 simulator: 0
+ * while the window scene reported LandscapeRight). Every SDL caller then treats a
+ * landscape app as portrait - UIKit_ComputeViewFrame swaps the view to 420x912 pt
+ * on a 912x420 pt landscape window the first time the keyboard machinery calls
+ * -updateKeyboard, and the Metal drawable follows it. Ask the window's scene
+ * (or the active scene) first; fall back to the status bar only if no scene. */
+/* vkquake-ios issue #7: is this scene on an EXTERNAL display (iPadOS Stage
+ * Manager / extended display)? UIKit maps an external scene onto the panel by its
+ * interface orientation RELATIVE TO THE PANEL'S NATIVE ORIENTATION: "portrait" is
+ * the unrotated, native one (a 6016x3384 monitor reports portrait with 3008x1692 pt
+ * bounds), "landscape" turns the scene 90 degrees (landscape-right with 1692x3008
+ * pt bounds, which is what a landscape-only app got: the game drawn sideways).
+ * The test is the PANEL, not "screen != mainScreen": on iPadOS 27.2 (reporter's
+ * iPad Pro M5 + 6016x3384 monitor) the monitor IS [UIScreen mainScreen] while the
+ * game is on it, and UIScreen.screens lists only it. Every iPhone/iPad panel is
+ * portrait-native (nativeBounds e.g. 2064x2752); an external monitor is
+ * landscape-native (6016x3384). "Not the main screen" is kept as well.
+ * VKQ_EMULATE_EXTERNAL_DISPLAY=1 (env/hint, test only) treats the main screen the
+ * same way so the simulator, whose external screen only mirrors, can exercise it.
+ * Keep in step with vkq_external_reason() in the vkquake shell (ios_touch.m). */
+BOOL UIKit_IsExternalDisplayScene(UIWindowScene *scene)
+{
+    if (!scene || !scene.screen) {
+        return NO;
+    }
+    UIScreen *screen = scene.screen;
+    CGSize native = screen.nativeBounds.size;
+    return native.width > native.height || screen != [UIScreen mainScreen] ||
+           SDL_GetHintBoolean("VKQ_EMULATE_EXTERNAL_DISPLAY", false);
+}
+
+UIInterfaceOrientation UIKit_GetInterfaceOrientation(UIWindow *uiwindow)
+{
+    if (@available(iOS 13.0, *)) {
+        UIWindowScene *scene = uiwindow ? uiwindow.windowScene : nil;
+        if (!scene) {
+            scene = UIKit_GetActiveWindowScene();
+        }
+        /* vkquake-ios issue #7: on an EXTERNAL display the scene is kept in the
+         * panel's native ("portrait") orientation - see UIKit_GetSupportedOrientations
+         * - while its bounds are the panel's shape (wide, for a monitor). Callers
+         * here only want "is the view wide?", so the bounds are the truth; the
+         * reported Portrait would make UIKit_ComputeViewFrame swap a full-screen view
+         * to tall. */
+        if (UIKit_IsExternalDisplayScene(scene)) {
+            CGSize size = scene.coordinateSpace.bounds.size;
+            if (size.width > 0 && size.height > 0) {
+                return (size.width > size.height) ? UIInterfaceOrientationLandscapeRight : UIInterfaceOrientationPortrait;
+            }
+        }
+        if (scene && scene.interfaceOrientation != UIInterfaceOrientationUnknown) {
+            return scene.interfaceOrientation;
+        }
+    }
+    return [UIApplication sharedApplication].statusBarOrientation;
+}
+#endif
