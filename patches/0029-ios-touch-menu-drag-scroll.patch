 //=============================================================================
+#ifdef VKQ_IOS
+/* TOUCH: tap-to-activate, drag-to-scroll (see the latches at the top of the file) */
+
+/*
+================
+M_TouchInScrollbar -- is a menu-space point on the scrollbar the menu last drew?
+
+The vendor's M_InScrollbar asks the same question of the LIVE cursor and the
+vendor's scrollbar_*; this one asks it of an arbitrary point and of the touch
+latches, which survive M_UpdateMouse's bookkeeping.
+================
+*/
+static qboolean M_TouchInScrollbar (int mx, int my)
+{
+	return touch_bar_size && (mx >= touch_bar_x) && (mx <= touch_bar_x + 8) && (my >= touch_bar_y) && (my <= touch_bar_y + touch_bar_size);
+}
+
+/*
+================
+M_TouchTapActivates -- may the finger-up at the current cursor fire MOUSE1?
+
+Three answers, in order:
+  - on the scrollbar itself: YES. M_HandleScrollBarKeys takes K_MOUSE1 there and
+    jumps the page, and every menu that draws a scrollbar routes through it, so
+    the click is consumed and can never reach a row.
+  - a list was drawn and the finger landed outside its rows: NO. This is the
+    scroll-gutter fix, and it is menu-agnostic — the rect comes from the menu's
+    own M_Mouse_UpdateListCursor call, so mods / key binds / game options get it
+    for free, whichever side their scrollbar sits on.
+  - anything else (no list on screen, or a hit inside the rows): YES, unchanged.
+================
+*/
+static qboolean M_TouchTapActivates (void)
+{
+	if (M_TouchInScrollbar (m_mouse_x, m_mouse_y))
+		return true;
+	if (list_hit_valid &&
+		((m_mouse_x < list_hit_left) || (m_mouse_x > list_hit_right) || (m_mouse_y < list_hit_top) || (m_mouse_y > list_hit_bottom)))
+		return false;
+	return true;
+}
+
+/*
+================
+M_TouchEvent -- one finger, in DRAWABLE PIXELS. phase 0 = down, 1 = move, 2 = up.
+
+The single entry point for menu touch: the SDL_EVENT_FINGER_* cases in in_sdl3.c
+call it, and so do the vkq_touch* console commands, so a scripted drag exercises
+exactly the code a thumb does. Multi-touch is deliberately not modelled — the
+menu is a one-finger surface and a second finger simply restarts the gesture.
+================
+*/
+void M_TouchEvent (float px, float py, int phase)
+{
+	const float s = M_MenuCanvasScale ();
+	const float slop = VKQ_TOUCH_SLOP_MENU * s;		 // ~12 pt of glass
+	const float row = (float)CHARACTER_SIZE * s;	 // one list row, in pixels
+
+	if (phase == 0)
+	{
+		vkq_touch_down = true;
+		vkq_touch_dragging = false;
+		vkq_touch_x0 = px;
+		vkq_touch_y0 = py;
+		vkq_touch_scroll_ref = py;
+		vkq_menu_touch_x = px;
+		vkq_menu_touch_y = py;
+		return;
+	}
+	if (!vkq_touch_down)
+		return; // a move/up with no down (app resumed mid-gesture): ignore
+
+	if (!vkq_touch_dragging && (fabsf (py - vkq_touch_y0) > slop || fabsf (px - vkq_touch_x0) > slop))
+	{
+		// Past the slop: this gesture is a scroll, not a tap. Cancel any click it
+		// had already armed and stop feeding the hover cursor, so the row under the
+		// travelling finger does not fight the scroll.
+		vkq_touch_dragging = true;
+		vkq_menu_click_pending = 0;
+		vkq_touch_scroll_ref = py;
+	}
+
+	if (vkq_touch_dragging)
+	{
+		// One wheel step per row of travel, so the list tracks the finger 1:1 —
+		// M_HandleScrollBarKeys moves exactly one row per wheel step. Only fires
+		// where a scrollbar was actually drawn: menus without a scrollable list
+		// see no wheel keys at all and behave exactly as they did before.
+		if (touch_bar_size && (key_dest == key_menu || key_dest == key_console) && row >= 1.0f)
+		{
+			int guard = 64; // a flung finger must not spin here
+			// Finger UP means "show me later rows" (iOS convention) -> wheel DOWN.
+			while ((vkq_touch_scroll_ref - py) >= row && guard-- > 0)
+			{
+				Key_Event (K_MWHEELDOWN, true);
+				Key_Event (K_MWHEELDOWN, false);
+				vkq_touch_scroll_ref -= row;
+			}
+			while ((py - vkq_touch_scroll_ref) >= row && guard-- > 0)
+			{
+				Key_Event (K_MWHEELUP, true);
+				Key_Event (K_MWHEELUP, false);
+				vkq_touch_scroll_ref += row;
+			}
+		}
+	}
+	else
+	{
+		vkq_menu_touch_x = px;
+		vkq_menu_touch_y = py;
+	}
+
+	if (phase == 2)
+	{
+		// A tap arms the 2-frame pending click (M_UpdateMouse); a drag never does.
+		if (!vkq_touch_dragging)
+			vkq_menu_click_pending = 2;
+		vkq_touch_down = false;
+		vkq_touch_dragging = false;
+	}
+}
+
+// --- console seams -------------------------------------------------------
+// Injected UIKit touches do not reach the touch path on a simulator, so these
+// drive M_TouchEvent — the same function real finger events call — and are how
+// the whole gesture is verified without a thumb on glass.
+static int M_TouchCmd_ParsePhase (const char *p)
+{
+	if (!strcmp (p, "down"))
+		return 0;
+	if (!strcmp (p, "move"))
+		return 1;
+	return 2;
+}
+
+// vkq_touch <x 0..1> <y 0..1> <down|move|up> — screen-normalised, as a finger arrives.
+static void M_Touch_f (void)
+{
+	if (Cmd_Argc () != 4)
+	{
+		Con_Printf ("vkq_touch <x 0..1> <y 0..1> <down|move|up>\n");
+		return;
+	}
+	M_TouchEvent ((float)atof (Cmd_Argv (1)) * (float)glwidth, (float)atof (Cmd_Argv (2)) * (float)glheight, M_TouchCmd_ParsePhase (Cmd_Argv (3)));
+}
+
+// vkq_touchmenu <mx> <my> <down|move|up> — MENU-canvas coords (rows are 8 apart,
+// the list starts at y=32), converted back to pixels and fed to the same entry
+// point. This is how a test taps a named row or the scroll gutter exactly.
+static void M_TouchMenu_f (void)
+{
+	float s, px, py;
+	if (Cmd_Argc () != 4)
+	{
+		Con_Printf ("vkq_touchmenu <menu-x> <menu-y> <down|move|up>\n");
+		return;
+	}
+	s = M_MenuCanvasScale ();
+	px = (float)atof (Cmd_Argv (1)) * s + ((float)glwidth - 320.0f * s) / 2.0f;
+	py = (float)atof (Cmd_Argv (2)) * s + ((float)glheight - 200.0f * s) / 2.0f;
+	M_TouchEvent (px, py, M_TouchCmd_ParsePhase (Cmd_Argv (3)));
+}
+
+// vkq_touchdrag <x0> <y0> <x1> <y1> [steps] — screen-normalised drag, delivered
+// as down + steps moves + up, the way a real drag arrives.
+static void M_TouchDrag_f (void)
+{
+	float x0, y0, x1, y1;
+	int	  steps, i;
+	if (Cmd_Argc () < 5 || Cmd_Argc () > 6)
+	{
+		Con_Printf ("vkq_touchdrag <x0> <y0> <x1> <y1> [steps]\n");
+		return;
+	}
+	x0 = (float)atof (Cmd_Argv (1));
+	y0 = (float)atof (Cmd_Argv (2));
+	x1 = (float)atof (Cmd_Argv (3));
+	y1 = (float)atof (Cmd_Argv (4));
+	steps = (Cmd_Argc () == 6) ? atoi (Cmd_Argv (5)) : 12;
+	steps = CLAMP (1, steps, 200);
+	M_TouchEvent (x0 * (float)glwidth, y0 * (float)glheight, 0);
+	for (i = 1; i <= steps; i++)
+	{
+		float t = (float)i / (float)steps;
+		M_TouchEvent ((x0 + (x1 - x0) * t) * (float)glwidth, (y0 + (y1 - y0) * t) * (float)glheight, 1);
+	}
+	M_TouchEvent (x1 * (float)glwidth, y1 * (float)glheight, 2);
+	Con_Printf ("touchdrag: (%.3f,%.3f)->(%.3f,%.3f) %d steps\n", x0, y0, x1, y1, steps);
+}
+
+// vkq_menuinfo — the menu state a screenshot cannot show: which list is up, where
