+// cl_mapdl.c -- vkquake-ios overlay 0028: fetch a missing multiplayer map.
+//
+// ============================================================================
+// WHY THIS EXISTS
+//
+// Overlay 0026 (VR R6.5 item 4) made "the server is running a map you do not
+// have" a clean fail-to-menu instead of a Host_Error backtrace. That was the
+// honest floor, and it is still the floor here: everything below either ends in
+// the map being installed and the player rejoining, or in exactly 0026's
+// behaviour. What 0026 could not do was the thing the player actually wants.
+//
+// The engine still cannot be SENT the map — vkQuake has no client download code
+// and no server of any lineage can push us a file (0026's comment enumerates the
+// dead ends: the three QSS download stufftexts are no-ops, svcdp_downloaddata
+// has no parser case, and our pext advertisement never offers chunked
+// downloads). So this does not add a protocol. It fetches the map over HTTPS
+// from the community archives, out of band, exactly the way a player would do it
+// by hand — and then reconnects for them.
+//
+// TWO SOURCES, AND WHY BOTH ARE REQUIRED
+//
+// The failure that started this was maps/blitzkrieg2.bsp on an internet server.
+// That map is NOT in the Quaddicted archive: Quaddicted indexes single-player
+// and coop RELEASES (zip packages with readmes), and blitzkrieg2 is a deathmatch
+// map that only ever circulated as a bare .bsp. A Quaddicted-only implementation
+// would have failed the exact case it was built for.
+//
+//   Source A -- https://maps.quakeworld.nu/all/<map>.bsp
+//               A flat bare-BSP mirror. One request, no index, no archive
+//               format, and it is where DM maps live. This is the multiplayer
+//               source and it is tried first.
+//   Source B -- the Quaddicted API v1 package archive.
+//               Zip packages for the SP/coop maps a coop server might run.
+//               Resolution is done LOCALLY over a cached ?q=* dump, because the
+//               server-side fielded queries that would answer "which package
+//               contains this file" (filenames:, filenames_txt:) return [] even
+//               for files that are demonstrably present in the dump. That is a
+//               property of the deployed search index, not of our query, and it
+//               is why the client carries an 18 MB index instead of asking.
+//
+// WHAT IS DELIBERATELY NOT HERE
+//
+//  - Downloading whole mods. Only a missing maps/*.bsp starts this flow; a
+//    missing progs model keeps 0026's clean failure, because a client that
+//    silently installs arbitrary game content from an address a server chose is
+//    a different and much worse program.
+//  - Any trust in server-supplied strings as filesystem paths. The install
+//    destination is derived from com_gamedir (OUR writable game directory) and
+//    the map's own basename, never from the gamedir string the server sent.
+//  - Overwriting. Nothing this file does ever replaces a file the player
+//    already has. See the guardrails in cl_mapdl_install_bsp / COM_UnzipToDir.
+// ============================================================================
+
+#include "quakedef.h"
+
+#ifdef VKQ_IOS
+
+#include <sys/stat.h>
+#include <time.h>
+
+// ---------------------------------------------------------------------------
+// Shell services (ios/shell/ios_download.m). Poll-style by construction: NOTHING
+// here ever blocks the engine thread, and no shell thread ever touches engine
+// state. The engine asks "how far along is job N" once per host frame and that
+// is the entire contract.
+// ---------------------------------------------------------------------------
+extern int			VKQ_DL_StartHead (const char *url);
+extern int			VKQ_DL_StartGet (const char *url, const char *destpath);
+extern int			VKQ_DL_StartResolve (const char *indexpath, const char *mapname);
+extern int			VKQ_DL_StartSha256 (const char *path);
+extern int			VKQ_DL_Poll (int job, long long *got, long long *total, int *httpstatus);
+extern const char  *VKQ_DL_Error (int job);
+extern const char  *VKQ_DL_Result (int job, const char *field);
+extern void			VKQ_DL_Free (int job);
+extern const char  *VKQ_DL_CachesPath (void);
+
+// VKQ_DL_Poll return values
+#define DLP_RUNNING 0
+#define DLP_DONE	1
+#define DLP_FAILED	2
+
+// ---------------------------------------------------------------------------
+// cvars
+// ---------------------------------------------------------------------------
+// 0 = off (overlay 0026 behaviour), 1 = ask (default), 2 = download without asking.
+cvar_t cl_mapdownload = {"cl_mapdownload", "1", CVAR_ARCHIVE};
+// Both sources are cvars so the simulator harness can point them at a local
+// fixture. They default to the real hosts and both are required to be https —
+// see cl_mapdl_url_ok. A cvar is the override surface; a hostile server has no
+// way to reach one.
+cvar_t cl_mapdownload_bspurl = {"cl_mapdownload_bspurl", "https://maps.quakeworld.nu/all/", CVAR_ARCHIVE};
+cvar_t cl_mapdownload_pkgurl = {"cl_mapdownload_pkgurl", "https://www.quaddicted.com/api/v1/", CVAR_ARCHIVE};
+// Size caps, megabytes. A .bsp above 128 MB is not a Quake map; a package above
+// 512 MB is not a Quake map release. Both refuse with a message rather than
+// silently truncating or filling the device.
+cvar_t cl_mapdownload_maxbsp = {"cl_mapdownload_maxbsp", "128", CVAR_ARCHIVE};
+cvar_t cl_mapdownload_maxpkg = {"cl_mapdownload_maxpkg", "512", CVAR_ARCHIVE};
+// How stale the cached Quaddicted dump may get before it is refetched, days.
+cvar_t cl_mapdownload_indexdays = {"cl_mapdownload_indexdays", "7", CVAR_ARCHIVE};
+
+// ---------------------------------------------------------------------------
+// state
+// ---------------------------------------------------------------------------
+typedef enum
+{
+	MDL_IDLE = 0,
+	MDL_PROBE,	   // HEAD on source A in flight — the cheap "do we know the size" step
+	MDL_PROMPT,	   // waiting for the player
+	MDL_GET_BSP,   // GET source A
+	MDL_GET_INDEX, // GET the Quaddicted dump
+	MDL_RESOLVE,   // parsing the dump for a package containing this map
+	MDL_GET_PKG,   // GET the package zip
+	MDL_HASH,	   // sha256 of the package
+	MDL_INSTALL,   // extract / place (synchronous, one frame)
+	MDL_RECONNECT, // connect issued; this state exists so the screen can say so
+	MDL_FAILED
+} mdl_state_t;
+
+#define MDL_MAX_TRIED 16
+
+static struct
+{
+	mdl_state_t state;
+	char		map[64];		// bare map name, no extension, lowercased
+	char		target[256];	// what the player connected with, for the rejoin
+	char		gamedir[64];	// the server's gamedir string, for the message only
+	char		srcname[64];	// human-readable source of the pending artifact
+	char		title[96];		// package title (source B) or "<map>.bsp" (source A)
+	char		url[512];		// artifact URL
+	char		sha256[80];		// expected package hash (source B)
+	char		extract[256];	// install.extract hint (source B)
+	char		tmpfile[512];	// where the artifact is being written
+	char		reason[128];	// failure text, shown on the menu
+	long long	total, got;		// byte counters for the progress line
+	int			job;			// live shell job, or 0
+	int			source;			// 1 = bare bsp (A), 2 = package (B)
+	double		started;
+} mdl;
+
+// One attempt per map name per session. The retry limiter is on the MAP, not on
+// the connect target: a server that keeps announcing a map we cannot install
+// would otherwise loop connect -> download -> connect forever, and the loop
+// would look like a network problem rather than a missing file.
+static char mdl_tried[MDL_MAX_TRIED][64];
+static int	mdl_tried_count;
+
+static qboolean mdl_already_tried (const char *map)
+{
+	int i;
+	for (i = 0; i < mdl_tried_count; i++)
+		if (!q_strcasecmp (mdl_tried[i], map))
+			return true;
+	return false;
+}
+
+static void mdl_remember (const char *map)
+{
+	if (mdl_tried_count < MDL_MAX_TRIED)
+		q_strlcpy (mdl_tried[mdl_tried_count++], map, sizeof (mdl_tried[0]));
+}
+
+// ---------------------------------------------------------------------------
+// small helpers
+// ---------------------------------------------------------------------------
+static void mdl_job_release (void)
+{
+	if (mdl.job)
+	{
+		VKQ_DL_Free (mdl.job);
+		mdl.job = 0;
+	}
+}
+
+static void mdl_fail (const char *fmt, ...)
+{
+	va_list argptr;
+	char	string[128];
+
+	va_start (argptr, fmt);
+	q_vsnprintf (string, sizeof (string), fmt, argptr);
+	va_end (argptr);
+
+	mdl_job_release ();
+	if (mdl.tmpfile[0])
+	{
+		remove (mdl.tmpfile);
+		mdl.tmpfile[0] = 0;
+	}
+	q_strlcpy (mdl.reason, string, sizeof (mdl.reason));
+	mdl.state = MDL_FAILED;
+	// Every line this file prints starts with "mapdl:" so a log tail is greppable
+	// without knowing which of the two sources ran.
+	Con_Printf ("mapdl: FAILED — %s\n", string);
+}
+
+// https only, and a trailing slash, for both source cvars. A player who points
+// these at http:// on a public network is one MITM away from a downloaded file
+// they did not choose, and the fixture harness overrides the check explicitly
+// rather than by accident (see cl_mapdownload_allowhttp).
+cvar_t cl_mapdownload_allowhttp = {"cl_mapdownload_allowhttp", "0", CVAR_NONE};
+
+static qboolean cl_mapdl_url_ok (const char *url)
+{
+	if (!q_strncasecmp (url, "https://", 8))
+		return true;
+	if (cl_mapdownload_allowhttp.value >= 0.5f && !q_strncasecmp (url, "http://", 7))
+		return true;
+	return false;
+}
+
+// Build "<base>[/]<tail>" without ever producing "//" or dropping the separator.
+static void mdl_join_url (char *out, size_t len, const char *base, const char *tail)
+{
+	size_t n = strlen (base);
+	if (n && base[n - 1] == '/')
+		q_snprintf (out, len, "%s%s", base, tail);
+	else
+		q_snprintf (out, len, "%s/%s", base, tail);
+}
+
+// A map name is used to build a URL and a file path, so it is validated hard:
+// lowercase letters, digits, underscore, hyphen, plus. Anything else (a slash, a
+// dot, a percent, a control byte) and we refuse — a server chooses this string.
+static qboolean mdl_mapname_ok (const char *name)
+{
+	const char *p;
+	if (!name || !*name || strlen (name) >= 48)
+		return false;
+	for (p = name; *p; p++)
+	{
+		if (*p >= 'a' && *p <= 'z')
+			continue;
+		if (*p >= '0' && *p <= '9')
+			continue;
+		if (*p == '_' || *p == '-' || *p == '+')
+			continue;
+		return false;
+	}
+	return true;
+}
+
+// A .bsp we are about to install must actually be a Quake map. Version 29 is
+// vanilla, "BSP2" and "2PSB" are the large-map formats vkQuake loads. Checking
+// the header before the file lands is what stops an archive's 404 page, an
+// HTML error, or a truncated transfer from being installed under a name the
+// engine will later try to load as a world model.
+static qboolean mdl_bsp_header_ok (const char *path, char *why, size_t whylen)
+{
+	FILE		 *f = fopen (path, "rb");
+	unsigned char h[4];
+	unsigned int  v;
+
+	if (!f)
+	{
+		q_strlcpy (why, "cannot read the downloaded file", whylen);
+		return false;
+	}
+	if (fread (h, 1, 4, f) != 4)
+	{
+		fclose (f);
+		q_strlcpy (why, "downloaded file is too small to be a map", whylen);
+		return false;
+	}
+	fclose (f);
+	if (!memcmp (h, "BSP2", 4) || !memcmp (h, "2PSB", 4))
+		return true;
+	v = (unsigned int)h[0] | ((unsigned int)h[1] << 8) | ((unsigned int)h[2] << 16) | ((unsigned int)h[3] << 24);
+	if (v == 29)
+		return true;
+	q_snprintf (why, whylen, "not a Quake map (header %02x%02x%02x%02x)", h[0], h[1], h[2], h[3]);
+	return false;
+}
+
+// Where downloads land before they are validated. Inside the writable game dir
+// so it shares the same volume as the destination and the final move is a rename
+// rather than a copy — and so a partial file can never be picked up by a
+// searchpath scan (it is not under maps/ and it carries a .part suffix).
+static void mdl_tmp_path (char *out, size_t len, const char *leaf)
+{
+	q_snprintf (out, len, "%s/mapdl", com_gamedir);
+	Sys_mkdir (out);
+	q_snprintf (out, len, "%s/mapdl/%s", com_gamedir, leaf);
+}
+
+// ---------------------------------------------------------------------------
+// install
+// ---------------------------------------------------------------------------
+static qboolean mdl_install_bsp (const char *tmp, const char *map)
+{
+	char dir[MAX_OSPATH], dest[MAX_OSPATH], why[96];
+
+	if (!mdl_bsp_header_ok (tmp, why, sizeof (why)))
+	{
+		mdl_fail ("%s", why);
+		return false;
+	}
+	q_snprintf (dir, sizeof (dir), "%s/maps", com_gamedir);
+	Sys_mkdir (dir);
+	q_snprintf (dest, sizeof (dest), "%s/maps/%s.bsp", com_gamedir, map);
+	// NEVER overwrite. If the file is there, the precache check that started this
+	// found something else missing, or the player installed it in the meantime;
+	// either way clobbering their copy is not ours to do.
+	if (Sys_FileType (dest) & FS_ENT_FILE)
+	{
+		mdl_fail ("maps/%s.bsp already exists", map);
+		return false;
+	}
+	if (rename (tmp, dest) != 0)
+	{
+		mdl_fail ("could not move the map into %s", dir);
+		return false;
+	}
+	Con_Printf ("mapdl: installed maps/%s.bsp -> %s\n", map, dir);
+	return true;
+}
+
+/*
+ * Package install (source B).
+ *
+ * The extract root is derived from OUR filesystem, never from the record:
+ * install.extract is a hint of the form "{base}/<dir>/" and only its <dir>
+ * component is used, validated as a single plain directory name. {base} is
+ * always host_parms->userdir — the Documents root that holds id1/ — so no
+ * archive record can aim the extraction anywhere else, and COM_UnzipToDir
+ * re-checks containment for every entry it writes.
+ */
+static qboolean mdl_install_pkg (const char *zip, const char *map, const char *extracthint)
+{
+	char	 root[MAX_OSPATH], dir[64], err[128], dest[MAX_OSPATH], found[MAX_OSPATH];
+	int		 n;
+	qboolean placed;
+
+	dir[0] = 0;
+	if (extracthint && *extracthint)
+	{
+		const char *p = strstr (extracthint, "{base}");
+		const char *s = p ? p + 6 : extracthint;
+		char	   *w = dir;
+		while (*s == '/')
+			s++;
+		while (*s && *s != '/' && (size_t)(w - dir) < sizeof (dir) - 1)
+			*w++ = *s++;
+		*w = 0;
+		// A single plain directory name or nothing. "..", an empty component, a
+		// name with a separator in it: all rejected, all fall back to the gamedir.
+		if (!dir[0] || strstr (dir, "..") || strchr (dir, '\\') || strchr (dir, ':'))
+			dir[0] = 0;
+	}
+	if (dir[0])
+		q_snprintf (root, sizeof (root), "%s/%s", host_parms->userdir, dir);
+	else
+		q_strlcpy (root, com_gamedir, sizeof (root)); // the gamedir we are actually running
+	Sys_mkdir (root);
+
+	n = COM_UnzipToDir (zip, root, host_parms->userdir, err, sizeof (err));
+	if (n < 0)
+	{
+		mdl_fail ("%s", err);
+		return false;
+	}
+	Con_Printf ("mapdl: extracted %d file(s) into %s\n", n, root);
+
+	// Did the map actually arrive somewhere the engine will look? Package layouts
+	// on the archive are not uniform (some zips are rooted at the mod dir, some at
+	// maps/), so the authority is the engine's own search path, asked after the
+	// fact — not the layout we guessed before it.
+	{
+		char rel[64];
+		q_snprintf (rel, sizeof (rel), "maps/%s.bsp", map);
+		if (COM_FileExists (rel, NULL))
+			return true;
+	}
+	// It did not. Find the extracted .bsp by name and place it where the engine
+	// searches. This is the fallback that makes an inconsistent archive usable.
+	placed = COM_FindExtractedFile (root, va ("%s.bsp", map), found, sizeof (found));
+	if (!placed)
+	{
+		mdl_fail ("package did not contain %s.bsp", map);
+		return false;
+	}
+	q_snprintf (dest, sizeof (dest), "%s/maps", com_gamedir);
+	Sys_mkdir (dest);
+	q_snprintf (dest, sizeof (dest), "%s/maps/%s.bsp", com_gamedir, map);
+	if (Sys_FileType (dest) & FS_ENT_FILE)
+		return true; // already there — nothing to do, and nothing to overwrite
+	if (rename (found, dest) != 0)
+	{
+		mdl_fail ("could not move %s.bsp into the game directory", map);
+		return false;
+	}
+	Con_Printf ("mapdl: placed maps/%s.bsp from the package\n", map);
+	return true;
+}
+
+// ---------------------------------------------------------------------------
+// step transitions
+// ---------------------------------------------------------------------------
+static void mdl_begin_get_bsp (void)
+{
+	mdl_job_release ();
+	mdl_tmp_path (mdl.tmpfile, sizeof (mdl.tmpfile), va ("%s.bsp.part", mdl.map));
+	remove (mdl.tmpfile);
+	mdl.job = VKQ_DL_StartGet (mdl.url, mdl.tmpfile);
+	if (!mdl.job)
+	{
+		mdl_fail ("could not start the download");
+		return;
+	}
+	mdl.got = 0;
+	mdl.state = MDL_GET_BSP;
+	Con_Printf ("mapdl: downloading %s\n", mdl.url);
+}
+
+static void mdl_begin_index (void)
+{
+	char url[512], path[512];
+	const char *caches = VKQ_DL_CachesPath ();
+
+	mdl_job_release ();
+	if (!caches || !*caches)
+	{
+		mdl_fail ("no cache directory for the archive index");
+		return;
+	}
+	q_snprintf (path, sizeof (path), "%s/quaddicted-index.json", caches);
+	q_strlcpy (mdl.tmpfile, path, sizeof (mdl.tmpfile));
+
+	// Fresh enough? The dump is ~18 MB and the archive gains a handful of
+	// releases a month, so a weekly refresh is generous and a per-join fetch
+	// would be indefensible.
+	{
+		double		age_days = 1e9;
+		struct stat st;
+		if (stat (path, &st) == 0 && st.st_size > 1024)
+			age_days = (double)(time (NULL) - st.st_mtime) / 86400.0;
+		if (age_days <= (double)cl_mapdownload_indexdays.value)
+		{
+			Con_Printf ("mapdl: using cached archive index (%.1f days old)\n", age_days);
+			mdl.job = VKQ_DL_StartResolve (path, mdl.map);
+			if (!mdl.job)
+			{
+				mdl_fail ("could not read the archive index");
+				return;
+			}
+			mdl.state = MDL_RESOLVE;
+			return;
+		}
+	}
+	mdl_join_url (url, sizeof (url), cl_mapdownload_pkgurl.string, "?q=*");
+	if (!cl_mapdl_url_ok (url))
+	{
+		mdl_fail ("archive index URL is not https");
+		return;
+	}
+	mdl.job = VKQ_DL_StartGet (url, path);
+	if (!mdl.job)
+	{
+		mdl_fail ("could not start the archive index download");
+		return;
+	}
+	mdl.got = mdl.total = 0;
+	mdl.state = MDL_GET_INDEX;
+	Con_Printf ("mapdl: fetching the archive index from %s\n", url);
+}
+
+static void mdl_begin_get_pkg (void)
+{
+	mdl_job_release ();
+	mdl_tmp_path (mdl.tmpfile, sizeof (mdl.tmpfile), va ("%s.zip.part", mdl.map));
+	remove (mdl.tmpfile);
+	mdl.job = VKQ_DL_StartGet (mdl.url, mdl.tmpfile);
+	if (!mdl.job)
+	{
+		mdl_fail ("could not start the package download");
+		return;
+	}
+	mdl.got = 0;
+	mdl.state = MDL_GET_PKG;
+	Con_Printf ("mapdl: downloading package %s\n", mdl.url);
+}
+
+static void mdl_reconnect (void)
+{
+	mdl_job_release ();
+	mdl.tmpfile[0] = 0;
+	mdl.state = MDL_RECONNECT;
+	if (!mdl.target[0])
+	{
+		Con_Printf ("mapdl: installed, but there is no server address to rejoin\n");
+		mdl.state = MDL_IDLE;
+		key_dest = key_menu;
+		m_state = m_main;
+		return;
+	}
+	Con_Printf ("mapdl: rejoining %s\n", mdl.target);
+	IN_Activate ();
+	key_dest = key_game;
+	m_state = m_none;
+	Cbuf_AddText (va ("connect \"%s\"\n", mdl.target));
+}
+
+// The player said yes (or cl_mapdownload 2 said it for them).
+static void mdl_accept (void)
+{
+	if (mdl.state != MDL_PROMPT)
+		return;
+	if (mdl.source == 1)
+		mdl_begin_get_bsp ();
+	else
+		mdl_begin_index ();
+}
+
+// MDL_INSTALL has no job to poll: it is the one synchronous step, run from the
+// pump on its own frame so the "Installing..." line is on screen while a large
+// zip is being written rather than after it.
+static void mdl_do_install (void)
+{
+	char zip[512];
+	q_strlcpy (zip, mdl.tmpfile, sizeof (zip));
+	if (mdl_install_pkg (zip, mdl.map, mdl.extract))
+	{
+		remove (zip);
+		mdl.tmpfile[0] = 0;
+		mdl_reconnect ();
+	}
+}
+
+// ---------------------------------------------------------------------------
+// per-frame pump (host.c _Host_Frame)
+//
+// Driven from the HOST FRAME and not from the menu draw, deliberately: the menu
+// only draws while key_dest == key_menu, so a player who pulls the console down
+// to watch the log — which is exactly what a harness does to screenshot it —
+// would otherwise stall the transfer at whatever byte it had reached.
+// ---------------------------------------------------------------------------
+void CL_MapDownload_Frame (void)
+{
+	long long got = 0, total = 0;
+	int		  status = 0, r;
+
+	if (mdl.state == MDL_INSTALL)
+	{
+		mdl_do_install ();
+		return;
+	}
+
+	switch (mdl.state)
+	{
+	case MDL_IDLE:
+	case MDL_PROMPT:
+	case MDL_FAILED:
+	case MDL_RECONNECT:
+		return;
+	default:
+		break;
+	}
+
+	if (!mdl.job)
+	{
+		mdl_fail ("internal: no download job");
+		return;
+	}
+
+	r = VKQ_DL_Poll (mdl.job, &got, &total, &status);
+	mdl.got = got;
+	if (total > 0)
+		mdl.total = total;
+	if (r == DLP_RUNNING)
+		return;
+
+	switch (mdl.state)
+	{
+	case MDL_PROBE:
+		// Source A answered. 200 means the bare .bsp is there and we know its size;
+		// anything else sends us to the package archive.
+		if (r == DLP_DONE && status == 200 && total > 0)
+		{
+			mdl.source = 1;
+			mdl.total = total;
+			q_strlcpy (mdl.srcname, "maps.quakeworld.nu", sizeof (mdl.srcname));
+			q_snprintf (mdl.title, sizeof (mdl.title), "%s.bsp", mdl.map);
+			if ((double)total > cl_mapdownload_maxbsp.value * 1024.0 * 1024.0)
+			{
+				mdl_fail ("%s.bsp is %.0f MB (limit %.0f MB)", mdl.map, (double)total / 1048576.0, cl_mapdownload_maxbsp.value);
+				return;
+			}
+			mdl_job_release ();
+			Con_Printf ("mapdl: %s.bsp found on %s (%lld bytes)\n", mdl.map, mdl.srcname, total);
+			mdl.state = MDL_PROMPT;
+			if (cl_mapdownload.value >= 1.5f)
+				mdl_accept ();
+			return;
+		}
+		mdl_job_release ();
+		Con_Printf ("mapdl: %s.bsp is not on the bare-map mirror (http %d) — trying the package archive\n", mdl.map, status);
+		mdl.source = 2;
+		q_strlcpy (mdl.srcname, "quaddicted.com", sizeof (mdl.srcname));
+		q_snprintf (mdl.title, sizeof (mdl.title), "%s.bsp", mdl.map);
+		mdl.total = 0;
+		mdl.state = MDL_PROMPT;
+		if (cl_mapdownload.value >= 1.5f)
+			mdl_accept ();
+		return;
+
+	case MDL_GET_BSP:
+		if (r != DLP_DONE || status != 200)
+		{
+			mdl_fail ("download failed (%s)", VKQ_DL_Error (mdl.job));
+			return;
+		}
+		mdl_job_release ();
+		if (mdl_install_bsp (mdl.tmpfile, mdl.map))
+			mdl_reconnect ();
+		return;
+
+	case MDL_GET_INDEX:
+		if (r != DLP_DONE || status != 200)
+		{
+			mdl_fail ("archive index unavailable (%s)", VKQ_DL_Error (mdl.job));
+			return;
+		}
+		mdl_job_release ();
+		Con_Printf ("mapdl: archive index cached; searching for %s.bsp\n", mdl.map);
+		mdl.job = VKQ_DL_StartResolve (mdl.tmpfile, mdl.map);
+		if (!mdl.job)
+		{
+			mdl_fail ("could not read the archive index");
+			return;
+		}
+		mdl.state = MDL_RESOLVE;
+		return;
+
+	case MDL_RESOLVE:
+		if (r != DLP_DONE)
+		{
+			mdl_fail ("not found in community archives");
+			return;
+		}
+		q_strlcpy (mdl.url, VKQ_DL_Result (mdl.job, "url"), sizeof (mdl.url));
+		q_strlcpy (mdl.sha256, VKQ_DL_Result (mdl.job, "sha256"), sizeof (mdl.sha256));
+		q_strlcpy (mdl.extract, VKQ_DL_Result (mdl.job, "extract"), sizeof (mdl.extract));
+		q_strlcpy (mdl.title, VKQ_DL_Result (mdl.job, "title"), sizeof (mdl.title));
+		mdl.total = strtoll (VKQ_DL_Result (mdl.job, "bytes"), NULL, 10);
+		mdl_job_release ();
+		if (!mdl.url[0] || !cl_mapdl_url_ok (mdl.url))
+		{
+			mdl_fail ("archive record has no usable https download");
+			return;
+		}
+		if (mdl.total > 0 && (double)mdl.total > cl_mapdownload_maxpkg.value * 1024.0 * 1024.0)
+		{
+			mdl_fail ("package is %.0f MB (limit %.0f MB)", (double)mdl.total / 1048576.0, cl_mapdownload_maxpkg.value);
+			return;
+		}
+		Con_Printf ("mapdl: found \"%s\" in the archive (%lld bytes)\n", mdl.title, mdl.total);
+		mdl_begin_get_pkg ();
+		return;
+
+	case MDL_GET_PKG:
+		if (r != DLP_DONE || status != 200)
+		{
+			mdl_fail ("package download failed (%s)", VKQ_DL_Error (mdl.job));
+			return;
+		}
+		mdl_job_release ();
+		if (!mdl.sha256[0])
+		{
+			// No hash in the record: install anyway, but say so. The zip reader and
+			// the BSP header check are still between this file and the game.
+			Con_Warning ("mapdl: archive record carries no sha256; installing unverified\n");
+			mdl.state = MDL_INSTALL;
+			return;
+		}
+		mdl.job = VKQ_DL_StartSha256 (mdl.tmpfile);
+		if (!mdl.job)
+		{
+			mdl_fail ("could not hash the package");
+			return;
+		}
+		mdl.state = MDL_HASH;
+		return;
+
+	case MDL_HASH:
+	{
+		const char *h = (r == DLP_DONE) ? VKQ_DL_Result (mdl.job, "sha256") : "";
+		if (r != DLP_DONE || !h || q_strcasecmp (h, mdl.sha256))
+		{
+			mdl_fail ("package sha256 mismatch — refusing to install");
+			return;
+		}
+		mdl_job_release ();
+		Con_Printf ("mapdl: sha256 verified (%.16s...)\n", mdl.sha256);
+		mdl.state = MDL_INSTALL;
+		return;
+	}
+
+	default:
+		break;
+	}
+}
+
+// ---------------------------------------------------------------------------
+// entry point: called from CL_ParseServerInfo when a maps/*.bsp is missing.
+// Returns true if the download flow has taken over the failure (the caller must
+// still tear the connection down); false to keep overlay 0026's clean failure.
+// ---------------------------------------------------------------------------
+qboolean CL_MapDownload_Begin (const char *modelname, const char *servergamedir, const char *target)
+{
+	char		url[512];
+	const char *base;
+	char		map[64];
+
+	if (cl_mapdownload.value < 0.5f)
+	{
+		Con_Printf ("mapdl: cl_mapdownload is 0 — not offering to download\n");
+		return false;
+	}
+	if (mdl.state != MDL_IDLE && mdl.state != MDL_FAILED)
+	{
+		Con_Printf ("mapdl: a download is already in progress\n");
+		return false;
+	}
+	COM_StripExtension (COM_SkipPath (modelname), map, sizeof (map));
+	q_strlwr (map);
+	if (!mdl_mapname_ok (map))
+	{
+		Con_Printf ("mapdl: refusing to fetch a map with an unusable name\n");
+		return false;
+	}
+	if (mdl_already_tried (map))
+	{
+		// The rejoin came back asking for the same map. Something is wrong with
+		// what we installed (a same-named DM map at a different revision is the
+		// realistic case) and retrying would loop. Hand it back to 0026.
+		Con_Printf ("mapdl: already tried %s.bsp this session — not retrying\n", map);
+		return false;
+	}
+
+	base = cl_mapdownload_bspurl.string;
+	mdl_join_url (url, sizeof (url), base, va ("%s.bsp", map));
+	if (!cl_mapdl_url_ok (url))
+	{
+		Con_Printf ("mapdl: cl_mapdownload_bspurl is not https — refusing\n");
+		return false;
+	}
+
+	memset (&mdl, 0, sizeof (mdl));
+	q_strlcpy (mdl.map, map, sizeof (mdl.map));
+	q_strlcpy (mdl.url, url, sizeof (mdl.url));
+	q_strlcpy (mdl.target, target ? target : "", sizeof (mdl.target));
+	q_strlcpy (mdl.gamedir, servergamedir ? servergamedir : "", sizeof (mdl.gamedir));
+	q_strlcpy (mdl.title, va ("%s.bsp", map), sizeof (mdl.title));
+	q_strlcpy (mdl.srcname, "checking...", sizeof (mdl.srcname));
+	mdl.started = realtime;
+	mdl_remember (map);
+
+	mdl.job = VKQ_DL_StartHead (url);
+	if (!mdl.job)
+	{
+		Con_Printf ("mapdl: could not start the source probe\n");
+		return false;
+	}
+	mdl.state = MDL_PROBE;
+	Con_Printf ("mapdl: %s.bsp missing; probing %s\n", map, url);
+	M_Menu_MapDownload_f ();
+	return true;
+}
+
+// ---------------------------------------------------------------------------
+// menu-facing accessors (menu.c owns the drawing; this owns the truth)
+// ---------------------------------------------------------------------------
+int CL_MapDownload_State (void) { return (int)mdl.state; }
+
+qboolean CL_MapDownload_Prompting (void) { return mdl.state == MDL_PROMPT; }
+
+qboolean CL_MapDownload_Failed (void) { return mdl.state == MDL_FAILED; }
+
+const char *CL_MapDownload_Line1 (void)
+{
+	static char buf[64];
+	q_snprintf (buf, sizeof (buf), "%s.bsp", mdl.map);
+	return buf;
+}
+
+const char *CL_MapDownload_Line2 (void)
+{
+	static char buf[80];
+	switch (mdl.state)
+	{
+	case MDL_PROBE:
+		q_snprintf (buf, sizeof (buf), "Looking for it online...");
+		break;
+	case MDL_PROMPT:
+		if (mdl.total > 0)
+			q_snprintf (buf, sizeof (buf), "%.1f MB from %s", (double)mdl.total / 1048576.0, mdl.srcname);
+		else
+			q_snprintf (buf, sizeof (buf), "Search %s (size unknown)", mdl.srcname);
+		break;
+	case MDL_GET_BSP:
+	case MDL_GET_PKG:
+		if (mdl.total > 0)
+			q_snprintf (
+				buf, sizeof (buf), "Downloading %lld / %lld KB (%d%%)", mdl.got / 1024, mdl.total / 1024, (int)(mdl.got * 100 / (mdl.total ? mdl.total : 1)));
+		else
+			q_snprintf (buf, sizeof (buf), "Downloading %lld KB", mdl.got / 1024);
+		break;
+	case MDL_GET_INDEX:
+		q_snprintf (buf, sizeof (buf), "Archive index %lld KB", mdl.got / 1024);
+		break;
+	case MDL_RESOLVE:
+		q_snprintf (buf, sizeof (buf), "Searching the archive...");
+		break;
+	case MDL_HASH:
+		q_snprintf (buf, sizeof (buf), "Verifying...");
+		break;
+	case MDL_INSTALL:
+		q_snprintf (buf, sizeof (buf), "Installing...");
+		break;
+	case MDL_RECONNECT:
+		q_snprintf (buf, sizeof (buf), "Rejoining...");
+		break;
+	case MDL_FAILED:
+		q_strlcpy (buf, mdl.reason, sizeof (buf));
+		break;
+	default:
+		buf[0] = 0;
+		break;
+	}
+	return buf;
+}
+
+void CL_MapDownload_Cancel (void)
+{
+	if (mdl.state == MDL_IDLE)
+		return;
+	mdl_job_release ();
+	if (mdl.tmpfile[0] && mdl.state != MDL_GET_INDEX) // a cached index is not garbage
+		remove (mdl.tmpfile);
+	Con_Printf ("mapdl: cancelled\n");
+	memset (&mdl, 0, sizeof (mdl));
+	mdl.state = MDL_IDLE;
+}
+
+// ---------------------------------------------------------------------------
+// console commands. These exist for three reasons: the menu rows issue them (so
+// the menu holds no logic), a controller/keyboard user can bind them, and the
+// simulator harness has an assertion channel that does not depend on synthesising
+// touches — which do not reach UIKit on the simulator anyway.
+// ---------------------------------------------------------------------------
+static void CL_MapDownload_Accept_f (void)
+{
+	if (mdl.state != MDL_PROMPT)
+	{
+		Con_Printf ("mapdl: nothing to accept\n");
+		return;
+	}
+	Con_Printf ("mapdl: accepted\n");
+	mdl_accept ();
+}
+
+static void CL_MapDownload_Cancel_f (void)
+{
+	CL_MapDownload_Cancel ();
+	key_dest = key_menu;
+	m_state = m_main;
+	IN_Deactivate (true);
+}
+
+static const char *mdl_statename (void)
+{
+	switch (mdl.state)
+	{
+	case MDL_IDLE:
+		return "idle";
+	case MDL_PROBE:
+		return "probe";
+	case MDL_PROMPT:
+		return "prompt";
+	case MDL_GET_BSP:
+		return "get_bsp";
+	case MDL_GET_INDEX:
+		return "get_index";
+	case MDL_RESOLVE:
+		return "resolve";
+	case MDL_GET_PKG:
+		return "get_pkg";
+	case MDL_HASH:
+		return "hash";
+	case MDL_INSTALL:
+		return "install";
+	case MDL_RECONNECT:
+		return "reconnect";
+	case MDL_FAILED:
+		return "failed";
+	}
+	return "?";
+}
+
+static void CL_MapDownload_Status_f (void)
+{
+	Con_Printf (
+		"mapdl status: state=%s map=%s source=%d got=%lld total=%lld target=%s reason=%s\n", mdl_statename (), mdl.map[0] ? mdl.map : "-", mdl.source,
+		mdl.got, mdl.total, mdl.target[0] ? mdl.target : "-", mdl.reason[0] ? mdl.reason : "-");
+}
+
+void CL_MapDownload_Init (void)
+{
+	Cvar_RegisterVariable (&cl_mapdownload);
+	Cvar_RegisterVariable (&cl_mapdownload_bspurl);
+	Cvar_RegisterVariable (&cl_mapdownload_pkgurl);
+	Cvar_RegisterVariable (&cl_mapdownload_maxbsp);
+	Cvar_RegisterVariable (&cl_mapdownload_maxpkg);
+	Cvar_RegisterVariable (&cl_mapdownload_indexdays);
+	Cvar_RegisterVariable (&cl_mapdownload_allowhttp);
+	Cmd_AddCommand ("mapdl_accept", CL_MapDownload_Accept_f);
+	Cmd_AddCommand ("mapdl_cancel", CL_MapDownload_Cancel_f);
+	Cmd_AddCommand ("mapdl_status", CL_MapDownload_Status_f);
+}
