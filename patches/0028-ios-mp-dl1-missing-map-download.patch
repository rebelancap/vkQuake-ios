+#ifdef VKQ_IOS
+/*
+===========================================================================
+vkquake-ios overlay 0028 — ZIP EXTRACTION FOR THE MAP DOWNLOADER
+
+Here, and not in the shell, for one reason: this translation unit already
+`#include "miniz.c"` stb-style, so a second copy linked into the app would give
+the binary two miniz code paths with two sets of allocator hooks (miniz's
+MZ_MALLOC is wired to Mem_Alloc a hundred lines above). One zip reader, one
+allocator, one place to audit.
+
+Everything below is written as if the archive were hostile, because it is only
+ever fed archives fetched from the public internet:
+
+  - ZIP SLIP. Every entry name is validated before a path is built from it, not
+    after: no absolute paths, no drive letters, no backslashes, no "." or ".."
+    component, no control bytes. The assembled path is then re-checked against
+    BOTH the destination directory and an outer boundary (the Documents root),
+    so an entry has to defeat a syntactic check and a containment check.
+  - NO OVERWRITING, EVER. An entry whose destination already exists is skipped
+    and the skip is logged by name. The player's own files — including a map
+    they installed by hand — are never replaced by something a server's map name
+    caused us to download.
+  - No archive writing APIs are compiled in (miniz.h: MINIZ_NO_ARCHIVE_WRITING_APIS),
+    so this is read-only by construction.
+===========================================================================
+*/
+#include <dirent.h>
+
+// mz_file_write_func: sequential writes into an already-open FILE *.
+static size_t COM_ZipWriteFunc (void *opaque, mz_uint64 ofs, const void *buf, size_t n)
+{
+	(void)ofs; // extract_to_callback delivers in order and we never seek
+	return fwrite (buf, 1, n, (FILE *)opaque);
 }
 
 /*
+ * Validate one zip entry name and copy it out. Returns false for anything that
+ * could escape the destination or name something that is not a plain relative
+ * path. Also collapses repeated slashes, which are legal in a zip and would
+ * otherwise produce an empty component.
+ */
+static qboolean COM_ZipSafeName (const char *name, char *out, size_t outlen)
+{
+	const char *s = name;
+	char	   *w = out;
+	size_t		comp = 0;
+
+	if (!name || !*name || strlen (name) >= outlen)
+		return false;
+	if (*name == '/' || *name == '\\')
+		return false; // absolute
+	if (strchr (name, ':'))
+		return false; // drive letter / alternate stream
+	if (strchr (name, '\\'))
+		return false; // windows separator: normalising it is not our job
+	for (s = name; *s; s++)
+		if ((unsigned char)*s < 0x20)
+			return false; // control bytes have no business in a path
+
+	// component walk
+	s = name;
+	while (*s)
+	{
+		const char *e = strchr (s, '/');
+		size_t		len = e ? (size_t)(e - s) : strlen (s);
+		if (len == 0)
+		{ // "//" or a trailing slash (directory entry): skip the empty component
+			if (!e)
+				break;
+			s = e + 1;
+			continue;
+		}
+		if (len == 1 && s[0] == '.')
+			return false;
+		if (len == 2 && s[0] == '.' && s[1] == '.')
+			return false;
+		if (comp++)
+			*w++ = '/';
+		if ((size_t)(w - out) + len >= outlen)
+			return false;
+		memcpy (w, s, len);
+		w += len;
+		if (!e)
+			break;
+		s = e + 1;
+	}
+	*w = 0;
+	return out[0] != 0;
+}
+
+// "is `path` inside `root`" as a textual containment test. Both sides are
+// engine-built absolute paths with no symlink component, so a prefix test is the
+// honest check here; realpath() would be theatre on paths we assembled ourselves.
+static qboolean COM_PathInside (const char *root, const char *path)
+{
+	size_t n = strlen (root);
+	if (!n || strncmp (path, root, n))
+		return false;
+	return path[n] == '/' || path[n] == 0;
+}
+
+// mkdir every parent component of `path` (which names a FILE) beneath `root`.
+static void COM_MakeParents (const char *root, const char *path)
+{
+	char   tmp[MAX_OSPATH];
+	char  *p;
+	size_t rootlen = strlen (root);
+
+	q_strlcpy (tmp, path, sizeof (tmp));
+	for (p = tmp + rootlen + 1; *p; p++)
+	{
+		if (*p != '/')
+			continue;
+		*p = 0;
+		Sys_mkdir (tmp);
+		*p = '/';
+	}
+}
+
+/*
 ================
+COM_UnzipToDir
+
+Extract `zippath` into `destdir`, refusing to write anything outside `boundary`.
+Existing files are SKIPPED (and logged), never replaced.
+Returns the number of files written, or -1 with a reason in `err`.
+================
+*/
+int COM_UnzipToDir (const char *zippath, const char *destdir, const char *boundary, char *err, size_t errlen)
+{
+#ifdef USE_SDL3
+	SDL_IOStream *rw = SDL_IOFromFile (zippath, "rb");
+#else
+	SDL_RWops *rw = SDL_RWFromFile (zippath, "rb");
+#endif
+	mz_zip_archive ar;
+	Sint64		   sz;
+	mz_uint		   i, count;
+	int			   written = 0;
+
+	memset (&ar, 0, sizeof (ar));
+	if (!rw)
+	{
+		q_strlcpy (err, "could not open the downloaded package", errlen);
+		return -1;
+	}
+#ifdef USE_SDL3
+	sz = SDL_GetIOSize (rw);
+#else
+	sz = SDL_RWsize (rw);
+#endif
+	if (sz <= 0)
+	{
+		q_strlcpy (err, "the downloaded package is empty", errlen);
+		goto fail;
+	}
+	if (!COM_PathInside (boundary, destdir))
+	{
+		q_strlcpy (err, "internal: extract path is outside the game folder", errlen);
+		goto fail;
+	}
+	ar.m_pRead = mz_zip_file_read_func;
+	ar.m_pIO_opaque = rw;
+	if (!mz_zip_reader_init (&ar, sz, 0))
+	{
+		q_strlcpy (err, "the downloaded file is not a zip archive", errlen);
+		goto fail;
+	}
+
+	count = mz_zip_reader_get_num_files (&ar);
+	for (i = 0; i < count; i++)
+	{
+		mz_zip_archive_file_stat st;
+		char					  rel[MAX_OSPATH], full[MAX_OSPATH];
+
+		if (!mz_zip_reader_file_stat (&ar, i, &st))
+			continue;
+		if (!COM_ZipSafeName (st.m_filename, rel, sizeof (rel)))
+		{
+			Con_Warning ("mapdl: rejected unsafe zip entry \"%s\"\n", st.m_filename);
+			continue;
+		}
+		q_snprintf (full, sizeof (full), "%s/%s", destdir, rel);
+		// Belt and braces: the name passed the syntactic check, now the assembled
+		// path must also still be under both roots.
+		if (!COM_PathInside (destdir, full) || !COM_PathInside (boundary, full))
+		{
+			Con_Warning ("mapdl: rejected escaping zip entry \"%s\"\n", st.m_filename);
+			continue;
+		}
+		if (mz_zip_reader_is_file_a_directory (&ar, i))
+		{
+			COM_MakeParents (destdir, full);
+			Sys_mkdir (full);
+			continue;
+		}
+		if (Sys_FileType (full) & FS_ENT_FILE)
+		{
+			Con_Printf ("mapdl: skip (exists) %s\n", rel);
+			continue;
+		}
+		COM_MakeParents (destdir, full);
+		{
+			FILE *out = fopen (full, "wb");
+			if (!out)
+			{
+				Con_Warning ("mapdl: could not write %s\n", rel);
+				continue;
+			}
+			if (!mz_zip_reader_extract_to_callback (&ar, i, COM_ZipWriteFunc, out, 0))
+			{
+				fclose (out);
+				remove (full);
+				Con_Warning ("mapdl: failed to extract %s\n", rel);
+				continue;
+			}
+			fclose (out);
+			written++;
+			Con_DPrintf ("mapdl: extracted %s\n", rel);
+		}
+	}
+	mz_zip_reader_end (&ar);
+#ifdef USE_SDL3
+	SDL_CloseIO (rw);
+#else
+	SDL_RWclose (rw);
+#endif
+	return written;
+
+fail:
+	mz_zip_reader_end (&ar);
+#ifdef USE_SDL3
+	SDL_CloseIO (rw);
+#else
+	SDL_RWclose (rw);
+#endif
+	return -1;
+}
+
+/*
+================
+COM_FindExtractedFile
+
+Depth-limited search under `root` for a file with exactly this basename. The map
+downloader uses it after extraction, because package layouts on the community
+archive are not uniform and the only authority on where the .bsp landed is the
+filesystem.
+================
+*/
+qboolean COM_FindExtractedFile (const char *root, const char *basename, char *out, size_t outlen)
+{
+	static int	   depth = 0;
+	DIR			  *d;
+	struct dirent *e;
+	qboolean	   found = false;
+
+	if (depth > 6)
+		return false;
+	d = opendir (root);
+	if (!d)
+		return false;
+	depth++;
+	while (!found && (e = readdir (d)) != NULL)
+	{
+		char sub[MAX_OSPATH];
+		if (!strcmp (e->d_name, ".") || !strcmp (e->d_name, ".."))
+			continue;
+		q_snprintf (sub, sizeof (sub), "%s/%s", root, e->d_name);
+		if (Sys_FileType (sub) & FS_ENT_DIRECTORY)
+			found = COM_FindExtractedFile (sub, basename, out, outlen);
+		else if (!q_strcasecmp (e->d_name, basename))
+		{
+			q_strlcpy (out, sub, outlen);
+			found = true;
+		}
+	}
+	depth--;
+	closedir (d);
+	return found;
+}
