+/* MISSING-MAP DOWNLOAD MENU -- vkquake-ios overlay 0028 (MP-DL1) */
+
+/*
+ * The screen that replaces R6.5's dead end. It draws state that lives in
+ * cl_mapdl.c and owns none of it: every row this menu can activate is issued as
+ * a console command, so the same decision can be made from a controller bind,
+ * the console, an automation harness, or this menu, and there is exactly one
+ * implementation of "yes" behind all four.
+ *
+ * Two rows in the consent state, one while a transfer is running. The rows are
+ * drawn at the Options-menu rhythm (8px pitch, flashing character cursor) with
+ * M_Mouse_UpdateListCursor over them, which is what makes them work under a
+ * finger: patch 0009 feeds the menu cursor from SDL finger events and fires a
+ * synthetic K_MOUSE1 two frames after the lift.
+ */
+static int mapdl_cursor;
+
+#define MAPDL_TOP_Y 96
+
+void M_Menu_MapDownload_f (void)
+{
+	M_MenuChanged ();
+	IN_Deactivate (true);
+	key_dest = key_menu;
+	m_state = m_mapdl;
+	mapdl_cursor = 0;
+	m_return_reason[0] = 0;
+}
+
+static int M_MapDownload_Rows (void)
+{
+	// Prompt: Download / Cancel. Anything else: a single row, which is Cancel
+	// while work is in flight and Back once it has failed.
+	return CL_MapDownload_Prompting () ? 2 : 1;
+}
+
+static void M_MapDownload_Draw (cb_context_t *cbx)
+{
+	qpic_t	 *p;
+	const int rows = M_MapDownload_Rows ();
+	qboolean  failed = CL_MapDownload_Failed ();
+
+	p = Draw_CachePic ("gfx/p_multi.lmp");
+	M_DrawPic (cbx, (320 - p->width) / 2, 4, p);
+
+	M_PrintWhite (cbx, 40, 48, "This server needs a map");
+	M_PrintWhite (cbx, 40, 56, "you do not have:");
+	M_Print (cbx, 40, 72, CL_MapDownload_Line1 ());
+	M_Print (cbx, 40, 84, CL_MapDownload_Line2 ());
+
+	M_Mouse_UpdateListCursor (&mapdl_cursor, 40, 320, MAPDL_TOP_Y, CHARACTER_SIZE, rows, 0);
+	if (mapdl_cursor >= rows)
+		mapdl_cursor = rows - 1;
+	if (rows == 2)
+	{
+		M_Print (cbx, MENU_LABEL_X, MAPDL_TOP_Y, "Download");
+		M_Print (cbx, MENU_LABEL_X, MAPDL_TOP_Y + CHARACTER_SIZE, "Cancel");
+	}
+	else
+	{
+		M_Print (cbx, MENU_LABEL_X, MAPDL_TOP_Y, failed ? "Back" : "Cancel");
+	}
+	Draw_Character (cbx, MENU_CURSOR_X, MAPDL_TOP_Y + mapdl_cursor * CHARACTER_SIZE, 12 + ((int)(realtime * 4) & 1));
+}
+
+static void M_MapDownload_Key (int key)
+{
+	const int rows = M_MapDownload_Rows ();
+
+	switch (key)
+	{
+	case K_MOUSE2:
+	case K_ESCAPE:
+	case K_BBUTTON:
+		// Escape is CANCEL in every state, which is what makes this screen safe to
+		// land on: the worst case is exactly overlay 0026's behaviour.
+		S_LocalSound ("misc/menu1.wav");
+		Cbuf_AddText ("mapdl_cancel\n");
+		break;
+
+	case K_DOWNARROW:
+		S_LocalSound ("misc/menu1.wav");
+		if (++mapdl_cursor >= rows)
+			mapdl_cursor = 0;
+		break;
+
+	case K_UPARROW:
+		S_LocalSound ("misc/menu1.wav");
+		if (--mapdl_cursor < 0)
+			mapdl_cursor = rows - 1;
+		break;
+
+	case K_MOUSE1:
+	case K_ENTER:
+	case K_KP_ENTER:
+	case K_ABUTTON:
+		m_entersound = true;
+		if (rows == 2 && mapdl_cursor == 0)
+			Cbuf_AddText ("mapdl_accept\n");
+		else
+			Cbuf_AddText ("mapdl_cancel\n");
+		break;
+
+	default:
+		break;
+	}
+}
