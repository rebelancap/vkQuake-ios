+/*
+==================
+VKQ_VR_ApplyHandInput -- overlay 0019
+
+Runs from CL_AccumulateCmd, right after IN_Move, so the Sense pair contributes
+to the SAME pending command a gamepad does and nothing about the gamepad path
+changes (charter A10's trap-ledger rule: the working path is never replaced by
+its replacement).
+
+Deliberately reads the LATEST published state rather than the frame-latched copy
+the renderer uses: input wants to be as fresh as possible, geometry wants to be
+coherent with the eyes, and those are different requirements.
+==================
+*/
+void VKQ_VR_ApplyHandInput (usercmd_t *cmd)
+{
+	extern cvar_t sv_maxspeed;
+	static double lastTime = 0.0;
+	static int	  snapArmed = 1, cycleArmed = 1;
+	const int	  aim = vkq_vr_aim_hand (), off = vkq_vr_off_hand ();
+	unsigned	  pAim, pOff, rAim, rOff, bAim, bOff;
+	float		  ls[2], rs[2], speed, mx, my, rx, ry;
+	double		  now = Sys_DoubleTime ();
+	float		  dt = (lastTime > 0.0) ? (float)(now - lastTime) : 0.0f;
+	lastTime = now;
+	if (dt > 0.25f)
+		dt = 0.25f;
+
+	if (!vkq_vr_active || !vkq_vr_have)
+		return;
+	// NOTHING BELOW MAY RUN WITH NO HAND TRACKED. It drives in_attack and
+	// in_jump directly, and those are shared with the gamepad, the touch layer
+	// and every bind — so an unconditional "release" here would silently cancel
+	// a gamepad player's trigger every frame. Gamepad-only VR must behave
+	// exactly as it did in R1, and this line is what guarantees it.
+	{
+		int live;
+		pthread_mutex_lock (&vkq_vr_mtx);
+		live = vkq_vr_hand_pub[0].tracked || vkq_vr_hand_pub[1].tracked;
+		pthread_mutex_unlock (&vkq_vr_mtx);
+		if (!live)
+		{
+			if (vkq_vr_owned_buttons)
+			{
+				// We were driving them a moment ago and the controllers have just
+				// gone: release once, then never touch them again (the donors'
+				// release-on-doff rule — a dead battery must not leave the player
+				// firing forever).
+				vkq_vr_owned_buttons = 0;
+				vkq_vr_hold (&in_attack, false);
+				vkq_vr_hold (&in_jump, false);
+			}
+			return;
+		}
+		vkq_vr_owned_buttons = 1;
+	}
+	pAim = vkq_vr_take_edges (aim, &rAim);
+	pOff = vkq_vr_take_edges (off, &rOff);
+	bAim = vkq_vr_buttons_now (aim);
+	bOff = vkq_vr_buttons_now (off);
+	vkq_vr_stick_now (off, ls);
+	vkq_vr_stick_now (aim, rs);
+
+	// The MENU button works everywhere, including in menus — it is the only way
+	// back out of the console without a keyboard.
+	if ((pAim | pOff) & VKQ_VRB_MENU)
+		Cbuf_AddText ("togglemenu\n");
+
+	if (key_dest != key_game)
+	{
+		// In a menu the sticks and the trigger drive the SAME keys the gamepad
+		// path emits, so the panel menus stay drivable with nothing else plumbed.
+		static double repeat = 0.0;
+		int			  k = 0;
+		float		  x = vkq_vr_stick_axis (ls[0]) + vkq_vr_stick_axis (rs[0]);
+		float		  y = vkq_vr_stick_axis (ls[1]) + vkq_vr_stick_axis (rs[1]);
+		if (y > 0.5f)
+			k = K_UPARROW;
+		else if (y < -0.5f)
+			k = K_DOWNARROW;
+		else if (x > 0.5f)
+			k = K_RIGHTARROW;
+		else if (x < -0.5f)
+			k = K_LEFTARROW;
+		if (!k)
+			repeat = 0.0;
+		else if (now >= repeat)
+		{
+			Key_Event (k, true);
+			Key_Event (k, false);
+			repeat = now + (repeat > 0.0 ? 0.15 : 0.4); // one step, then autorepeat
+		}
+		if ((pAim | pOff) & (VKQ_VRB_TRIGGER | VKQ_VRB_A))
+		{
+			Key_Event (K_ENTER, true);
+			Key_Event (K_ENTER, false);
+		}
+		if ((pAim | pOff) & VKQ_VRB_B)
+		{
+			Key_Event (K_ESCAPE, true);
+			Key_Event (K_ESCAPE, false);
+		}
+		// Nothing below this line may reach gameplay while a menu is up.
+		vkq_vr_hold (&in_attack, false);
+		vkq_vr_hold (&in_jump, false);
+		return;
+	}
+
+	// --- gameplay -------------------------------------------------------------
+	// Right trigger fires, left trigger and A jump. Fixed layout, deliberately
+	// not bindable (both donors' ledgers paid for that).
+	vkq_vr_hold (&in_attack, (bAim & VKQ_VRB_TRIGGER) != 0);
+	vkq_vr_hold (&in_jump, ((bOff & VKQ_VRB_TRIGGER) || (bAim & VKQ_VRB_A) || (bOff & VKQ_VRB_A)) != 0);
+	if (pAim & VKQ_VRB_TRIGGER)
+		VKQ_VR_Haptic (aim, 0.7f, 0.04f); // the shot you feel in the hand that fired it
+
+	// Right stick click = recenter (hold-free: nothing else is on that click).
+	if (pAim & VKQ_VRB_STICK)
+	{
+		extern void VKQ_VR_Recenter (void);
+		VKQ_VR_Recenter ();
+		VKQ_VR_Haptic (aim, 0.5f, 0.05f);
+	}
+
+	// MOVE — same units and speed rule as IN_JoyMove, so a Sense stick and a
+	// gamepad stick move the player identically.
+	mx = vkq_vr_stick_axis (ls[0]);
+	my = vkq_vr_stick_axis (ls[1]);
+	if ((in_speed.state & 1) ^ (cl_alwaysrun.value != 0.0 || cl_forwardspeed.value >= sv_maxspeed.value))
+		speed = sv_maxspeed.value;
+	else if (cl_forwardspeed.value >= sv_maxspeed.value)
+		speed = q_min (sv_maxspeed.value, cl_forwardspeed.value / cl_movespeedkey.value);
+	else
+		speed = cl_forwardspeed.value;
+	if (cmd && !cl.paused)
+	{
+		cmd->sidemove += speed * mx;
+		cmd->forwardmove += speed * my;
+	}
+
+	// TURN — written into cl.viewangles[YAW] exactly as the gamepad path does,
+	// because VKQ_VR_ApplyHeadAim absorbs that delta into the BODY yaw. One
+	// mechanism serves stick, gyro, touch and Sense, and snap and smooth differ
+	// only in the size of the step.
+	rx = vkq_vr_stick_axis (rs[0]);
+	ry = vkq_vr_stick_axis (rs[1]);
+	if (!CL_AngleLocked () && !cl.paused)
+	{
+		if (vkqvr_snapturn.value >= 1.0f)
+		{
+			// Hysteresis (QuakeQuest: fire at 0.4, re-arm below 0.3) — without it
+			// a stick held over is a turntable.
+			if (snapArmed && fabsf (rs[0]) > 0.6f)
+			{
+				cl.viewangles[YAW] -= (rs[0] > 0.0f ? 1.0f : -1.0f) * vkqvr_snapturn.value;
+				snapArmed = 0;
+				VKQ_VR_Haptic (aim, 0.4f, 0.03f);
+			}
+			if (fabsf (rs[0]) < 0.4f)
+				snapArmed = 1;
+		}
+		else
+			cl.viewangles[YAW] -= rx * vkqvr_turnspeed.value * dt;
+	}
+
+	// WEAPON CYCLE — a stick FLICK up/down is next/prev, edge-triggered on the
+	// same hysteresis so one flick is one impulse and a held stick is none.
+	if (cycleArmed && fabsf (rs[1]) > 0.6f && fabsf (rs[0]) < 0.5f && !cl.paused)
+	{
+		in_impulse = (rs[1] > 0.0f) ? 10 : 12;
+		cycleArmed = 0;
+		VKQ_VR_Haptic (aim, 0.3f, 0.02f);
+	}
+	if (fabsf (rs[1]) < 0.4f)
+		cycleArmed = 1;
+	(void)ry;
+	(void)rOff;
+	(void)pOff;
+}
+
+// --- movement direction (charter A6) -----------------------------------------
+// NetQuake movement is server-side along the SENT yaw, which hand aim has just
+// made the gun's. Rotating the wish vector client-side by (reference - sent) is
+// therefore the whole of "walk where I'm looking" — two lines of trig and no
+// protocol change (QuakeQuest cl_walkdirection, same identity).
+void VKQ_VR_ApplyMoveDir (usercmd_t *cmd)
+{
+	float  ref, d, s, c, f, side;
+	vec3_t org, fwd, right, up;
+	int	   mode = (int)vkqvr_movedir.value;
+	// Reported as zero whenever no rotation is applied, so the diagnostics line
+	// can never show a stale angle from a previous setting — a measurement that
+	// lies about which mode is live would be worse than no measurement.
+	vkq_vr_movedir_delta = 0.0f;
+	if (!cmd || !vkq_vr_active || !vkq_vr_have || !VKQ_VR_AimHandTracked ())
+		return;
+	if (mode == 1)
+		return; // aim-hand relative: the server already uses the aim yaw
+	if (mode == 2)
+	{
+		if (!vkq_vr_hand_world (vkq_vr_off_hand (), false, org, fwd, right, up))
+			return;
+		ref = (float)(atan2 (fwd[1], fwd[0]) * 180.0 / M_PI);
+	}
+	else
+		ref = vkq_vr_body_yaw + vkq_vr_head_yaw; // head relative (default)
+
+	d = ref - cl.viewangles[YAW];
+	while (d > 180.0f)
+		d -= 360.0f;
+	while (d < -180.0f)
+		d += 360.0f;
+	if (fabsf (d) < 0.05f)
+		return;
+	s = sinf (VKQ_VR_DEG2RAD (d));
+	c = cosf (VKQ_VR_DEG2RAD (d));
+	f = cmd->forwardmove;
+	side = cmd->sidemove;
+	cmd->forwardmove = f * c + side * s;
+	cmd->sidemove = -f * s + side * c;
+	vkq_vr_movedir_delta = d; // diagnostics: the sim asserts this, see VR-R2-NOTES
+}
+
+// --- weapon at the hand (charter A8) -----------------------------------------
+// Per-weapon offsets seeded from QuakeQuest's table (darkplaces/view.c:882-926 —
+// same stock .mdl files, so their units are ours), keyed the same way: on the
+// active weapon's item bit. fwd/right/up are in the GRIPPED hand frame; scale
+// multiplies the model.
+typedef struct
+{
+	int	  item;
+	float fwd, right, up, pitch, scale;
+} vkq_vr_gun_t;
+
+static const vkq_vr_gun_t vkq_vr_guns[] = {
+	{IT_SHOTGUN, -6.0f, 0.0f, 7.0f, -5.0f, 0.65f},		 {IT_SUPER_SHOTGUN, -7.0f, 0.0f, 8.0f, 0.0f, 0.90f},
+	{IT_NAILGUN, -12.0f, 0.0f, 14.0f, 0.0f, 0.50f},		 {IT_SUPER_NAILGUN, -16.0f, 0.0f, 16.0f, 0.0f, 0.40f},
+	{IT_GRENADE_LAUNCHER, -8.0f, 0.0f, 10.0f, 0.0f, 1.0f}, {IT_ROCKET_LAUNCHER, -16.0f, 0.0f, 11.0f, -5.0f, 0.45f},
+	{IT_LIGHTNING, -8.0f, 0.0f, 9.0f, 0.0f, 1.0f},		 {IT_AXE, -22.0f, 12.0f, 28.0f, 0.0f, 0.50f},
+};
+
+static const vkq_vr_gun_t *vkq_vr_gun_entry (void)
+{
+	static const vkq_vr_gun_t def = {0, -6.0f, 0.0f, 7.0f, 0.0f, 1.0f};
+	const int				  w = cl.stats[STAT_ACTIVEWEAPON];
+	size_t					  i;
+	for (i = 0; i < sizeof (vkq_vr_guns) / sizeof (vkq_vr_guns[0]); i++)
+		if (vkq_vr_guns[i].item == w)
+			return &vkq_vr_guns[i];
+	return &def;
+}
+
+// Distance from the grip point to the muzzle, for the laser / flash / beam.
+// Taken as the weapon's own forward offset so it tracks the same table.
+float VKQ_VR_WeaponMuzzle (void)
+{
+	const vkq_vr_gun_t *g = vkq_vr_gun_entry ();
+	return -g->fwd + 8.0f;
+}
+
+/*
+==================
+VKQ_VR_PlaceViewmodel -- overlay 0019
+
+Called at the end of V_CalcRefdef. Returns false when nothing is tracked, and
+V_CalcRefdef's own face-attached placement stands — which is R1's behaviour,
+unchanged, so a build with no controllers is not a build with a new bug.
+==================
+*/
+qboolean VKQ_VR_PlaceViewmodel (entity_t *view)
+{
+	const vkq_vr_gun_t *g;
+	vec3_t				org, fwd, right, up;
+	float				ang[3];
+	if (!vkq_vr_active || !vkq_vr_have || vkqvr_weapon.value < 0.5f)
+		return false;
+	if (!vkq_vr_hand_world (vkq_vr_aim_hand (), true, org, fwd, right, up))
+		return false;
+
+	g = vkq_vr_gun_entry ();
+	// The per-weapon pitch tweak turns the model in the fist; it must not move
+	// the muzzle ray, so it is applied to the ANGLES only.
+	vkq_vr_angles_from_basis (fwd, right, up, ang);
+	VectorMA (org, g->fwd, fwd, org);
+	VectorMA (org, g->right, right, org);
+	VectorMA (org, g->up, up, org);
+
+	VectorCopy (org, view->origin);
+	// Entity pitch is stored backwards from view angles (V_CalcRefdef's own
+	// comment, and what CalcGunAngle does to this same entity).
+	view->angles[PITCH] = -(ang[PITCH] + g->pitch);
+	view->angles[YAW] = ang[YAW];
+	view->angles[ROLL] = ang[ROLL];
+	view->netstate.scale = (byte)ENTSCALE_ENCODE (g->scale * vkqvr_gunscale.value);
+	return true;
+}
+
+/*
+==================
+VKQ_VR_LaserSight -- overlay 0019 (charter A8)
+
+The laser REPLACES the crosshair in VR (the comfort stash already turns the
+crosshair off), and it is the only honest answer to the parallax the charter
+accepts: the shot leaves the player's body along the hand's direction, so a
+2D reticle would lie about near-field aim while the beam cannot.
+
+Client-side only — a trace against the client's own world, no server round trip,
+no progs. Returns false when there is nothing to draw.
+==================
+*/
+/*
+==================
+VKQ_VR_AimDebugString -- overlay 0019
+
+The one line that proves charter A6's decoupling actually happened, rather than
+looking like it did. A screenshot cannot show that the SENT angles came from the
+hand while the RENDER came from the head — they are the same picture either way
+until you turn your head, and by then there is nothing to compare. So the
+numbers go in the file, next to every other VR measurement, and the simulator
+harness asserts on them.
+==================
+*/
+void VKQ_VR_AimDebugString (char *out, int len)
+{
+	float ang[3] = {0, 0, 0};
+	int	  tracked = VKQ_VR_AimHandTracked ();
+	if (!out || len <= 0)
+		return;
+	if (tracked)
+		VKQ_VR_AimAngles (ang);
+	q_snprintf (
+		out, len, "sent=(p%+.1f y%.1f) head=(p%+.1f y%.1f) hand=(p%+.1f y%.1f) body=%.1f handaim=%d movedir=%d delta=%+.1f weapon=%d hands=%d",
+		cl.viewangles[PITCH], anglemod (cl.viewangles[YAW]), vkq_vr_head_pitch, anglemod (vkq_vr_body_yaw + vkq_vr_head_yaw), tracked ? ang[PITCH] : 0.0f,
+		tracked ? anglemod (ang[YAW]) : 0.0f, vkq_vr_body_yaw, tracked, (int)vkqvr_movedir.value, vkq_vr_movedir_delta, cl.stats[STAT_ACTIVEWEAPON],
+		VKQ_VR_HandsTracked ());
+}
+
+qboolean VKQ_VR_LaserSight (vec3_t start, vec3_t end, vec3_t normal)
+{
+	vec3_t far_pt, fwd;
+	if (!vkq_vr_active || !vkq_vr_have || vkqvr_laser.value < 0.5f)
+		return false;
+	if (cl.intermission || cls.demoplayback || cl.stats[STAT_HEALTH] <= 0 || !cl.worldmodel)
+		return false;
+	if (!VKQ_VR_MuzzleWorld (start, fwd))
+		return false;
+	VectorMA (start, 8192.0f, fwd, far_pt);
+	CL_TraceLine (start, far_pt, end, normal, NULL);
+	return true;
+}
+
 #endif
