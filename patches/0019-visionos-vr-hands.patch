+// --- input (charter A10's fixed layout) --------------------------------------
+static float vkq_vr_stick_axis (float v)
+{
+	const float dz = (vkqvr_deadzone.value > 0.0f && vkqvr_deadzone.value < 0.9f) ? vkqvr_deadzone.value : 0.15f;
+	float		a = fabsf (v);
+	if (a <= dz)
+		return 0.0f;
+	a = (a - dz) / (1.0f - dz);
+	a = a * a; // QuakeQuest's quadratic scaler: small movements stay small
+	return (v < 0.0f) ? -a : a;
+}
+
+// A press that the engine has not seen yet. Consuming clears it, so one physical
+// press fires exactly one impulse however the two loop rates line up.
+static unsigned vkq_vr_take_edges (int hand, unsigned *released)
+{
+	unsigned p;
+	pthread_mutex_lock (&vkq_vr_mtx);
+	p = vkq_vr_hand_pub[hand].pressed;
+	if (released)
+		*released = vkq_vr_hand_pub[hand].released;
+	vkq_vr_hand_pub[hand].pressed = 0;
+	vkq_vr_hand_pub[hand].released = 0;
+	pthread_mutex_unlock (&vkq_vr_mtx);
+	return p;
+}
+
+static unsigned vkq_vr_buttons_now (int hand)
+{
+	unsigned b;
+	pthread_mutex_lock (&vkq_vr_mtx);
+	b = vkq_vr_hand_pub[hand].tracked ? vkq_vr_hand_pub[hand].buttons : 0u;
+	pthread_mutex_unlock (&vkq_vr_mtx);
+	return b;
+}
+
+static void vkq_vr_stick_now (int hand, float out[2])
+{
+	pthread_mutex_lock (&vkq_vr_mtx);
+	out[0] = vkq_vr_hand_pub[hand].tracked ? vkq_vr_hand_pub[hand].stick[0] : 0.0f;
+	out[1] = vkq_vr_hand_pub[hand].tracked ? vkq_vr_hand_pub[hand].stick[1] : 0.0f;
+	pthread_mutex_unlock (&vkq_vr_mtx);
+}
+
+// Hold a kbutton_t down/up from a native source. Mirrors what the +cmd/-cmd
+// console commands do to the state bits, which is what makes these buttons
+// behave exactly like a gamepad's for CL_KeyState and CL_FinishMove.
+static void vkq_vr_hold (kbutton_t *b, qboolean down)
+{
+	if (down)
+	{
+		if (!(b->state & 1))
+			b->state |= 1 + 2; // down, and "pressed this frame"
+	}
+	else
+	{
+		if (b->state & 1)
+			b->state = 4; // up, and "released this frame"
+	}
+}
