+The filter asks the native backend — which is looking at the same GCController
+objects and can read `productCategory` — whether THIS SDL device is a spatial
+controller. Matched by SDL's own naming rule (vendorName, falling back to
+productCategory), because SDL exposes no handle back to the GCController and its
+generic MFi VID/PID is shared with every ordinary pad, so the blacklist hint
+cannot separate them.
+
+THE RULE THAT MATTERS (paid for in sm64coopdx 1.1.2.22): this removes NOTHING
+from the working path. Ordinary gamepads are not spatial, the predicate returns
+false for them, and SDL keeps driving them with the player's own binds. If the
+match ever fails, the failure mode is the status quo — SDL adopts a Sense half —
+not a dead gamepad, and the inventory line in the diagnostics file says so.
+================
+*/
+static qboolean IN_VKQIgnoreSpatial (SDL_JoystickID id)
+{
+	extern int	VKQ_Sense_ShouldIgnoreSDLGamepad (const char *name);
+	const char *name = SDL_GetGamepadNameForID (id);
+	if (!name)
+		name = SDL_GetJoystickNameForID (id);
+	if (!name || !VKQ_Sense_ShouldIgnoreSDLGamepad (name))
+		return false;
+	Con_Printf ("VR: leaving spatial controller '%s' to the native backend\n", name);
+	return true;
+}
+#endif
 
