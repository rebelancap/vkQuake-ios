+int VKQ_VR_AimHandTracked (void) { return vkq_vr_active && vkq_vr_have && vkq_vr_hand_cur[vkq_vr_aim_hand ()].tracked; }
+
+// --- player frame -> Quake world ---------------------------------------------
+// The player frame is right-up-back with -Z forward, yawed by the body yaw the
+// render base (VKQ_VR_ComposeView) already rotates by. One conversion, used by
+// aim, the weapon, the laser, the muzzle flash and the beam.
+static void vkq_vr_player_to_world_dir (const float *v, vec3_t out)
+{
+	const float b = VKQ_VR_DEG2RAD (vkq_vr_body_yaw);
+	const float cb = cosf (b), sb = sinf (b);
+	out[0] = v[0] * sb - v[2] * cb;
+	out[1] = -v[0] * cb - v[2] * sb;
+	out[2] = v[1];
+}
+
+// The player frame's origin in Quake world: the body's eye point, i.e. exactly
+// what VKQ_VR_ComposeView translates by.
+static void vkq_vr_player_origin (vec3_t out)
+{
+	out[0] = r_refdef.vieworg[0];
+	out[1] = r_refdef.vieworg[1];
+	out[2] = r_refdef.vieworg[2] + vkq_vr_height_ofs;
+}
+
+// One hand, in Quake world space, with its own basis. `grip` applies the
+// tunable grip rotation (vkqvr_gunpitch/yaw/roll) — the ARKit held-controller
+// frame and a Quake .mdl's frame are two different conventions and nothing
+// guarantees they agree, so that correction is a live setting rather than a
+// constant discovered over several headset rounds.
+static qboolean vkq_vr_hand_world (int hand, qboolean grip, vec3_t org, vec3_t fwd, vec3_t right, vec3_t up)
+{
+	const vkq_vr_hand_t *h;
+	vec3_t				 f, r, u, o;
+	if (hand < 0 || hand > 1 || !vkq_vr_active || !vkq_vr_have)
+		return false;
+	h = &vkq_vr_hand_cur[hand];
+	if (!h->tracked)
+		return false;
+
+	{
+		float back[3] = {-h->back[0], -h->back[1], -h->back[2]}; // -Z is forward
+		vkq_vr_player_to_world_dir (back, f);
+		vkq_vr_player_to_world_dir (h->right, r);
+		vkq_vr_player_to_world_dir (h->up, u);
+	}
+	vkq_vr_player_origin (o);
+	{
+		vec3_t wp;
+		vkq_vr_player_to_world_dir (h->pos, wp); // the same rotation the axes use
+		VectorAdd (o, wp, org);
+	}
+
+	if (grip)
+	{
+		// Rotate the hand basis about its own axes: pitch about right, yaw about
+		// up, roll about forward. Order pitch -> yaw -> roll, so the pitch knob
+		// (the one that matters, and the one QuakeQuest ships at -20) behaves
+		// predictably however the others are set.
+		const float sp = sinf (VKQ_VR_DEG2RAD (vkqvr_gunpitch.value)), cp = cosf (VKQ_VR_DEG2RAD (vkqvr_gunpitch.value));
+		const float sy = sinf (VKQ_VR_DEG2RAD (vkqvr_gunyaw.value)), cy = cosf (VKQ_VR_DEG2RAD (vkqvr_gunyaw.value));
+		const float sr = sinf (VKQ_VR_DEG2RAD (vkqvr_gunroll.value)), cr = cosf (VKQ_VR_DEG2RAD (vkqvr_gunroll.value));
+		vec3_t		nf, nu, nr;
+		int			i;
+		// pitch: forward/up rotate about right (+pitch = nose DOWN, Quake sign)
+		for (i = 0; i < 3; i++)
+		{
+			nf[i] = f[i] * cp - u[i] * sp;
+			nu[i] = f[i] * sp + u[i] * cp;
+		}
+		VectorCopy (nf, f);
+		VectorCopy (nu, u);
+		// yaw: forward/right rotate about up (+yaw = LEFT, Quake sign)
+		for (i = 0; i < 3; i++)
+		{
+			nf[i] = f[i] * cy - r[i] * sy;
+			nr[i] = f[i] * sy + r[i] * cy;
+		}
+		VectorCopy (nf, f);
+		VectorCopy (nr, r);
+		// roll: right/up rotate about forward
+		for (i = 0; i < 3; i++)
+		{
+			nr[i] = r[i] * cr + u[i] * sr;
+			nu[i] = -r[i] * sr + u[i] * cr;
+		}
+		VectorCopy (nr, r);
+		VectorCopy (nu, u);
+		// Global grip offset, in the (already corrected) hand frame.
+		VectorMA (org, vkqvr_gunfwd.value, f, org);
+		VectorMA (org, vkqvr_gunright.value, r, org);
+		VectorMA (org, vkqvr_gunup.value, u, org);
+	}
+	VectorCopy (f, fwd);
+	VectorCopy (r, right);
+	VectorCopy (u, up);
+	return true;
+}
+
+// Quake (pitch, yaw, roll) from an orthonormal basis — the exact inverse of
+// AngleVectors, so a round trip through it is the identity and no sign is
+// guessed. `right` here is AngleVectors' right (which points to the player's
+// right, i.e. -Y at yaw 0).
+static void vkq_vr_angles_from_basis (const vec3_t fwd, const vec3_t right, const vec3_t up, float out[3])
+{
+	float f2 = fwd[2];
+	if (f2 > 1.0f)
+		f2 = 1.0f;
+	if (f2 < -1.0f)
+		f2 = -1.0f;
+	out[YAW] = (float)(atan2 (fwd[1], fwd[0]) * 180.0 / M_PI);
+	out[PITCH] = (float)(-asin (f2) * 180.0 / M_PI);
+	out[ROLL] = (float)(atan2 (-right[2], up[2]) * 180.0 / M_PI);
+}
+
+// The SENT view angles when a hand is aiming. Uses the RAW hand frame, not the
+// gripped one: the grip rotation exists to make the MODEL sit right in the fist
+// and must never move where the shot goes (that is how a "tuning" slider turns
+// into an aiming bug).
+void VKQ_VR_AimAngles (float out[3])
+{
+	vec3_t org, f, r, u;
+	out[0] = vkq_vr_head_pitch;
+	out[1] = anglemod (vkq_vr_body_yaw + vkq_vr_head_yaw);
+	out[2] = 0.0f;
+	if (!vkq_vr_hand_world (vkq_vr_aim_hand (), false, org, f, r, u))
+		return;
+	vkq_vr_angles_from_basis (f, r, u, out);
+	out[ROLL] = 0.0f;
+}
+
+// Where the shot LOOKS like it comes from: the gripped hand frame plus the
+// active weapon's muzzle offset. Used by the laser, the muzzle-flash dlight and
+// the lightning beam so all three agree with the model the player can see.
+qboolean VKQ_VR_MuzzleWorld (vec3_t org, vec3_t fwd)
+{
+	vec3_t r, u;
+	if (!vkq_vr_hand_world (vkq_vr_aim_hand (), true, org, fwd, r, u))
+		return false;
+	VectorMA (org, VKQ_VR_WeaponMuzzle (), fwd, org);
+	return true;
+}
