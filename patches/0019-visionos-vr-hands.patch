+#ifdef VKQ_VISIONOS
 /*
+===============
+R_DrawVRLaser -- vkquake-ios overlay 0019 (VR, charter A8)
+
+The laser sight, drawn through the particle pipeline and the particle texture
+that are already bound, built and validated on this device — a laser is a
+coloured additive billboard, which is exactly what that pipeline draws, so it
+needs no new Vulkan object, no new shader and no `fillModeNonSolid` (Metal has
+no wide lines, so a line-mode beam would be one pixel and would alias badly at
+an eye's resolution).
+
+Two camera-facing quads: a thin ribbon from the muzzle to the impact, and a
+round dot lifted off the surface it hit. The beam's texcoords all sit at the
+texture's centre, which is solid white — so the ribbon is a clean constant
+colour while the dot keeps the texture's soft round falloff.
 ===============
+*/
+static void R_DrawVRLaserGeometry (cb_context_t *cbx)
+{
+	extern qboolean VKQ_VR_LaserSight (vec3_t start, vec3_t end, vec3_t normal);
+	extern cvar_t	vkqvr_laser;
+	vec3_t			start, end, normal, dir, side, up2, a, b;
+	basicvertex_t  *v;
+	VkBuffer		vbuf;
+	VkDeviceSize	voff;
+	float			len, half;
+	int				n = 0, i;
+	const byte		beam_c[4] = {255, 40, 20, 255};
+	const byte		dot_c[4] = {255, 90, 40, 255};
+	const qboolean	want_beam = (vkqvr_laser.value < 1.5f);
+
+	if (!VKQ_VR_LaserSight (start, end, normal))
+		return;
+
+	VectorSubtract (end, start, dir);
+	len = VectorLength (dir);
+	if (len < 1.0f)
+		return;
+	VectorScale (dir, 1.0f / len, dir);
+
+	// Ribbon width: face the viewer by crossing the beam with the eye-to-beam
+	// vector, so it reads as a line from every angle instead of vanishing edge-on.
+	VectorSubtract (start, r_origin, side);
+	CrossProduct (dir, side, up2);
+	if (VectorLength (up2) < 0.001f)
+		VectorCopy (vup, up2);
+	VectorNormalize (up2);
+
+	v = (basicvertex_t *)R_VertexAllocate (12 * sizeof (basicvertex_t), &vbuf, &voff);
+
+#define VKQ_LASER_VERT(P, C)                                                                                                                                 \
+	do                                                                                                                                                       \
+	{                                                                                                                                                        \
+		v[n].position[0] = (P)[0], v[n].position[1] = (P)[1], v[n].position[2] = (P)[2];                                                                      \
+		v[n].texcoord[0] = 0.5f, v[n].texcoord[1] = 0.5f;                                                                                                     \
+		for (i = 0; i < 4; i++)                                                                                                                              \
+			v[n].color[i] = (C)[i];                                                                                                                          \
+		n++;                                                                                                                                                 \
+	} while (0)
+
+	if (want_beam)
+	{
+		// Thickness grows a little with distance so the far end never falls below
+		// a pixel — the same "keep it visible" hack the particles themselves use.
+		half = 0.35f + len * 0.0015f;
+		VectorMA (start, half, up2, a);
+		VectorMA (start, -half, up2, b);
+		VKQ_LASER_VERT (a, beam_c);
+		VKQ_LASER_VERT (b, beam_c);
+		VectorMA (end, -half, up2, a);
+		VKQ_LASER_VERT (a, beam_c);
+		VectorMA (start, half, up2, a);
+		VKQ_LASER_VERT (a, beam_c);
+		VectorMA (end, -half, up2, a);
+		VKQ_LASER_VERT (a, beam_c);
+		VectorMA (end, half, up2, a);
+		VKQ_LASER_VERT (a, beam_c);
+	}
+
+	// The impact dot, nudged off the surface so it does not z-fight the wall.
+	{
+		vec3_t c;
+		float  r = 1.6f + len * 0.004f;
+		VectorMA (end, 0.5f, normal, c);
+		for (i = 0; i < 6; i++)
+		{
+			static const float qx[6] = {-1, 1, 1, -1, 1, -1};
+			static const float qy[6] = {-1, -1, 1, -1, 1, 1};
+			vec3_t			   p;
+			VectorMA (c, qx[i] * r, vright, p);
+			VectorMA (p, qy[i] * r, vup, p);
+			v[n].position[0] = p[0], v[n].position[1] = p[1], v[n].position[2] = p[2];
+			v[n].texcoord[0] = (qx[i] + 1.0f) * 0.5f;
+			v[n].texcoord[1] = (qy[i] + 1.0f) * 0.5f;
+			{
+				int k;
+				for (k = 0; k < 4; k++)
+					v[n].color[k] = dot_c[k];
+			}
+			n++;
+		}
+	}
+#undef VKQ_LASER_VERT
+
+	if (n == 0)
+		return;
+	vulkan_globals.vk_cmd_bind_vertex_buffers (cbx->cb, 0, 1, &vbuf, &voff);
+	vulkan_globals.vk_cmd_draw (cbx->cb, n, 1, 0, 0);
+}
+
+void R_DrawVRLaser (cb_context_t *cbx)
+{
+	extern int vkq_vr_use;
+	if (!vkq_vr_use)
+		return;
+	R_BeginDebugUtilsLabel (cbx, "VR Laser");
+	R_BindPipeline (
+		cbx, VK_PIPELINE_BIND_POINT_GRAPHICS,
+		R_PipelineForRenderPass (
+			cbx->render_pass_index, vulkan_globals.particle_pipeline, vulkan_globals.particle_oit_pipeline, vulkan_globals.particle_mboit_moment_pipeline,
+			vulkan_globals.particle_mboit_composite_pipeline));
+	vulkan_globals.vk_cmd_bind_descriptor_sets (
+		cbx->cb, VK_PIPELINE_BIND_POINT_GRAPHICS, vulkan_globals.basic_pipeline_layout.handle, 0, 1, &particletexture->descriptor_set, 0, NULL);
+	R_DrawVRLaserGeometry (cbx);
+	R_EndDebugUtilsLabel (cbx);
+}
+#endif // VKQ_VISIONOS
+
