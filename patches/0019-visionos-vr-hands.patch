+// ============================================================================
+// vkquake-ios overlay 0019 — R2: Sense controllers, hand aim, weapon at the hand
+// (docs/VR-CHARTER.md A6/A8/A10, docs/VR-R2-NOTES.md).
+//
+// Everything below consumes ONE published per-hand state and derives everything
+// else from it. There is no second transform chain: the shell puts each hand in
+// the Quake PLAYER frame using the same alignment and world scale the eyes go
+// through, and this file turns the player frame into Quake world with the body
+// yaw the render base already uses. A recenter, a world-scale change or a snap
+// turn therefore moves the eyes, the aim, the weapon and the laser together by
+// construction rather than by three matching edits.
+// ============================================================================
+
+// Which hand aims. `vkqvr_aimhand` is 1 for right-handed (the default).
+static int vkq_vr_aim_hand (void) { return vkqvr_aimhand.value < 0.5f ? 0 : 1; }
+static int vkq_vr_off_hand (void) { return vkq_vr_aim_hand () ^ 1; }
+
+// --- shell side: publish one hand --------------------------------------------
+// xform12 is the hand's player-frame pose as right[3], up[3], back[3], pos[3]
+// (position in QUAKE UNITS). Button EDGES are accumulated here, under the lock,
+// rather than sampled by the engine: the shell publishes at the compositor's
+// rate and the engine consumes at its own, so a fast tap between two engine
+// frames would otherwise be lost entirely.
+void VKQ_VR_PublishHand (
+	int hand, int tracked, int held, const float *xform12, const float *vel3, unsigned buttons, float trigger, float grip, float stick_x, float stick_y)
+{
+	vkq_vr_hand_t *h;
+	unsigned	   prev;
+	if (hand < 0 || hand > 1)
+		return;
+	pthread_mutex_lock (&vkq_vr_mtx);
+	h = &vkq_vr_hand_pub[hand];
+	prev = h->buttons;
+	if (!tracked)
+	{
+		// Tracking loss releases everything (donor rule, charter A7's
+		// release-on-doff applied one phase early): a battery dying mid-fire must
+		// not leave +attack latched, and a frozen pose is worse than none.
+		h->released |= prev;
+		h->buttons = 0;
+		h->tracked = 0;
+		h->held = 0;
+		h->trigger = h->grip = 0.0f;
+		h->stick[0] = h->stick[1] = 0.0f;
+		pthread_mutex_unlock (&vkq_vr_mtx);
+		return;
+	}
+	h->tracked = 1;
+	h->held = held ? 1 : 0;
+	memcpy (h->right, xform12 + 0, 3 * sizeof (float));
+	memcpy (h->up, xform12 + 3, 3 * sizeof (float));
+	memcpy (h->back, xform12 + 6, 3 * sizeof (float));
+	memcpy (h->pos, xform12 + 9, 3 * sizeof (float));
+	if (vel3)
+		memcpy (h->vel, vel3, 3 * sizeof (float));
+	h->pressed |= (buttons & ~prev);
+	h->released |= (prev & ~buttons);
+	h->buttons = buttons;
+	h->trigger = trigger;
+	h->grip = grip;
+	h->stick[0] = stick_x;
+	h->stick[1] = stick_y;
+	pthread_mutex_unlock (&vkq_vr_mtx);
+}
+
+// Are any hands live at all? Drives the settings status row and the "did the
+// declaration work" question the device round has to answer from the file.
+int VKQ_VR_HandsTracked (void)
+{
+	int n;
+	pthread_mutex_lock (&vkq_vr_mtx);
+	n = (vkq_vr_hand_pub[0].tracked ? 1 : 0) + (vkq_vr_hand_pub[1].tracked ? 1 : 0);
+	pthread_mutex_unlock (&vkq_vr_mtx);
+	return n;
+}
