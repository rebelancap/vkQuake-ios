+// cl_moddl.c -- vkquake-ios overlay 0034: fetch the MOD CONTENT a server needs.
+//
+// ============================================================================
+// WHY THIS EXISTS
+//
+// Overlay 0028 fetches a missing maps/*.bsp. Joining a public MOD server
+// (Team Fortress, Threewave CTF, AirQuake, Copper coop...) still failed on the
+// first custom MODEL with "install that mod's folder next to id1". In NetQuake
+// the mod's progs run on the server; the client needs only the files in the
+// precache lists, so this is the same per-file problem as a map, one level up.
+//
+// SOURCES, tried in this order:
+//
+//  1. The SERVER'S OWN download URL. FTE advertises it as the serverinfo key
+//     sv_dlURL (alias of DarkPlaces' sv_curl_defaulturl), and an FTE client
+//     fetches <url>/<gamedir>/<path> per file (fteqw engine/client/cl_parse.c,
+//     CL_CheckOrEnqueDownloadFile). NetQuake clients only see serverinfo in-band
+//     via a `fullserverinfo` stufftext sent during prespawn — AFTER
+//     svc_serverinfo, i.e. after this check has already killed the connection —
+//     so it is read out of band with a `getstatus` to the same address.
+//     Survey 2026-11-03: none of the 38 public servers that answer getstatus set
+//     it. It is implemented because it is the convention, it costs one UDP
+//     round trip, and it is the only source a server operator controls.
+//  2. A CURATED TABLE (mods/mod-sources.json): package URL + sha256 + the exact
+//     file list of each package, written by downloading the package and listing
+//     it. A package is offered only if it contains EVERY missing model. The copy
+//     in the repository is fetched first so a dead link can be fixed without a
+//     release; the copy in the app bundle is the fallback.
+//
+// Missing maps found along the way are added to the same plan from 0028's bare
+// .bsp mirror, so a Team Fortress join is ONE prompt for the mod and its map.
+//
+// WHAT IS DELIBERATELY NOT HERE
+//  - Arbitrary server-chosen archives. Source 1 fetches individual precache
+//    files only, each validated by magic number; archives come only from the
+//    curated table, sha256-pinned.
+//  - Executable config. Nothing ending in .cfg/.rc is ever installed, loose or
+//    inside a .pak — `game <mod>` execs quake.rc/autoexec.cfg from the search
+//    path, and a download must not be able to rebind the player's keys.
+//  - Overwriting. Every placement refuses an existing file; a .pak lands in the
+//    next free pakN.pak slot.
+// ============================================================================
+
+#include "quakedef.h"
+#include "q_ctype.h"
+
+#ifdef VKQ_IOS
+
+#include <sys/stat.h>
+#include <dirent.h>
