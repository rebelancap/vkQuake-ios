+	int			nitems, cur;
+	qboolean	probing_first; // PROBE: still deciding the server URL layout
+	long long	plantotal, donebytes, got;
+	char		tmpfile[MAX_OSPATH];
+	char		reason[128];
+	int			job;
+	int			frames; // MOD_SWITCH countdown
+} mod;
+
+static char mod_tried[MOD_MAX_TRIED][256]; // "<target>|<hash of the missing set>" offered this session
+static int	mod_tried_count;
+static char mod_switched[MOD_MAX_TRIED][256]; // targets we already switched game for
+static int	mod_switched_count;
+
+static qboolean mod_in_list (char list[][256], int n, const char *s)
+{
+	int i;
+	for (i = 0; i < n; i++)
+		if (!q_strcasecmp (list[i], s))
+			return true;
+	return false;
+}
+
+static void mod_add_list (char list[][256], int *n, const char *s)
+{
+	if (*n < MOD_MAX_TRIED && !mod_in_list (list, *n, s))
+		q_strlcpy (list[(*n)++], s, 256);
+}
+
+// The retry guard is keyed on the server AND what it is missing: a server that
+// changes map after an install can need content the first package did not have
+// (FortressOne's pak has no progs/tpad.mdl, which 2nuke2 uses), and that new set
+// deserves one attempt of its own. The same set twice still stops — that is a
+// package that did not deliver, and retrying it would loop.
+static void mod_tried_key (char *out, size_t len, const char *target, const char *missing)
+{
+	unsigned int h = 2166136261u; // FNV-1a over the case-folded missing list
+	const char	*p;
+	for (p = missing; *p; p++)
+	{
+		h ^= (unsigned char)q_tolower (*p);
+		h *= 16777619u;
+	}
+	q_snprintf (out, len, "%s|%08x", target, h);
+}
+
+// Forget every attempt recorded for this server (all of its missing sets).
+static void mod_forget_tried (const char *target)
+{
+	size_t tl = strlen (target);
+	int	   i;
+	for (i = 0; i < mod_tried_count;)
+		if (!q_strncasecmp (mod_tried[i], target, tl) && mod_tried[i][tl] == '|')
+		{
+			memmove (mod_tried[i], mod_tried[i + 1], (mod_tried_count - i - 1) * sizeof (mod_tried[0]));
+			mod_tried_count--;
+		}
+		else
+			i++;
+}
+
+// ---------------------------------------------------------------------------
+// helpers
+// ---------------------------------------------------------------------------
+static void mod_job_release (void)
+{
+	if (mod.job)
+	{
+		VKQ_DL_Free (mod.job);
+		mod.job = 0;
+	}
+}
+
+static void mod_stage_dir (char *out, size_t len)
+{
+	q_snprintf (out, len, "%s/.moddl", com_basedir);
+}
+
+static void mod_stage_clear (void)
+{
+	char d[MAX_OSPATH];
+	mod_stage_dir (d, sizeof (d));
+	VKQ_DL_RemoveStaging (d);
+}
+
+static void mod_fail (const char *fmt, ...)
+{
+	va_list argptr;
+	char	string[128];
+
+	va_start (argptr, fmt);
+	q_vsnprintf (string, sizeof (string), fmt, argptr);
+	va_end (argptr);
+
+	mod_job_release ();
+	mod.tmpfile[0] = 0;
+	mod_stage_clear ();
+	q_strlcpy (mod.reason, string, sizeof (mod.reason));
+	mod.state = MOD_FAILED;
+	Con_Printf ("moddl: FAILED — %s\n", string);
+}
+
+static qboolean mod_url_ok (const char *url)
+{
+	if (!q_strncasecmp (url, "https://", 8))
+		return true;
+	return cl_mapdownload_allowhttp.value >= 0.5f && !q_strncasecmp (url, "http://", 7);
+}
+
+static void mod_host_of (const char *url, char *out, size_t len)
+{
+	const char *p = strstr (url, "://");
+	const char *e;
+	size_t		n;
+
+	p = p ? p + 3 : url;
+	e = strchr (p, '/');
+	n = e ? (size_t)(e - p) : strlen (p);
+	if (n >= len)
+		n = len - 1;
+	memcpy (out, p, n);
+	out[n] = 0;
+}
+
+static void mod_join_url (char *out, size_t len, const char *base, const char *tail)
+{
+	size_t n = strlen (base);
+	q_snprintf (out, len, (n && base[n - 1] == '/') ? "%s%s" : "%s/%s", base, tail);
+}
+
+/*
+ * A game directory NAME, nothing else: [A-Za-z0-9_-], 1..31 chars, and not one
+ * of the base directories (installing "mod content" into id1 under the name of
+ * a mod is exactly the pollution this file avoids). Servers send the gamedir as
+ * a ';' list ("id1;fortress", FTE also adds "qw"); the last real component is
+ * the mod. Anything that is not a plain name — CRMod reports "CRMod 7
+ * (v1.26.11)" as its modname — is treated as unknown.
+ */
+static void mod_sanitize_gamedir (const char *in, char *out, size_t len)
+{
+	char		tmp[256], *tok, *save = NULL;
+	const char *c;
+
+	out[0] = 0;
+	if (!in || !*in)
+		return;
+	q_strlcpy (tmp, in, sizeof (tmp));
+	for (tok = strtok_r (tmp, ";", &save); tok; tok = strtok_r (NULL, ";", &save))
+	{
+		if (!q_strcasecmp (tok, GAMENAME) || !q_strcasecmp (tok, "qw") || !*tok || strlen (tok) > 31)
+			continue;
+		for (c = tok; *c; c++)
+			if (!((*c >= 'a' && *c <= 'z') || (*c >= 'A' && *c <= 'Z') || (*c >= '0' && *c <= '9') || *c == '_' || *c == '-'))
+				break;
+		if (*c)
+			continue;
+		q_strlcpy (out, tok, len);
+	}
+}
+
+/*
+ * A relative game path we are willing to WRITE: plain characters, no absolute,
+ * no "..", no hidden components, a short whitelist of content extensions.
+ * Server-chosen strings (precache names) and table-chosen strings (install
+ * rules) both pass through here before they become a filesystem path.
+ */
+static qboolean mod_relpath_ok (const char *p)
+{
+	static const char *exts[] = {"mdl", "spr", "bsp", "lit", "wav", "ogg", "mp3", "lmp", "pcx", "tga", "png", "wad", "loc", "pak", NULL};
+	const char		  *s, *ext;
+	int				   i;
+
+	if (!p || !*p || strlen (p) >= MAX_QPATH || *p == '/' || strstr (p, "..") || strstr (p, "//") || strstr (p, "/."))
+		return false;
+	if (*p == '.')
+		return false;
+	for (s = p; *s; s++)
+		if (!((*s >= 'a' && *s <= 'z') || (*s >= 'A' && *s <= 'Z') || (*s >= '0' && *s <= '9') || *s == '_' || *s == '-' || *s == '.' || *s == '/' ||
+			  *s == '+'))
+			return false;
+	ext = COM_FileGetExtension (p);
+	for (i = 0; exts[i]; i++)
+		if (!q_strcasecmp (ext, exts[i]))
+			return true;
+	return false;
+}
+
+// The first bytes of a downloaded file must be what its extension says it is:
+// this is what stops an HTML error page (or anything else) from landing under a
+// name the engine will later parse as a model.
+static qboolean mod_magic_ok (const char *path, const char *gamepath, char *why, size_t whylen)
+{
+	FILE		 *f = fopen (path, "rb");
+	unsigned char h[4];
+	const char	 *ext = COM_FileGetExtension (gamepath);
+
+	if (!f)
+	{
+		q_strlcpy (why, "cannot read the downloaded file", whylen);
+		return false;
+	}
+	if (fread (h, 1, 4, f) != 4)
+	{
+		fclose (f);
+		q_snprintf (why, whylen, "%s is too small", gamepath);
+		return false;
+	}
+	fclose (f);
+	if (!q_strcasecmp (ext, "bsp"))
+	{
+		unsigned int v = (unsigned int)h[0] | ((unsigned int)h[1] << 8) | ((unsigned int)h[2] << 16) | ((unsigned int)h[3] << 24);
+		if (v == 29 || !memcmp (h, "BSP2", 4) || !memcmp (h, "2PSB", 4))
+			return true;
+	}
+	else if (!q_strcasecmp (ext, "mdl"))
+	{
+		if (!memcmp (h, "IDPO", 4) || !memcmp (h, "MD16", 4))
+			return true;
+	}
+	else if (!q_strcasecmp (ext, "spr"))
+	{
+		if (!memcmp (h, "IDSP", 4))
+			return true;
+	}
+	else if (!q_strcasecmp (ext, "wav"))
+	{
+		if (!memcmp (h, "RIFF", 4))
+			return true;
+	}
+	else if (!q_strcasecmp (ext, "ogg"))
+	{
+		if (!memcmp (h, "OggS", 4))
+			return true;
+	}
+	else if (!q_strcasecmp (ext, "lit"))
+	{
+		if (!memcmp (h, "QLIT", 4))
+			return true;
+	}
+	else if (!q_strcasecmp (ext, "pak"))
+	{
+		if (!memcmp (h, "PACK", 4))
+			return true;
+	}
+	else
+		return true; // lmp/pcx/tga/... have no reliable magic; the path rules still apply
+	q_snprintf (why, whylen, "%s is not a valid .%s (%02x%02x%02x%02x)", gamepath, ext, h[0], h[1], h[2], h[3]);
+	return false;
+}
+
+/*
+ * Validate a .pak before it goes anywhere the engine will mount it: a sane
+ * directory, entry names that are plain relative paths, and NO .cfg/.rc entry
+ * (a pak's quake.rc/autoexec.cfg would run on `game <mod>`).
+ */
+static qboolean mod_pak_ok (const char *path, char *why, size_t whylen)
+{
+	FILE		 *f = fopen (path, "rb");
+	unsigned char hdr[12];
+	int			  dirofs, dirlen, n, i;
+	long		  fsize;
+
+	if (!f)
+	{
+		q_strlcpy (why, "cannot read the package", whylen);
+		return false;
+	}
+	fseek (f, 0, SEEK_END);
+	fsize = ftell (f);
+	fseek (f, 0, SEEK_SET);
+	if (fread (hdr, 1, 12, f) != 12 || memcmp (hdr, "PACK", 4))
+	{
+		fclose (f);
+		q_strlcpy (why, "not a Quake .pak", whylen);
+		return false;
+	}
+	dirofs = hdr[4] | (hdr[5] << 8) | (hdr[6] << 16) | (hdr[7] << 24);
+	dirlen = hdr[8] | (hdr[9] << 8) | (hdr[10] << 16) | (hdr[11] << 24);
+	n = dirlen / 64;
+	if (dirofs < 12 || dirlen < 64 || dirlen % 64 || (long)dirofs + dirlen > fsize || n > 65536)
+	{
+		fclose (f);
+		q_strlcpy (why, "the .pak directory is malformed", whylen);
+		return false;
+	}
+	fseek (f, dirofs, SEEK_SET);
+	for (i = 0; i < n; i++)
+	{
+		unsigned char e[64];
+		char		  name[57];
+		const char	 *ext;
+		if (fread (e, 1, 64, f) != 64)
+		{
+			fclose (f);
+			q_strlcpy (why, "the .pak directory is truncated", whylen);
+			return false;
+		}
+		memcpy (name, e, 56);
+		name[56] = 0;
+		ext = COM_FileGetExtension (name);
+		if (!name[0] || name[0] == '/' || name[0] == '\\' || strstr (name, "..") || strchr (name, ':'))
+		{
+			fclose (f);
+			q_snprintf (why, whylen, "the .pak has an unsafe entry \"%.40s\"", name);
+			return false;
+		}
+		if (!q_strcasecmp (ext, "cfg") || !q_strcasecmp (ext, "rc"))
+		{
+			fclose (f);
+			q_snprintf (why, whylen, "the .pak carries config \"%.40s\"", name);
+			return false;
+		}
+	}
+	fclose (f);
+	return true;
+}
+
+static void mod_mkparents (const char *root, const char *full)
+{
+	char   tmp[MAX_OSPATH];
+	char  *p;
+	size_t rootlen = strlen (root);
+
+	q_strlcpy (tmp, full, sizeof (tmp));
+	for (p = tmp + rootlen + 1; *p; p++)
+	{
+		if (*p != '/')
+			continue;
+		*p = 0;
+		Sys_mkdir (tmp);
+		*p = '/';
+	}
+}
+
+static qboolean mod_same_file (const char *a, const char *b)
+{
+	FILE	*fa = fopen (a, "rb"), *fb = fopen (b, "rb");
+	qboolean same = (fa && fb);
+	char	 ba[8192], bb[8192];
+	size_t	 na, nb;
+
+	while (same)
+	{
+		na = fread (ba, 1, sizeof (ba), fa);
+		nb = fread (bb, 1, sizeof (bb), fb);
+		if (na != nb || memcmp (ba, bb, na))
+			same = false;
+		if (!na)
+			break;
+	}
+	if (fa)
+		fclose (fa);
+	if (fb)
+		fclose (fb);
+	return same;
+}
+
+// The directory content is installed into.
+static void mod_install_root (char *out, size_t len)
+{
+	if (mod.gamedir[0])
+		q_snprintf (out, len, "%s/%s", com_basedir, mod.gamedir);
+	else
+		q_strlcpy (out, com_gamedir, len);
+	Sys_mkdir (out);
+}
+
+// Place a validated .pak in the next free pakN.pak slot. An identical pak that
+// is already installed is not added twice (a retried install, or the player's
+// own copy of the same release).
+static qboolean mod_place_pak (const char *src)
+{
+	char root[MAX_OSPATH], dest[MAX_OSPATH], why[128];
+	int	 i;
+
+	if (!mod_pak_ok (src, why, sizeof (why)))
+	{
+		mod_fail ("%s", why);
+		return false;
+	}
+	mod_install_root (root, sizeof (root));
+	for (i = 0; i < 64; i++)
+	{
+		q_snprintf (dest, sizeof (dest), "%s/pak%i.pak", root, i);
+		if (!(Sys_FileType (dest) & FS_ENT_FILE))
+			break;
+		if (mod_same_file (src, dest))
+		{
+			Con_Printf ("moddl: pak%i.pak is already this package — not adding it twice\n", i);
+			return true;
+		}
+	}
+	if (i == 64)
+	{
+		mod_fail ("no free pak slot in %s", root);
+		return false;
+	}
+	if (rename (src, dest) != 0)
+	{
+		mod_fail ("could not move the package into %s", root);
+		return false;
+	}
+	Con_Printf ("moddl: installed %s/pak%i.pak\n", mod.gamedir[0] ? mod.gamedir : COM_SkipPath (com_gamedir), i);
+	return true;
+}
+
+// Place one loose file under the install root. Never overwrites. Does not end
+// the flow on its own: the caller decides whether a bad file is fatal (a model)
+// or skippable (a sound), so the reason comes back in `why`.
+static qboolean mod_place_file (const char *src, const char *gamepath, char *why, size_t whylen)
+{
+	char root[MAX_OSPATH], dest[MAX_OSPATH];
+
+	if (!mod_relpath_ok (gamepath))
+	{
+		q_snprintf (why, whylen, "refusing unsafe path \"%.48s\"", gamepath);
+		remove (src);
+		return false;
+	}
+	if (!mod_magic_ok (src, gamepath, why, whylen))
+	{
+		remove (src);
+		return false;
+	}
+	mod_install_root (root, sizeof (root));
+	q_snprintf (dest, sizeof (dest), "%s/%s", root, gamepath);
+	if (Sys_FileType (dest) & FS_ENT_FILE)
+	{
+		Con_Printf ("moddl: skip (exists) %s\n", gamepath);
+		remove (src);
+		return true;
+	}
+	mod_mkparents (root, dest);
+	if (rename (src, dest) != 0)
+	{
+		q_snprintf (why, whylen, "could not install %s", gamepath);
+		remove (src);
+		return false;
+	}
+	Con_DPrintf ("moddl: installed %s\n", gamepath);
+	return true;
+}
+
+// Does a usable copy of this mod already exist on disk (in any content root)?
+static qboolean mod_local_has (const char *gd)
+{
+	char p[MAX_OSPATH];
+	int	 i;
+	for (i = 0; i < com_numbasedirs; i++)
+	{
+		q_snprintf (p, sizeof (p), "%s/%s/pak0.pak", com_basedirs[i], gd);
+		if (Sys_FileType (p) & FS_ENT_FILE)
+			return true;
+		q_snprintf (p, sizeof (p), "%s/%s/progs.dat", com_basedirs[i], gd);
+		if (Sys_FileType (p) & FS_ENT_FILE)
+			return true;
+		q_snprintf (p, sizeof (p), "%s/%s/progs", com_basedirs[i], gd);
+		if (Sys_FileType (p) & FS_ENT_DIRECTORY)
+			return true;
+	}
+	return false;
+}
+
+static qboolean mod_needs_switch (void)
+{
+	return mod.gamedir[0] && !COM_GameDirMatches (mod.gamedir);
+}
+
+// ---------------------------------------------------------------------------
+// rejoin
+// ---------------------------------------------------------------------------
+static void mod_rejoin (void)
+{
+	mod_job_release ();
+	mod.tmpfile[0] = 0;
+	mod_stage_clear ();
+	if (!mod.target[0])
+	{
+		Con_Printf ("moddl: installed, but there is no server address to rejoin\n");
+		mod.state = MOD_IDLE;
+		key_dest = key_menu;
+		m_state = m_main;
+		return;
+	}
+	if (mod_needs_switch ())
+	{
+		/*
+		 * `game` FIRST, `connect` on a later frame. COM_SwitchGame appends
+		 * "exec quake.rc" and "vid_unlock" to the command buffer; a connect queued
+		 * in the same breath would run BEFORE them, inside the VID_Lock window and
+		 * ahead of the new game's configs. Two frames is the buffer draining.
+		 */
+		Con_Printf ("moddl: switching to game \"%s\" to rejoin\n", mod.gamedir);
+		Cbuf_AddText (va ("game \"%s\"\n", mod.gamedir));
+		mod.state = MOD_SWITCH;
+		mod.frames = 2;
+		return;
+	}
+	Con_Printf ("moddl: rejoining %s\n", mod.target);
+	IN_Activate ();
+	key_dest = key_game;
+	m_state = m_none;
+	Cbuf_AddText (va ("connect \"%s\"\n", mod.target));
+	mod.state = MOD_RECONNECT;
+}
+
+// ---------------------------------------------------------------------------
+// planning
+// ---------------------------------------------------------------------------
+static int mod_add_item (const char *path, const char *url, mod_kind_t kind, qboolean optional)
+{
+	mod_item_t *it;
+	if (mod.nitems >= MOD_MAX_ITEMS)
+		return -1;
+	it = &mod.items[mod.nitems];
+	memset (it, 0, sizeof (*it));
+	q_strlcpy (it->path, path, sizeof (it->path));
+	q_strlcpy (it->url, url, sizeof (it->url));
+	it->kind = kind;
+	it->optional = optional;
+	it->size = -1;
+	return mod.nitems++;
+}
+
+static void mod_remove_item (int i)
+{
+	memmove (&mod.items[i], &mod.items[i + 1], (mod.nitems - i - 1) * sizeof (mod.items[0]));
+	mod.nitems--;
+}
+
+static void mod_server_url_for (char *out, size_t len, const char *path)
+{
+	if (mod.layout == 0 && mod.servergd[0])
+		mod_join_url (out, len, mod.dlurl, va ("%s/%s", mod.servergd, path));
+	else
+		mod_join_url (out, len, mod.dlurl, path);
+}
+
+static void mod_begin_table (void);
+static void mod_to_prompt (void);
+
+// Start (or continue) the HEAD probe over the plan. Every item gets a size, so
+// the prompt can state a real total.
+static void mod_probe_next (void)
+{
+	mod_job_release ();
+	while (mod.cur < mod.nitems && mod.items[mod.cur].kind == ITEM_PKG)
+		mod.cur++;
+	if (mod.cur >= mod.nitems)
+	{
+		mod_to_prompt ();
+		return;
+	}
+	mod.job = VKQ_DL_StartHead (mod.items[mod.cur].url);
+	if (!mod.job)
+	{
+		mod_fail ("could not start a probe");
+		return;
+	}
+	mod.state = MOD_PROBE;
+}
+
+// Source 1: the server's download URL. Plan every missing file under it.
+static void mod_begin_server (void)
+{
+	const char *p = mod.missing;
+	char		line[MAX_QPATH], url[512];
+	int			first = -1;
+
+	// A URL with no usable game directory would install SERVER-CHOSEN files
+	// straight into the base game (com_gamedir = id1 here). Never do that: the
+	// curated table names its own folder for whatever it matches.
+	if (!mod.servergd[0])
+	{
+		Con_Printf ("moddl: the server advertises a download URL but names no mod folder; not installing into %s, trying the mod table\n",
+			COM_SkipPath (com_gamedir));
+		mod_begin_table ();
+		return;
+	}
+	mod.nitems = 0;
+	mod.source = 1;
+	mod.layout = 0;
+	while (*p)
+	{
+		const char *e = strchr (p, '\n');
+		size_t		n = e ? (size_t)(e - p) : strlen (p);
+		if (n && n < sizeof (line))
+		{
+			memcpy (line, p, n);
+			line[n] = 0;
+			if (mod_relpath_ok (line))
+			{
+				qboolean ismodel = q_strncasecmp (line, "sound/", 6) && q_strncasecmp (line, "maps/", 5);
+				int		 idx;
+				mod_server_url_for (url, sizeof (url), line);
+				idx = mod_add_item (line, url, ITEM_FILE, !ismodel);
+				if (ismodel && first < 0)
+					first = idx;
+			}
+		}
+		p = e ? e + 1 : p + n;
+	}
+	if (first < 0)
+	{
+		mod_begin_table ();
+		return;
+	}
+	// Probe the first MODEL first: it decides the URL layout before the rest is
+	// probed (FTE's own form is <url>/<gamedir>/<path>; a bare <url>/<path> is
+	// the fallback for servers that host the tree flat).
+	if (first != 0)
+	{
+		mod_item_t t = mod.items[0];
+		mod.items[0] = mod.items[first];
+		mod.items[first] = t;
+	}
+	q_strlcpy (mod.gamedir, mod.servergd, sizeof (mod.gamedir));
+	mod_host_of (mod.dlurl, mod.srcname, sizeof (mod.srcname));
+	q_snprintf (mod.title, sizeof (mod.title), "%s (from the server)", mod.servergd[0] ? mod.servergd : "mod content");
+	mod.probing_first = true;
+	mod.cur = 0;
+	Con_Printf ("moddl: server advertises a download URL (%s); probing %s\n", mod.dlurl, mod.items[0].url);
+	mod_probe_next ();
+}
+
+// Source 2: the curated table. Fetch the live copy (it may be newer than the
+// bundled one), then resolve against whichever parses.
+static void mod_table_cache_path (char *out, size_t len, qboolean part)
+{
+	q_snprintf (out, len, "%s/mod-sources.json%s", VKQ_DL_CachesPath (), part ? ".part" : "");
+}
+
+static void mod_begin_resolve (void)
+{
+	char cached[MAX_OSPATH];
+	mod_job_release ();
+	mod_table_cache_path (cached, sizeof (cached), false);
+	mod.job = VKQ_DL_StartModResolve (cached, VKQ_DL_BundledModTablePath (), mod.missing, mod.servergd);
+	if (!mod.job)
+	{
+		mod_fail ("could not read the mod table");
+		return;
+	}
+	mod.state = MOD_RESOLVE;
+}
+
+static void mod_begin_table (void)
+{
+	char part[MAX_OSPATH];
+
+	mod_job_release ();
+	mod.nitems = 0;
+	mod.source = 2;
+	q_strlcpy (mod.srcname, "the mod table", sizeof (mod.srcname));
+	if (!VKQ_DL_CachesPath ()[0] || !mod_url_ok (cl_moddownload_tableurl.string))
+	{
+		Con_Printf ("moddl: not refreshing the mod table (no cache dir, or the URL is not https)\n");
+		mod_begin_resolve ();
+		return;
+	}
+	mod_table_cache_path (part, sizeof (part), true);
+	remove (part);
+	q_strlcpy (mod.tmpfile, part, sizeof (mod.tmpfile));
+	mod.job = VKQ_DL_StartGetMax (cl_moddownload_tableurl.string, part, 1024 * 1024);
+	if (!mod.job)
+	{
+		mod.tmpfile[0] = 0;
+		mod_begin_resolve ();
+		return;
+	}
+	mod.state = MOD_TABLE;
+	Con_Printf ("moddl: refreshing the mod table from %s\n", cl_moddownload_tableurl.string);
+}
+
+// After a source is chosen: add the missing maps from 0028's mirror, then probe.
+static void mod_add_maps_and_probe (void)
+{
+	const char *p = mod.missing;
+	char		line[MAX_QPATH], url[512];
+
+	while (*p)
+	{
+		const char *e = strchr (p, '\n');
+		size_t		n = e ? (size_t)(e - p) : strlen (p);
+		if (n && n < sizeof (line))
+		{
+			memcpy (line, p, n);
+			line[n] = 0;
+			if (!q_strncasecmp (line, "maps/", 5) && mod_relpath_ok (line))
+			{
+				mod_join_url (url, sizeof (url), cl_mapdownload_bspurl.string, COM_SkipPath (line));
+				if (mod_url_ok (url))
+					mod_add_item (line, url, ITEM_MAP, true);
+			}
+		}
+		p = e ? e + 1 : p + n;
+	}
+	mod.cur = 0;
+	mod.probing_first = false;
+	mod_probe_next ();
+}
+
+static void mod_to_prompt (void)
+{
+	int i;
+	mod_job_release ();
+	mod.plantotal = 0;
+	{
+		// The prompt names where the bytes come from; a plan that spans hosts
+		// (a mod package plus its map from the map mirror) says so.
+		char first[64], h[64];
+		int	 others = 0;
+		first[0] = 0;
+		for (i = 0; i < mod.nitems; i++)
+		{
+			if (mod.items[i].size > 0)
+				mod.plantotal += mod.items[i].size;
+			mod_host_of (mod.items[i].url, h, sizeof (h));
+			if (!first[0])
+				q_strlcpy (first, h, sizeof (first));
+			else if (q_strcasecmp (first, h))
+				others++;
+		}
+		if (first[0])
+			q_snprintf (mod.srcname, sizeof (mod.srcname), others ? "%s and more" : "%s", first);
+	}
+	if ((double)mod.plantotal > cl_mapdownload_maxpkg.value * 1024.0 * 1024.0)
+	{
+		mod_fail ("%.0f MB is over the %.0f MB limit", (double)mod.plantotal / 1048576.0, cl_mapdownload_maxpkg.value);
+		return;
+	}
+	Con_Printf (
+		"moddl: plan — %d item(s), %lld bytes, from %s, into %s\n", mod.nitems, mod.plantotal, mod.srcname,
+		mod.gamedir[0] ? mod.gamedir : COM_SkipPath (com_gamedir));
+	mod.state = MOD_PROMPT;
+	if (cl_mapdownload.value >= 1.5f)
+		CL_ModDownload_Accept ();
+}
+
+// Switch to a copy of the mod the player already has, instead of downloading.
+static qboolean mod_try_local_switch (const char *gd)
+{
+	if (!gd[0] || COM_GameDirMatches (gd) || !mod_local_has (gd) || mod_in_list (mod_switched, mod_switched_count, mod.target))
+		return false;
+	mod_add_list (mod_switched, &mod_switched_count, mod.target);
+	// A switch is not a download: let a later attempt on this server still offer one.
+	mod_forget_tried (mod.target);
+	q_strlcpy (mod.gamedir, gd, sizeof (mod.gamedir));
+	Con_Printf ("moddl: you already have \"%s\" — switching to it and rejoining\n", gd);
+	q_snprintf (mod.title, sizeof (mod.title), "%s", gd);
+	if (m_state != m_mapdl)
+		M_Menu_MapDownload_f (); // "Rejoining..." on screen while the game switches
+	mod_rejoin ();
+	return true;
+}
+
+// ---------------------------------------------------------------------------
+// download / install
+// ---------------------------------------------------------------------------
+static void mod_begin_get (void)
+{
+	char		stage[MAX_OSPATH];
+	mod_item_t *it;
+	long long	cap;
+
+	mod_job_release ();
+	if (mod.cur >= mod.nitems)
+	{
+		mod_rejoin ();
+		return;
+	}
+	it = &mod.items[mod.cur];
+	mod_stage_dir (stage, sizeof (stage));
+	Sys_mkdir (stage);
+	q_snprintf (mod.tmpfile, sizeof (mod.tmpfile), "%s/%d.part", stage, mod.cur);
+	remove (mod.tmpfile);
+	cap = (long long)((it->kind == ITEM_PKG ? cl_mapdownload_maxpkg.value : cl_mapdownload_maxbsp.value) * 1024.0 * 1024.0);
+	mod.job = VKQ_DL_StartGetMax (it->url, mod.tmpfile, cap);
+	if (!mod.job)
+	{
+		mod_fail ("could not start the download");
+		return;
+	}
+	mod.got = 0;
+	mod.state = MOD_GET;
+	Con_Printf ("moddl: downloading %s\n", it->url);
+}
+
+// The package install: a .pak goes in as-is; a .zip is extracted into the
+// staging tree (COM_UnzipToDir refuses traversal) and ONLY the files its install
+// rules name are moved out of it.
+static qboolean mod_install_pkg (const char *file, const mod_pkg_t *pkg)
+{
+	char rules[512], *rule, *save = NULL;
+	char stage[MAX_OSPATH], xdir[MAX_OSPATH], src[MAX_OSPATH], err[128];
+
+	if (!q_strcasecmp (pkg->type, "pak"))
+		return mod_place_pak (file);
+	if (!q_strcasecmp (pkg->type, "file"))
+	{
+		// One loose file (a map's model): the download IS the file, and its one
+		// install rule names the game path. mod_place_file checks the path and the
+		// magic number and never overwrites.
+		char why[128];
+		const char *as = strchr (pkg->install, '>');
+		if (pkg->install[0] != '>' || !as || !as[1] || strchr (as + 1, ';'))
+		{
+			mod_fail ("a \"file\" package needs exactly one install rule");
+			return false;
+		}
+		if (!mod_place_file (file, as + 1, why, sizeof (why)))
+		{
+			mod_fail ("%s", why);
+			return false;
+		}
+		Con_Printf ("moddl: installed %s/%s\n", mod.gamedir[0] ? mod.gamedir : COM_SkipPath (com_gamedir), as + 1);
+		return true;
+	}
+	if (q_strcasecmp (pkg->type, "zip"))
+	{
+		mod_fail ("unknown package type \"%s\"", pkg->type);
+		return false;
+	}
+	mod_stage_dir (stage, sizeof (stage));
+	q_snprintf (xdir, sizeof (xdir), "%s/x", stage);
+	Sys_mkdir (xdir);
+	// Cap what the archive may unpack to (a zip bomb would otherwise fill the
+	// device): 4x the download limit. The curated zips unpack to 2.4-3.1x their
+	// download size (Copper 12.7 MB, AirQuake 13.4 MB, Threewave 9.3 MB) — far
+	// under 4 x the 512 MB default.
+	if (COM_UnzipToDirMax (file, xdir, stage, (long long)(cl_mapdownload_maxpkg.value * 4.0 * 1024.0 * 1024.0), err, sizeof (err)) < 0)
+	{
+		mod_fail ("%s", err);
+		return false;
+	}
+	q_strlcpy (rules, pkg->install, sizeof (rules));
+	for (rule = strtok_r (rules, ";", &save); rule; rule = strtok_r (NULL, ";", &save))
+	{
+		char *as = strchr (rule, '>');
+		if (!as)
+			continue;
+		*as++ = 0;
+		// `from` is a path inside the archive: same rules as anything we write.
+		if (!mod_relpath_ok (rule))
+		{
+			mod_fail ("install rule names an unsafe path \"%.40s\"", rule);
+			return false;
+		}
+		q_snprintf (src, sizeof (src), "%s/%s", xdir, rule);
+		if (!(Sys_FileType (src) & FS_ENT_FILE))
+		{
+			mod_fail ("the package has no %.48s", rule);
+			return false;
+		}
+		if (!strcmp (as, "pak"))
+		{
+			if (!mod_place_pak (src))
+				return false;
+		}
+		else
+		{
+			char why[128];
+			if (!mod_place_file (src, as, why, sizeof (why)))
+			{
+				mod_fail ("%s", why);
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+static void mod_do_install (void)
+{
+	char file[MAX_OSPATH];
+	q_strlcpy (file, mod.tmpfile, sizeof (file));
+	mod.tmpfile[0] = 0;
+	if (!mod_install_pkg (file, &mod.pkgs[mod.items[mod.cur].pkg]))
+		return;
+	remove (file);
+	mod.cur++;
+	mod_begin_get ();
+}
+
+// ---------------------------------------------------------------------------
+// per-frame pump (host.c, next to 0028's)
+// ---------------------------------------------------------------------------
+void CL_ModDownload_Frame (void)
+{
+	long long got = 0, total = 0;
+	int		  status = 0, r;
+
+	switch (mod.state)
+	{
+	case MOD_IDLE:
+	case MOD_PROMPT:
+	case MOD_FAILED:
+		return;
+	case MOD_INSTALL:
+		mod_do_install ();
+		return;
+	case MOD_SWITCH:
+		if (--mod.frames > 0)
+			return;
+		Con_Printf ("moddl: rejoining %s\n", mod.target);
+		IN_Activate ();
+		key_dest = key_game;
+		m_state = m_none;
+		Cbuf_AddText (va ("connect \"%s\"\n", mod.target));
+		mod.state = MOD_RECONNECT;
+		return;
+	case MOD_RECONNECT:
+		// Same reason as 0028: back to idle on the very next frame, so a
+		// changelevel into more missing content can start a fresh flow.
+		memset (&mod, 0, sizeof (mod));
+		mod.state = MOD_IDLE;
+		return;
+	default:
+		break;
+	}
+
+	if (!mod.job)
+	{
+		mod_fail ("internal: no job");
+		return;
+	}
+	r = VKQ_DL_Poll (mod.job, &got, &total, &status);
+	mod.got = got;
+	if (r == DLP_RUNNING)
+		return;
+
+	switch (mod.state)
+	{
+	case MOD_STATUS:
+	{
+		char		gd[64];
+		const char *u = "";
+		if (r == DLP_DONE)
+		{
+			mod_sanitize_gamedir (VKQ_DL_Result (mod.job, "modname"), gd, sizeof (gd));
+			if (!mod.servergd[0] && gd[0])
+			{
+				q_strlcpy (mod.servergd, gd, sizeof (mod.servergd));
+				Con_Printf ("moddl: server reports mod \"%s\"\n", gd);
+			}
+			u = VKQ_DL_Result (mod.job, "sv_dlurl");
+			if (!*u)
+				u = VKQ_DL_Result (mod.job, "sv_curl_defaulturl");
+			q_strlcpy (mod.dlurl, u, sizeof (mod.dlurl));
+		}
+		else
+			Con_Printf ("moddl: status query: %s\n", VKQ_DL_Error (mod.job));
+		mod_job_release ();
+		if (mod_try_local_switch (mod.servergd))
+			return;
+		if (mod.dlurl[0] && !mod_url_ok (mod.dlurl))
+		{
+			Con_Printf ("moddl: ignoring the server's download URL (not https): %s\n", mod.dlurl);
+			mod.dlurl[0] = 0;
+		}
+		if (mod.dlurl[0])
+			mod_begin_server ();
+		else
+			mod_begin_table ();
+		return;
+	}
+
+	case MOD_PROBE:
+	{
+		mod_item_t *it = &mod.items[mod.cur];
+		qboolean	ok = (r == DLP_DONE && status == 200);
+		if (ok)
+		{
+			it->size = total > 0 ? total : 0;
+			if ((double)it->size > cl_mapdownload_maxbsp.value * 1024.0 * 1024.0)
+			{
+				mod_fail ("%s is %.0f MB (limit %.0f MB)", it->path, (double)it->size / 1048576.0, cl_mapdownload_maxbsp.value);
+				return;
+			}
+			if (mod.probing_first)
+			{
+				char url[512];
+				int	 i;
+				mod.probing_first = false;
+				// Layout decided: rewrite every server URL in the plan to match.
+				for (i = 0; i < mod.nitems; i++)
+					if (mod.items[i].kind == ITEM_FILE)
+					{
+						mod_server_url_for (url, sizeof (url), mod.items[i].path);
+						q_strlcpy (mod.items[i].url, url, sizeof (mod.items[i].url));
+					}
+				Con_Printf ("moddl: server URL layout: %s\n", mod.layout == 0 ? "<url>/<gamedir>/<path>" : "<url>/<path>");
+			}
+			mod.cur++;
+			mod_probe_next ();
+			return;
+		}
+		if (mod.probing_first && mod.layout == 0)
+		{
+			// Not under <gamedir>/; try the flat layout once.
+			mod.layout = 1;
+			mod_server_url_for (it->url, sizeof (it->url), it->path);
+			mod_probe_next ();
+			return;
+		}
+		if (it->optional)
+		{
+			Con_Printf ("moddl: %s not available (http %d) — skipping it\n", it->path, status);
+			mod_remove_item (mod.cur);
+			mod_probe_next ();
+			return;
+		}
+		// A required model is not on the server's URL: that source cannot finish
+		// the job, so fall through to the curated table with a clean plan.
+		Con_Printf ("moddl: the server's URL lacks %s (http %d) — trying the mod table\n", it->path, status);
+		mod.dlurl[0] = 0;
+		mod.gamedir[0] = 0;
+		mod_begin_table ();
+		return;
+	}
+
+	case MOD_TABLE:
+	{
+		char part[MAX_OSPATH], cached[MAX_OSPATH];
+		mod_table_cache_path (part, sizeof (part), true);
+		mod_table_cache_path (cached, sizeof (cached), false);
+		if (r == DLP_DONE && status == 200 && got > 0)
+		{
+			rename (part, cached);
+			Con_Printf ("moddl: mod table refreshed (%lld bytes)\n", got);
+		}
+		else
+		{
+			remove (part);
+			Con_Printf ("moddl: mod table refresh failed (%s) — using the cached or bundled copy\n", VKQ_DL_Error (mod.job));
+		}
+		mod.tmpfile[0] = 0;
+		mod_begin_resolve ();
+		return;
+	}
+
+	case MOD_RESOLVE:
+	{
+		char gd[64];
+		if (r != DLP_DONE)
+		{
+			Con_Printf ("moddl: mod table: %s\n", VKQ_DL_Error (mod.job));
+			mod_fail (mod.servergd[0] ? "no known download for mod \"%.32s\"" : "no known download for this mod", mod.servergd);
+			return;
+		}
+		// Package 0 under the plain keys; any further packages the resolver had to
+		// combine (same gamedir) under "<key>.<n>". VKQ_DL_Result returns one static
+		// buffer, so every value is copied before the next call.
+		{
+			int n = atoi (VKQ_DL_Result (mod.job, "count")), k;
+			if (n < 1)
+				n = 1;
+			if (n > MOD_MAX_PKGS)
+				n = MOD_MAX_PKGS;
+			mod.npkgs = n;
+			for (k = 0; k < n; k++)
+			{
+				mod_pkg_t  *pk = &mod.pkgs[k];
+				const char *sfx = k ? va (".%d", k) : "";
+				q_strlcpy (pk->url, VKQ_DL_Result (mod.job, va ("url%s", sfx)), sizeof (pk->url));
+				q_strlcpy (pk->sha, VKQ_DL_Result (mod.job, va ("sha256%s", sfx)), sizeof (pk->sha));
+				q_strlcpy (pk->type, VKQ_DL_Result (mod.job, va ("type%s", sfx)), sizeof (pk->type));
+				q_strlcpy (pk->install, VKQ_DL_Result (mod.job, va ("install%s", sfx)), sizeof (pk->install));
+				q_strlcpy (pk->name, VKQ_DL_Result (mod.job, va ("name%s", sfx)), sizeof (pk->name));
+				pk->bytes = strtoll (VKQ_DL_Result (mod.job, va ("bytes%s", sfx)), NULL, 10);
+			}
+		}
+		q_strlcpy (mod.title, mod.pkgs[0].name, sizeof (mod.title));
+		// Install where the SERVER says the mod lives when the match was on its
+		// gamedir; otherwise into the table's directory for the package.
+		if (!strcmp (VKQ_DL_Result (mod.job, "rank"), "gamedir") && mod.servergd[0])
+			q_strlcpy (gd, mod.servergd, sizeof (gd));
+		else
+			mod_sanitize_gamedir (VKQ_DL_Result (mod.job, "gamedir"), gd, sizeof (gd));
+		{
+			// VKQ_DL_Result returns one static buffer: copy before the next call.
+			char which[16], rank[16];
+			q_strlcpy (which, VKQ_DL_Result (mod.job, "table"), sizeof (which));
+			q_strlcpy (rank, VKQ_DL_Result (mod.job, "rank"), sizeof (rank));
+			int	 k;
+			for (k = 0; k < mod.npkgs; k++)
+				Con_Printf (
+					"moddl: %s table matched \"%s\" by %s (%lld bytes) -> %s\n", which, mod.pkgs[k].name, rank, mod.pkgs[k].bytes, gd[0] ? gd : "?");
+		}
+		mod_job_release ();
+		if (!gd[0])
+		{
+			mod_fail ("the mod table entry has no usable game directory");
+			return;
+		}
+		{
+			int k;
+			for (k = 0; k < mod.npkgs; k++)
+			{
+				if (!mod_url_ok (mod.pkgs[k].url))
+				{
+					mod_fail ("the mod table entry has no usable https download");
+					return;
+				}
+				if (!mod.pkgs[k].sha[0])
+				{
+					// Curated entries are pinned by hash; an entry without one is a table bug.
+					mod_fail ("the mod table entry carries no sha256");
+					return;
+				}
+			}
+		}
+		if (mod_try_local_switch (gd))
+			return;
+		q_strlcpy (mod.gamedir, gd, sizeof (mod.gamedir));
+		mod.nitems = 0;
+		{
+			int k;
+			for (k = 0; k < mod.npkgs; k++)
+			{
+				int i = mod_add_item ("", mod.pkgs[k].url, ITEM_PKG, false);
+				if (i < 0)
+					break;
+				mod.items[i].size = mod.pkgs[k].bytes;
+				mod.items[i].pkg = k;
+			}
+		}
+		mod_host_of (mod.pkgs[0].url, mod.srcname, sizeof (mod.srcname));
+		mod_add_maps_and_probe ();
+		return;
+	}
+
+	case MOD_GET:
+	{
+		mod_item_t *it = &mod.items[mod.cur];
+		if (r != DLP_DONE || status != 200)
+		{
+			if (it->optional && it->kind != ITEM_PKG)
+			{
+				Con_Printf ("moddl: %s failed (%s) — continuing without it\n", it->path, VKQ_DL_Error (mod.job));
+				mod_job_release ();
+				remove (mod.tmpfile);
+				mod.tmpfile[0] = 0;
+				mod.cur++;
+				mod_begin_get ();
+				return;
+			}
+			mod_fail ("download failed (%s)", VKQ_DL_Error (mod.job));
+			return;
+		}
+		mod_job_release ();
+		mod.donebytes += got;
+		if (it->kind == ITEM_PKG)
+		{
+			mod.job = VKQ_DL_StartSha256 (mod.tmpfile);
+			if (!mod.job)
+			{
+				mod_fail ("could not hash the package");
+				return;
+			}
+			mod.state = MOD_HASH;
+			return;
+		}
+		{
+			char tmp[MAX_OSPATH], why[128];
+			q_strlcpy (tmp, mod.tmpfile, sizeof (tmp));
+			mod.tmpfile[0] = 0;
+			if (!mod_place_file (tmp, it->path, why, sizeof (why)))
+			{
+				if (!it->optional)
+				{
+					mod_fail ("%s", why);
+					return;
+				}
+				Con_Warning ("moddl: rejected %s — %s (skipping it)\n", it->path, why);
+			}
+		}
+		mod.cur++;
+		mod_begin_get ();
+		return;
+	}
+
+	case MOD_HASH:
+	{
+		const char		*h = (r == DLP_DONE) ? VKQ_DL_Result (mod.job, "sha256") : "";
+		const mod_pkg_t *pk = &mod.pkgs[mod.items[mod.cur].pkg];
+		if (r != DLP_DONE || !h || q_strcasecmp (h, pk->sha))
+		{
+			mod_fail ("package sha256 mismatch — refusing to install");
+			return;
+		}
+		mod_job_release ();
+		Con_Printf ("moddl: sha256 verified (%.16s...)\n", pk->sha);
+		mod.state = MOD_INSTALL;
+		return;
+	}
+
+	default:
+		break;
+	}
+}
+
+// ---------------------------------------------------------------------------
+// entry point: CL_ParseServerInfo, when at least one NON-MAP model is missing.
+// `missing` is every missing precache as a game path, newline-separated
+// (progs/x.mdl, maps/x.bsp, sound/x.wav). Returns true if this flow took over
+// (the caller still tears the connection down).
+// ---------------------------------------------------------------------------
+qboolean CL_ModDownload_Begin (const char *missing, int nmodels, const char *servergamedir, const char *target)
+{
+	if (cl_mapdownload.value < 0.5f)
+	{
+		Con_Printf ("moddl: cl_mapdownload is 0 — not offering to download mod content\n");
+		return false;
+	}
+	if (mod.state != MOD_IDLE && mod.state != MOD_FAILED)
+	{
+		Con_Printf ("moddl: a download is already in progress\n");
+		return false;
+	}
+	if (CL_MapDownload_State () != 0 && !CL_MapDownload_Failed ())
+		return false;
+	if (!target || !*target || !q_strcasecmp (target, "local"))
+		return false;
+
+	memset (&mod, 0, sizeof (mod));
+	q_strlcpy (mod.target, target, sizeof (mod.target));
+	q_strlcpy (mod.missing, missing, sizeof (mod.missing));
+	mod.nmodels = nmodels;
+	mod_sanitize_gamedir (servergamedir, mod.servergd, sizeof (mod.servergd));
+	q_snprintf (mod.title, sizeof (mod.title), "%s", mod.servergd[0] ? mod.servergd : "mod content");
+	q_strlcpy (mod.srcname, "checking...", sizeof (mod.srcname));
+
+	// The server named its mod and we already have it: switching to it is not a
+	// download, so it is offered even on a server we already fetched for (that is
+	// exactly the "came back from the menu in id1" case). mod_switched keeps it
+	// to once per server, so a mod folder that is still short cannot loop.
+	if (mod_try_local_switch (mod.servergd))
+		return true;
+	{
+		char key[256];
+		mod_tried_key (key, sizeof (key), target, missing);
+		if (mod_in_list (mod_tried, mod_tried_count, key) || mod_tried_count >= MOD_MAX_TRIED)
+		{
+			// We already installed (or were refused) content for exactly this
+			// missing set on this server, and it is STILL short. Retrying would
+			// loop; say what is wrong. (A NEW set — the server changed map — is a
+			// fresh attempt; MOD_MAX_TRIED bounds how many a session gets.)
+			Con_Printf ("moddl: already tried to fetch these files for %s this session — not retrying\n", target);
+			Con_Printf ("moddl: no known download provides them; install the mod's full content to join\n");
+			memset (&mod, 0, sizeof (mod));
+			return false;
+		}
+		mod_add_list (mod_tried, &mod_tried_count, key);
+	}
+	mod_stage_clear ();
+
+	Con_Printf ("moddl: %d model(s) missing for %s; asking the server what it offers\n", nmodels, mod.servergd[0] ? mod.servergd : "this server");
+	mod.job = VKQ_DL_StartStatus (target, 26000);
+	if (mod.job)
+		mod.state = MOD_STATUS;
+	else
+	{
+		// No queryable address: go straight to the table.
+		if (mod_try_local_switch (mod.servergd))
+			return true;
+		mod_begin_table ();
+	}
+	M_Menu_MapDownload_f ();
+	return true;
+}
+
+// ---------------------------------------------------------------------------
+// menu-facing accessors
+// ---------------------------------------------------------------------------
+qboolean CL_ModDownload_Active (void) { return mod.state != MOD_IDLE; }
+qboolean CL_ModDownload_Prompting (void) { return mod.state == MOD_PROMPT; }
+qboolean CL_ModDownload_Failed (void) { return mod.state == MOD_FAILED; }
+
+const char *CL_ModDownload_Line1 (void)
+{
+	static char buf[64];
+	q_snprintf (buf, sizeof (buf), "%.34s", mod.title);
+	return buf;
+}
+
+const char *CL_ModDownload_Line2 (void)
+{
+	static char buf[80];
+	switch (mod.state)
+	{
+	case MOD_STATUS:
+		q_snprintf (buf, sizeof (buf), "Asking the server...");
+		break;
+	case MOD_TABLE:
+	case MOD_RESOLVE:
+		q_snprintf (buf, sizeof (buf), "Looking for it online...");
+		break;
+	case MOD_PROBE:
+		q_snprintf (buf, sizeof (buf), "Checking %d file(s)...", mod.nitems);
+		break;
+	case MOD_PROMPT:
+		q_snprintf (buf, sizeof (buf), "%.1f MB from %.28s", (double)mod.plantotal / 1048576.0, mod.srcname);
+		break;
+	case MOD_GET:
+		if (mod.plantotal > 0)
+			q_snprintf (
+				buf, sizeof (buf), "Downloading %lld / %lld KB (%d%%)", (mod.donebytes + mod.got) / 1024, mod.plantotal / 1024,
+				(int)((mod.donebytes + mod.got) * 100 / mod.plantotal));
+		else
+			q_snprintf (buf, sizeof (buf), "Downloading %lld KB", (mod.donebytes + mod.got) / 1024);
+		break;
+	case MOD_HASH:
+		q_snprintf (buf, sizeof (buf), "Verifying...");
+		break;
+	case MOD_INSTALL:
+		q_snprintf (buf, sizeof (buf), "Installing...");
+		break;
+	case MOD_SWITCH:
+	case MOD_RECONNECT:
+		q_snprintf (buf, sizeof (buf), "Rejoining...");
+		break;
+	case MOD_FAILED:
+		q_strlcpy (buf, mod.reason, sizeof (buf));
+		break;
+	default:
+		buf[0] = 0;
+		break;
+	}
+	return buf;
+}
+
+void CL_ModDownload_Accept (void)
+{
+	if (mod.state != MOD_PROMPT)
+		return;
+	mod.cur = 0;
+	mod.donebytes = 0;
+	mod_begin_get ();
+}
+
+void CL_ModDownload_Cancel (void)
+{
+	if (mod.state == MOD_IDLE)
+		return;
+	mod_job_release ();
+	mod_stage_clear ();
+	{
+		char part[MAX_OSPATH];
+		mod_table_cache_path (part, sizeof (part), true);
+		remove (part);
+	}
+	// An explicit "no" is not a failed attempt: joining again should ask again.
+	if (mod.state == MOD_PROMPT || mod.state == MOD_FAILED)
+		mod_forget_tried (mod.target);
+	Con_Printf ("moddl: cancelled\n");
+	memset (&mod, 0, sizeof (mod));
+	mod.state = MOD_IDLE;
+}
+
+static void CL_ModDownload_Accept_f (void)
+{
+	if (mod.state != MOD_PROMPT)
+	{
+		Con_Printf ("moddl: nothing to accept\n");
+		return;
+	}
+	Con_Printf ("moddl: accepted\n");
+	CL_ModDownload_Accept ();
+}
+
+static void CL_ModDownload_Cancel_f (void)
+{
+	CL_ModDownload_Cancel ();
+	key_dest = key_menu;
+	m_state = m_main;
+	IN_Deactivate (true);
+}
+
+static void CL_ModDownload_Status_f (void)
+{
+	static const char *names[] = {"idle", "status", "probe", "table", "resolve", "prompt", "get", "hash", "install", "switch", "reconnect", "failed"};
+	Con_Printf (
+		"moddl status: state=%s title=%s gamedir=%s source=%d items=%d cur=%d total=%lld target=%s reason=%s\n", names[mod.state],
+		mod.title[0] ? mod.title : "-", mod.gamedir[0] ? mod.gamedir : "-", mod.source, mod.nitems, mod.cur, mod.plantotal,
+		mod.target[0] ? mod.target : "-", mod.reason[0] ? mod.reason : "-");
+}
+
+void CL_ModDownload_Init (void)
+{
+	Cvar_RegisterVariable (&cl_moddownload_tableurl);
+	Cmd_AddCommand ("moddl_accept", CL_ModDownload_Accept_f);
+	Cmd_AddCommand ("moddl_cancel", CL_ModDownload_Cancel_f);
+	Cmd_AddCommand ("moddl_status", CL_ModDownload_Status_f);
+}
