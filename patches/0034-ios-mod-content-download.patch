+ * vkquake-ios (issue #8): the server answered with a protocol vkQuake has no
+ * parser for -- in practice DarkPlaces (DP7 = 3504), whose servers accept a
+ * NetQuake connect and only then say what they speak. Upstream raises a
+ * Host_Error, which on a phone is a wall of stack trace for what is simply "this
+ * server is not for this client". Say that in one line, put the reason on the
+ * join screen (like 0033's CCREP_REJECT path in cl_main.c) and end the game
+ * cleanly. Demo playback keeps upstream's error.
+ */
+static void CL_RefuseServerProtocol (int version)
+{
+	extern enum m_state_e m_return_state;
+	extern char			 m_return_reason[32];
+	char				 line[128];
+	int					 dp = 0;
+
+	if (version >= 3500 && version <= 3504)
+		dp = version - 3497; // DP3..DP7
+	else if (version == 96 || version == 97)
+		dp = version - 95; // DP1, DP2
+	if (dp)
+	{
+		q_snprintf (line, sizeof (line), "This server uses the DarkPlaces protocol (%i), which vkQuake cannot join.", dp);
+		q_strlcpy (m_return_reason, "DarkPlaces protocol: can't join", sizeof (m_return_reason));
+	}
+	else
+	{
+		q_snprintf (line, sizeof (line), "This server uses protocol %i, which vkQuake cannot join.", version);
+		q_snprintf (m_return_reason, sizeof (m_return_reason), "Unsupported protocol %i", version);
+	}
+	Con_Printf ("\n%s\n", line);
+	key_dest = key_menu;
+	m_state = (m_return_state == m_slist || m_return_state == m_lanconfig) ? m_return_state : m_main;
+	IN_Deactivate (true);
+	// Host_Connect_f raised the loading plaque; with it up nothing (the menu
+	// included) is drawn until its 60 s "load failed" timeout.
+	SCR_EndLoadingPlaque ();
+	// A join leaves the demo loop for good; without this, Host_EndGame would start
+	// the next attract demo over the menu when the loop was armed (+connect at
+	// launch runs before quake.rc's startdemos).
+	cls.demonum = -1;
+	Host_EndGame ("%s\n", line);
+}
