+
+typedef enum
+{
+	MOD_IDLE = 0,
+	MOD_STATUS,	   // getstatus in flight (server download URL, modname)
+	MOD_PROBE,	   // HEAD per planned file (server URL files, or the map mirror)
+	MOD_TABLE,	   // fetching the live mod table
+	MOD_RESOLVE,   // matching the missing models against the table
+	MOD_PROMPT,	   // waiting for the player
+	MOD_GET,	   // downloading plan item `cur`
+	MOD_HASH,	   // sha256 of the package
+	MOD_INSTALL,   // place files (synchronous, its own frame)
+	MOD_SWITCH,	   // `game <mod>` issued; connect follows on a later frame
+	MOD_RECONNECT, // connect issued
+	MOD_FAILED
+} mod_state_t;
+
+typedef enum
+{
+	ITEM_FILE = 0, // one precache file from the server's download URL
+	ITEM_PKG,	   // a curated package (mod.pkgs[item.pkg])
+	ITEM_MAP	   // a missing map from 0028's bare-.bsp mirror
+} mod_kind_t;
+
+#define MOD_MAX_ITEMS	 384
+#define MOD_MISSING_SIZE 16384
+#define MOD_MAX_TRIED	 16
+#define MOD_MAX_PKGS	 8 // curated packages one plan may combine (same gamedir)
+
+typedef struct
+{
+	char	   path[MAX_QPATH]; // game path (progs/x.mdl, sound/x.wav, maps/x.bsp); "" for a package
+	char	   url[512];
+	long long  size;
+	mod_kind_t kind;
+	qboolean   optional; // a sound: dropped (not fatal) when the source lacks it
+	int		   pkg;		 // ITEM_PKG: index into mod.pkgs
+} mod_item_t;
+
+// One curated package. A plan usually has one; when no single table entry has
+// every missing model, the resolver may combine several entries for the SAME
+// game directory (the mod's main pak plus a loose map model, say).
+typedef struct
+{
+	char	  url[512], sha[80], type[8], install[512], name[64];
+	long long bytes;
+} mod_pkg_t;
+
+static struct
