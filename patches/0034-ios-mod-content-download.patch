+	char		title[64];	   // line 1 of the screen
+	char		srcname[64];   // host the bytes come from
+	char		dlurl[256];	   // server-advertised base URL (source 1)
+	int			layout;		   // 0 = <dlurl>/<gamedir>/<path>, 1 = <dlurl>/<path>
+	int			source;		   // 1 = server URL, 2 = curated table
+	char		missing[MOD_MISSING_SIZE]; // newline-separated game paths
+	int			nmodels;	   // missing non-map models (the fatal ones)
