+/*
+ * vkquake-ios (issue #8): svc_time is a 32-bit float. A server whose map has run
+ * for weeks (an empty server never changes level) sends a time whose float
+ * granularity is coarse: >= 2^21 s (24 days) it is 0.25 s, >= 2^22 s 0.5 s. Every
+ * update in between repeats the same time, so CL_LerpPoint pins cl.time to it and
+ * everything clocked by cl.time -- sky scroll, entity lerp, view bob -- steps at
+ * 2-4 Hz while the renderer runs at 120 fps. Measured on "CSH NetQuake"
+ * (svc_time 2568646.5, 4 distinct times per second).
+ *
+ * Rebuild the missing fraction from our own clock: carry the previous server time
+ * forward by the local time since that packet, and keep it inside the rounding
+ * interval of the float the server actually sent. Fine-grained times (anything a
+ * map younger than ~36 hours produces, ulp < 1/64 s) and all demo playback pass
+ * through untouched.
+ */
+static double cl_svctime_realtime; // realtime at which the server time last advanced
+
+static double CL_ServerTimeFromWire (float sent)
+{
+	const double t = sent;
+	const double half = ((double)nextafterf (sent, INFINITY) - t) * 0.5;
+	const double prev = cl.mtime[0];
+	const double elapsed = realtime - cl_svctime_realtime;
+	double		 est;
 
+	if (half < (0.5 / 64.0) || cls.demoplayback || cls.timedemo || prev <= 0.0 || elapsed > 1.0)
+	{
+		cl_svctime_realtime = realtime;
+		return t; // fine-grained (or no history): exactly as upstream
+	}
+	if (elapsed <= 0.0)
+		return prev; // another packet in the same client frame (split update)
+	cl_svctime_realtime = realtime;
+	est = prev + elapsed;
+	// the server's real clock lies within the rounding interval of what it sent
+	return CLAMP (t - half, est, t + half);
+}
