+/*
+==================
+VKQ_VR_UpdateHolsters -- overlay 0020
+
+One call per input frame, from VKQ_VR_ApplyHandInput, AFTER the fixed layout has
+had its say — grips carry no other meaning, so nothing here can collide with
+fire, jump, turn or cycle. B is deliberately still free (the wheel wants it).
+
+Convenience (default): hand in a zone + grip TAP -> that zone's impulse. Nothing
+else changes and the weapon never leaves the hand.
+
+Immersive: the aim hand's grip IS the hand. Press in a zone draws that zone's
+weapon; press in empty space re-draws the last stowed one; release stows (axe).
+
+Either style: holding the grip inside a zone for vkqvr_grip_hold seconds
+ASSIGNS the weapon currently in hand to that zone, with a double haptic. That is
+one gesture, unambiguous in both styles, and it cannot be confused with a tap.
+==================
+*/
+static void VKQ_VR_UpdateHolsters (double now)
+{
+	const int aim = vkq_vr_aim_hand ();
+	int		  hand;
+	float	  on = (vkqvr_grip_on.value > 0.05f && vkqvr_grip_on.value < 1.0f) ? vkqvr_grip_on.value : 0.65f;
+	float	  off = (vkqvr_grip_off.value > 0.0f && vkqvr_grip_off.value < on) ? vkqvr_grip_off.value : 0.35f;
+
+	if (vkqvr_zones.value < 0.5f)
+	{
+		vkq_vr_grip_release_all ("holsters disabled");
+		return;
+	}
+
+	for (hand = 0; hand < 2; hand++)
+	{
+		vkq_vr_grip_t *g = &vkq_vr_grip[hand];
+		float		   grip, pos[3];
+		int			   tracked, zone;
+		// ONE locked read per hand per frame: tracking, grip and position all
+		// from the same publish, so a zone test can never mix this frame's
+		// position with last frame's grip.
+		pthread_mutex_lock (&vkq_vr_mtx);
+		tracked = vkq_vr_hand_pub[hand].tracked;
+		grip = tracked ? vkq_vr_hand_pub[hand].grip : 0.0f;
+		// The digital grip bit counts too: a controller that reports the button
+		// but no analog travel must not be a hand that can never grip.
+		if (tracked && (vkq_vr_hand_pub[hand].buttons & VKQ_VRB_GRIP))
+			grip = 1.0f;
+		pos[0] = vkq_vr_hand_pub[hand].pos[0];
+		pos[1] = vkq_vr_hand_pub[hand].pos[1];
+		pos[2] = vkq_vr_hand_pub[hand].pos[2];
+		pthread_mutex_unlock (&vkq_vr_mtx);
+
+		if (!tracked)
+		{
+			if (g->down)
+				vkq_vr_grip_release_all ("tracking lost");
+			g->zoneNow = -1;
+			continue;
+		}
+
+		zone = vkq_vr_zone_at (pos);
+		if (zone != g->zoneNow)
+		{
+			if (zone >= 0)
+			{
+				VKQ_VR_Haptic (hand, 0.35f, 0.02f); // you can feel the holster
+				vkq_vr_holster_note ("%s hand entered %s", hand == aim ? "aim" : "off", vkq_vr_zone_names[zone]);
+			}
+			g->zoneNow = zone;
+		}
+
+		if (!g->down && grip >= on)
+		{
+			g->down = 1;
+			g->downTime = now;
+			g->zoneAt = zone;
+			g->assigned = 0;
+			if (vkqvr_style.value >= 0.5f && hand == aim)
+			{
+				// Immersive: the press IS the draw.
+				int imp = (zone >= 0) ? vkq_vr_zone_impulse (zone) : vkq_vr_stowed;
+				if (imp <= 0)
+					imp = 2; // nothing remembered yet: the first real weapon
+				in_impulse = imp;
+				// Remember it NOW, not at release. The server has not processed
+				// the impulse yet, so a quick draw-and-release would otherwise
+				// read STAT_ACTIVEWEAPON as whatever was in hand BEFORE the draw
+				// and remember the wrong weapon.
+				vkq_vr_stowed = imp;
+				vkq_vr_out = 1;
+				VKQ_VR_Haptic (hand, 0.6f, 0.03f);
+				vkq_vr_holster_note ("IMMERSIVE draw imp%d from %s", imp, zone >= 0 ? vkq_vr_zone_names[zone] : "empty space");
+			}
+		}
+		else if (g->down && grip <= off)
+		{
+			const double held = now - g->downTime;
+			g->down = 0;
+			if (vkqvr_style.value >= 0.5f && hand == aim)
+			{
+				// Prefer what is ACTUALLY in hand (the player may have cycled
+				// while holding), but never remember the axe as the stowed
+				// weapon — that is what "stowed" means.
+				const int held_imp = vkq_vr_weapon_impulse (cl.stats[STAT_ACTIVEWEAPON]);
+				if (held_imp > 1)
+					vkq_vr_stowed = held_imp;
+				in_impulse = 1; // the axe is stock progs' empty hands
+				vkq_vr_out = 0;
+				VKQ_VR_Haptic (hand, 0.4f, 0.03f);
+				vkq_vr_holster_note ("IMMERSIVE stow (remembering imp%d)", vkq_vr_stowed);
+			}
+			else if (!g->assigned && g->zoneAt >= 0)
+			{
+				// Any release that did NOT become a reassign is a select. The
+				// obvious alternative — "select only if held <= grip_tap" —
+				// leaves a dead band between the tap window and the hold
+				// window where a squeeze does nothing at all, which reads as
+				// the holster being broken. There is no third gesture, so
+				// there is no reason for a gap.
+				const int imp = vkq_vr_zone_impulse (g->zoneAt);
+				in_impulse = imp;
+				VKQ_VR_Haptic (hand, 0.5f, 0.03f);
+				vkq_vr_holster_note ("select imp%d from %s (%.2fs)", imp, vkq_vr_zone_names[g->zoneAt], held);
+			}
+			g->zoneAt = -1;
+			g->assigned = 0;
+		}
+		else if (g->down && !g->assigned && g->zoneAt >= 0 && zone == g->zoneAt && (now - g->downTime) >= vkqvr_grip_hold.value)
+		{
+			const int imp = vkq_vr_weapon_impulse (cl.stats[STAT_ACTIVEWEAPON]);
+			if (imp > 0)
+			{
+				vkq_vr_zone_set_impulse (g->zoneAt, imp);
+				g->assigned = 1;
+				VKQ_VR_Haptic (hand, 0.8f, 0.05f);
+				vkq_vr_holster_note ("ASSIGNED imp%d to %s", imp, vkq_vr_zone_names[g->zoneAt]);
+			}
+		}
+	}
+}
