+void VKQ_VR_UpdateEyeRise (void)
+{
+	float  want, limit, dt;
+	double now;
+	if (!vkq_vr_active)
+	{
+		vkq_vr_eye_rise = vkq_vr_eye_rise_raw = vkq_vr_eye_rise_limit = 0.0f;
+		vkq_vr_eye_rise_time = 0.0;
+		return;
+	}
+	if (vkq_vr_standing_eye_m > 0.0f)
+		want = vkq_vr_standing_eye_m * vkq_vr_worldscale - VKQ_VR_QUAKE_EYE_UNITS;
+	else
+		want = vkqvr_eyerise.value; // no tracked height yet: the measured default
+	want = CLAMP (-16.0f, want, 48.0f);
+	vkq_vr_eye_rise_raw = want;
+
+	limit = want;
+	if (want > 0.5f && vkqvr_eyeclamp.value >= 0.5f && cl.worldmodel && !cls.demoplayback)
+	{
