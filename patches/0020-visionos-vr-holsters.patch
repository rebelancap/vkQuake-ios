+// Release EVERYTHING a grip was holding, without stowing. The donors' rule and
+// charter A7's: a battery dying mid-hold must never leave the player axe-locked,
+// so Immersive falls back to Convenience with the weapon OUT.
+static void vkq_vr_grip_release_all (const char *why)
+{
+	int h;
+	int wasHeld = 0, handedBack = 0;
+	for (h = 0; h < 2; h++)
+	{
+		if (vkq_vr_grip[h].down)
+			wasHeld = 1;
+		vkq_vr_grip[h].down = 0;
+		vkq_vr_grip[h].zoneAt = vkq_vr_grip[h].zoneNow = -1;
+		vkq_vr_grip[h].assigned = 0;
+	}
+	if (!vkq_vr_out)
+	{
+		// Put the last weapon back in the player's hands rather than leaving them
+		// holding an axe they never chose.
+		if (vkq_vr_stowed)
+		{
+			in_impulse = vkq_vr_stowed;
+			handedBack = vkq_vr_stowed;
+		}
+		vkq_vr_out = 1;
+	}
+	// Log the HANDBACK, not just the grip. A doff that happens while the player
+	// is already stowed releases no grip at all — nothing was held — but it is
+	// the case that matters most, because it is the one where somebody would
+	// otherwise be left holding an axe. R3's simulator round caught this as a
+	// silent success: the weapon came back and the file said nothing.
+	if (handedBack)
+		vkq_vr_holster_note ("released (%s) — handed imp%d back, never axe-locked", why, handedBack);
+	else if (wasHeld)
+		vkq_vr_holster_note ("released (%s)", why);
+}
