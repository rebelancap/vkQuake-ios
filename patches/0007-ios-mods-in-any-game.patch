 	qpic_t *p;
 	qpic_t *menu2 = Get_Menu2 ();
 	int		main_items = MAIN_ITEMS + (menu2 ? 1 : 0);
+#ifdef VKQ_IOS
+	// iOS: inside a mod/expansion (no menu2) add our OWN "MODS" row so you can hop
+	// between games from any of them. Drawn as text, independent of the mod's menu
