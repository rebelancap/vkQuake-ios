+
+int VKQ_VR_HudValues (int *health, int *armour, int *ammo0, int *type0, int *ammo1, int *type1)
+{
+	int a = -1, t0 = -1, t1 = -1, b = -1;
+	if (health)
+		*health = 0;
+	if (armour)
+		*armour = 0;
+	if (ammo0)
+		*ammo0 = -1;
+	if (ammo1)
+		*ammo1 = -1;
+	if (type0)
+		*type0 = -1;
+	if (type1)
+		*type1 = -1;
+	if (!vkq_vr_active || cls.state != ca_connected || cl.intermission || key_dest != key_game)
+		return 0;
+	if (health)
+		*health = cl.stats[STAT_HEALTH];
+	if (armour)
+		*armour = cl.stats[STAT_ARMOR];
+	if (vkq_vr_immersive () && vkq_vr_have)
+	{
+		t0 = vkq_vr_ammo_type (vkq_vr_held_item_get (vkq_vr_aim_hand ()));
+		t1 = vkq_vr_ammo_type (vkq_vr_held_item_get (vkq_vr_off_hand ()));
+	}
+	else
+		t0 = vkq_vr_ammo_type (cl.stats[STAT_ACTIVEWEAPON]);
