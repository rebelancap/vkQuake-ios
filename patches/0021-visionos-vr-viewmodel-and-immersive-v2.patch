+
+static qboolean vkq_vr_owns (int itembit) { return itembit != 0 && (cl.items & itembit) != 0; }
+
+// The one rule that IS the persistence policy. Runs every input frame.
+static void vkq_vr_v2_validate (void)
+{
+	int i;
+	for (i = 0; i < 2; i++)
+	{
+		if (vkq_vr_holster_item[i] && !vkq_vr_owns (vkq_vr_holster_item[i]))
+			vkq_vr_holster_item[i] = 0;
+		if (vkq_vr_held_item[i] && !vkq_vr_owns (vkq_vr_held_item[i]))
+			vkq_vr_held_item[i] = 0;
+	}
+	// Never the same weapon twice.
+	if (vkq_vr_held_item[0] && vkq_vr_held_item[0] == vkq_vr_held_item[1])
+		vkq_vr_held_item[vkq_vr_off_hand ()] = 0;
