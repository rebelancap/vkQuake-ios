+		return 0; // shells
+	case IT_NAILGUN:
+	case IT_SUPER_NAILGUN:
+		return 1; // nails
+	case IT_GRENADE_LAUNCHER:
+	case IT_ROCKET_LAUNCHER:
+		return 2; // rockets
+	case IT_LIGHTNING:
+		return 3; // cells
+	default:
+		return -1; // the axe has none
+	}
+}
+
+static int vkq_vr_ammo_count (int type)
+{
+	switch (type)
+	{
+	case 0:
+		return cl.stats[STAT_SHELLS];
+	case 1:
+		return cl.stats[STAT_NAILS];
+	case 2:
+		return cl.stats[STAT_ROCKETS];
+	case 3:
+		return cl.stats[STAT_CELLS];
+	default:
+		return -1;
+	}
