+static int vkq_vr_holster_item[2]; // by zone: RHIP, LHIP. 0 = empty
+static int vkq_vr_held_item[2];	   // by HAND: 0 = left, 1 = right. 0 = empty hand
+static int vkq_vr_v2_started = 0; // seeded the aim hand from the server yet
+
+static qboolean vkq_vr_immersive (void) { return vkqvr_style.value >= 0.5f; }
+static int		vkq_vr_held_item_get (int hand) { return (hand >= 0 && hand < 2) ? vkq_vr_held_item[hand] : 0; }
