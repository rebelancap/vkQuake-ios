+	int				 cur = vkq_vr_held_item_get (hand), i, start = 0, step;
+	if (!vkq_vr_immersive ())
+	{
+		in_impulse = next ? 10 : 12;
+		return;
+	}
+	for (i = 0; i < 8; i++)
+		if (order[i] == cur)
+			start = i;
+	step = next ? 1 : 7;
+	for (i = 1; i <= 8; i++)
+	{
+		const int cand = order[(start + i * step) % 8];
+		if (cand == cur || !vkq_vr_owns (cand))
+			continue;
