+// that reorders them reorders this with it, which is why Convenience remains the
+// mods-safe path (VR-R4-NOTES).
+static int vkq_vr_impulse_item (int imp)
+{
+	switch (imp)
+	{
+	case 1:
+		return IT_AXE;
+	case 2:
+		return IT_SHOTGUN;
+	case 3:
+		return IT_SUPER_SHOTGUN;
+	case 4:
+		return IT_NAILGUN;
+	case 5:
+		return IT_SUPER_NAILGUN;
+	case 6:
+		return IT_GRENADE_LAUNCHER;
+	case 7:
+		return IT_ROCKET_LAUNCHER;
+	case 8:
+		return IT_LIGHTNING;
+	default:
+		return 0;
+	}
+}
+
+static const char *vkq_vr_weapon_modelname (int itembit)
+{
+	switch (itembit)
+	{
+	case IT_AXE:
+		return "progs/v_axe.mdl";
+	case IT_SHOTGUN:
+		return "progs/v_shot.mdl";
+	case IT_SUPER_SHOTGUN:
+		return "progs/v_shot2.mdl";
+	case IT_NAILGUN:
+		return "progs/v_nail.mdl";
+	case IT_SUPER_NAILGUN:
+		return "progs/v_nail2.mdl";
+	case IT_GRENADE_LAUNCHER:
+		return "progs/v_rock.mdl";
+	case IT_ROCKET_LAUNCHER:
+		return "progs/v_rock2.mdl";
+	case IT_LIGHTNING:
+		return "progs/v_light.mdl";
+	default:
+		return NULL;
+	}
+}
+
+// From the PRECACHE list, never Mod_ForName: a model load in the middle of a
+// frame is a stall and a filesystem touch, and id1's worldspawn precaches every
+// v_ model anyway. A mod that renames them simply gets no holster model, which
+// is a missing decoration rather than a broken weapon.
+static qmodel_t *vkq_vr_weapon_model (int itembit)
+{
+	const char *want = vkq_vr_weapon_modelname (itembit);
+	int			i;
+	if (!want)
+		return NULL;
+	for (i = 1; i < MAX_MODELS && cl.model_precache[i]; i++)
+		if (!q_strcasecmp (cl.model_precache[i]->name, want))
+			return cl.model_precache[i];
+	return NULL;
