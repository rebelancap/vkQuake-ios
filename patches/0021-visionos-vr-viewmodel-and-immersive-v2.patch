+#ifdef VKQ_VISIONOS
 /*
+==============================================================================
+
+VIEWMODEL GEOMETRY — vkquake-ios overlay 0021 (VR R4)
+
+Two things this round needs to know about a viewmodel, and both of them are
+facts about the model rather than opinions about the weapon, so both are read
+off the geometry at load time and neither is keyed on a file name, a data set
+or a weapon id. Original id1 .mdl, the 2021 rerelease's .md5mesh remesh of the
+same weapon, and an arbitrary mod's viewmodel all go through this identically.
+
+1. THE GHOSTS. Every id viewmodel except the axe carries its muzzle flash as
+   part of the same mesh, and hides it between shots by PARKING it behind the
+   model origin. A viewmodel's origin is the shooter's eye, so parked flash is
+   behind the near plane and a flat-screen Quake can never draw it — which is
+   why nobody noticed in thirty years. Put the weapon in a VR hand an arm's
+   length from your face and the same geometry is suddenly out in the open,
+   hanging off the BACK of the gun, permanently. There is no engine mechanism
+   to replicate: the rerelease KEX engine does not hide it either, it just
+   never moves the gun off the camera. The cure has to be ours.
+
+   A vertex is parked flash when all three hold:
+     a. in the idle pose it is behind the model origin (x < 0);
+     b. in some other pose it TELEPORTS forward — ends up ahead of the origin
+        having travelled more than a quarter of the model's own length. Only
+        id's flash trick does that;
+     c. the whole candidate set is separated from the rest of the model, in the
+        idle pose, by a real gap. This is what stops a shotgun's stock butt or
+        the axe's forearm — which merely swing through the origin — from being
+        mistaken for flash.
+   Verified against the rerelease .md5mesh joint names (`flame*`, `bolt*`),
+   which the rule never sees: 8 models out of 8, both data sets, exact.
+
+   The cure is to COLLAPSE the flash to a point inside the weapon body in
+   exactly those poses where it is parked. Firing poses are untouched, so the
+   muzzle flash still fires out of the barrel. .mdl collapses pose vertices;
+   .md5mesh collapses the flash joints' per-pose matrices, which is the same
+   thing one level up.
+
+2. THE GRIP. R2 seeded a per-weapon position table from QuakeQuest and applied
+   its numbers AFTER the model scale where the donor applies them BEFORE it.
+   The error is therefore proportional to (1 - scale), and the user's device
+   verdicts on 2026-08-10 rank in exactly that order: grenade launcher and
+   lightning gun (scale 1.00) "look great" and are numerically untouched; super
+   shotgun 0.90 and shotgun 0.65 also great; nailgun and axe 0.50 wrong; rocket
+   launcher 0.45 wrong; super nailgun 0.40 "worst". So the table is not a table
+   of placements, it is a table of one mistake.
+
+   What replaces it: the weapon is mounted so that a GRIP ANCHOR derived from
+   its own geometry lands in the fist — the point on the axis of the weapon's
+   rear quarter, one hand's breadth forward of its rearmost point. Fitted to
+   the four weapons the user judged good, that is 4.15 units back and 0.75 units
+   up, in world units, with a residual spread of 1.3 units (3 cm) — and the
+   same two constants then place the four wrong ones exactly the way he asked
+   for them (lower, further from the body).
+
+==============================================================================
+*/
+
+typedef struct
+{
+	int	   valid;		// 1 = mins/maxs/grip usable
+	int	   nflash;		// parked-flash vertices found
+	int	   nposes;		// poses in which they were parked (and collapsed)
+	vec3_t mins, maxs;	// idle-pose bounds, flash excluded
+	vec3_t grip;		// (rear x, rear-slab y, rear-slab z)
+} vkq_vm_result_t;
+
+// Rear-quarter slab used for the grip axis. A quarter is the whole receiver on
+// every stock weapon and stays inside the stock on a longer mod one.
+#define VKQ_VM_REARFRAC 0.25f
+
+/*
 =================
+VKQ_VM_Analyze -- overlay 0021
+
+px      [pose*nverts + vert] object-space X for every pose (pose 0 = idle)
+idle3   [vert*3] object-space xyz for pose 0
+flash   [vert] out: 1 = parked muzzle flash
+parked  [pose] out: 1 = the flash set is parked (hidden) in this pose
+=================
+*/
+static void VKQ_VM_Analyze (int nverts, int nposes, const float *px, const float *idle3, byte *flash, byte *parked, vkq_vm_result_t *out)
+{
+	int	  i, p, ncand = 0;
+	float lo = 1e30f, hi = -1e30f, ext, gap, need;
+	float candhi = -1e30f, restlo = 1e30f, lim = 1e30f;
+
+	memset (out, 0, sizeof (*out));
+	memset (flash, 0, nverts);
+	memset (parked, 0, nposes);
+	if (nverts <= 0 || nposes <= 0)
+		return;
+
+	for (i = 0; i < nverts; i++)
+	{
+		if (idle3[i * 3 + 0] < lo)
+			lo = idle3[i * 3 + 0];
+		if (idle3[i * 3 + 0] > hi)
+			hi = idle3[i * 3 + 0];
+	}
+	ext = hi - lo;
+	if (ext <= 0.0f)
+		return;
+
+	// (a) behind the origin in the idle pose, (b) teleports forward in another
+	for (i = 0; i < nverts; i++)
+	{
+		float x0 = idle3[i * 3 + 0], mx = x0;
+		if (x0 >= 0.0f)
+			continue;
+		for (p = 1; p < nposes; p++)
+			if (px[p * nverts + i] > mx)
+				mx = px[p * nverts + i];
+		if (mx > 0.0f && (mx - x0) > 0.25f * ext)
+		{
+			flash[i] = 1;
+			ncand++;
+		}
+	}
+
+	// (c) a real gap in the idle pose, or it is not a separate thing at all
+	if (ncand > 0 && ncand < nverts)
+	{
+		for (i = 0; i < nverts; i++)
+		{
+			if (flash[i])
+			{
+				if (idle3[i * 3 + 0] > candhi)
+					candhi = idle3[i * 3 + 0];
+			}
+			else if (idle3[i * 3 + 0] < restlo)
+				restlo = idle3[i * 3 + 0];
+		}
+		gap = restlo - candhi;
+		need = q_max (3.0f, 0.06f * ext);
+		if (gap < need)
+		{
+			memset (flash, 0, nverts);
+			ncand = 0;
+		}
+	}
+	else
+	{
+		memset (flash, 0, nverts);
+		ncand = 0;
+	}
+	out->nflash = ncand;
+
+	// Which poses have it parked: entirely behind the origin AND behind every
+	// retained vertex the model ever shows. Both, so a weapon whose own body
+	// reaches behind the origin (the shotgun's does) still gets a correct
+	// answer.
+	if (ncand)
+	{
+		for (p = 0; p < nposes; p++)
+			for (i = 0; i < nverts; i++)
+				if (!flash[i] && px[p * nverts + i] < lim)
+					lim = px[p * nverts + i];
+		if (lim > 0.0f)
+			lim = 0.0f;
+		for (p = 0; p < nposes; p++)
+		{
+			float fmax = -1e30f;
+			for (i = 0; i < nverts; i++)
+				if (flash[i] && px[p * nverts + i] > fmax)
+					fmax = px[p * nverts + i];
+			if (fmax < lim)
+			{
+				parked[p] = 1;
+				out->nposes++;
+			}
+		}
+	}
+
+	// Bounds and grip axis from the idle pose, flash excluded.
+	{
+		vec3_t mins = {1e30f, 1e30f, 1e30f}, maxs = {-1e30f, -1e30f, -1e30f};
+		double sy = 0.0, sz = 0.0;
+		int	   n = 0, k;
+		float  cut;
+		for (i = 0; i < nverts; i++)
+		{
+			if (flash[i])
+				continue;
+			for (k = 0; k < 3; k++)
+			{
+				if (idle3[i * 3 + k] < mins[k])
+					mins[k] = idle3[i * 3 + k];
+				if (idle3[i * 3 + k] > maxs[k])
+					maxs[k] = idle3[i * 3 + k];
+			}
+			n++;
+		}
+		if (n < 4 || maxs[0] <= mins[0])
+			return;
+		cut = mins[0] + VKQ_VM_REARFRAC * (maxs[0] - mins[0]);
+		n = 0;
+		for (i = 0; i < nverts; i++)
+		{
+			if (flash[i] || idle3[i * 3 + 0] > cut)
+				continue;
+			sy += idle3[i * 3 + 1];
+			sz += idle3[i * 3 + 2];
+			n++;
+		}
+		if (!n)
+			return;
+		VectorCopy (mins, out->mins);
+		VectorCopy (maxs, out->maxs);
+		out->grip[0] = mins[0];
+		out->grip[1] = (float)(sy / n);
+		out->grip[2] = (float)(sz / n);
+		out->valid = 1;
+	}
+}
+
+// Only viewmodels. A world model's origin is not an eye, so rule (a) would be
+// meaningless there — and no world model uses the parking trick anyway.
+static qboolean VKQ_VM_IsViewmodel (const char *name)
+{
+	const char *base = name, *s;
+	for (s = name; *s; s++)
+		if (*s == '/' || *s == '\\')
+			base = s + 1;
+	return (base[0] == 'v' || base[0] == 'V') && base[1] == '_';
+}
+
+static void VKQ_VM_Publish (aliashdr_t *h, const vkq_vm_result_t *r, const char *name)
+{
+	h->vr_geo = r->valid;
+	h->vr_flashverts = r->nflash;
+	h->vr_flashposes = r->nposes;
+	VectorCopy (r->mins, h->vr_min);
+	VectorCopy (r->maxs, h->vr_max);
+	VectorCopy (r->grip, h->vr_grip);
+	if (r->valid)
+		Con_DPrintf (
+			"VR viewmodel %s: bounds (%.1f %.1f %.1f)-(%.1f %.1f %.1f) grip (%.1f %.1f %.1f) flash %d verts in %d poses\n", name, r->mins[0], r->mins[1],
+			r->mins[2], r->maxs[0], r->maxs[1], r->maxs[2], r->grip[0], r->grip[1], r->grip[2], r->nflash, r->nposes);
+}
+#endif // VKQ_VISIONOS
