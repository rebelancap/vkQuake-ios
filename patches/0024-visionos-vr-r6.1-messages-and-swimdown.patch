+#ifdef VKQ_VISIONOS
 /*
+==================
+VKQ_VR_NotifyText -- overlay 0024 (VR R6.1 item 2)
+
+The console NOTIFY lines — the second class of in-game message, and the reason
+this round covers a class rather than one symptom.
+
+the user's example ("this door is opened elsewhere") is a centerprint, but the
+messages a Quake player reads most often are not: "You got the Rocket Launcher",
+"You got the Silver Key", a death message, "secret found" — every one of those
+is an sprint/bprint, i.e. an svc_print that lands here and is drawn by
+Con_DrawNotify. In VR those were invisible for exactly the same reason
+centerprints were, and fixing only the one the user named would have left the
+common case broken.
+
+DUPLICATION IS NOT A RISK, and it is worth writing down why rather than adding a
+filter for it: Con_LogCenterPrint echoes every centerprint into the console and
+then calls Con_ClearNotify(), so the echo is deliberately removed from the
+notify window by the same function that wrote it. The two feeds cannot show the
+same text at the same time.
+
+ONE TERM IS ADDED to Con_DrawNotify's walk, and it is the difference between a
+feature and a nuisance: only lines marked `con_notify_game` — printed while
+cl_parse.c was handling an svc_print, i.e. while the GAME was talking — are
+returned. Everything else the console says (resolutions, demo chatter, a dev
+build's bridge command echoes) stays in the console. The first simulator probe of
+this feature made the case better than any argument: it put a BODYNOW
+diagnostics dump and "vkqvrhandbtn: right buttons = 0x00" on a head-locked panel
+in three-inch letters. On a flat screen that overlay is a corner nobody minds;
+at 1.75 m across 34 degrees it is the whole view.
+
+Otherwise the walk is Con_DrawNotify's term for term, including the
+`con_notifytime / (viewsize >= 130 ? 4 : 1)` scaling — one predicate, so the VR
+panel and the flat overlay agree about what is still current. Trailing padding
+is trimmed (console lines are con_linewidth wide and space-filled) and the high
+bit is KEPT: it selects Quake's alternate charset, and the shell's glyph atlas
+is the full 256, so a coloured line reads in VR the way it reads flat.
+==================
+*/
+int VKQ_VR_NotifyText (char *out, int len)
+{
+	int i, n = 0;
+	if (!out || len <= 0)
+		return 0;
+	out[0] = 0;
+	if (!con_initialized || con_text == NULL)
+		return 0;
+	for (i = con_current - NUM_CON_TIMES + 1; i <= con_current; i++)
+	{
+		const char *text;
+		float		time;
+		int			last, x;
+		if (i < 0)
+			continue;
+		time = con_times[i % NUM_CON_TIMES];
+		if (time == 0)
+			continue;
+		if (!con_notify_game[i % NUM_CON_TIMES])
+			continue; // engine chatter stays in the console — see the note above
+		time = realtime - time;
+		if (time > con_notifytime.value / (scr_viewsize.value >= 130 ? 4 : 1))
+			continue;
+		text = con_text + (i % con_totallines) * con_linewidth;
+		for (last = con_linewidth - 1; last >= 0 && (text[last] & 0x7F) <= ' '; last--)
+			;
+		if (last < 0)
+			continue; // a blank line carries no message
+		for (x = 0; x <= last; x++)
+		{
+			if (n >= len - 2)
+				break;
+			out[n++] = text[x];
+		}
+		if (n < len - 1)
+			out[n++] = '\n';
+	}
+	if (n > 0 && out[n - 1] == '\n')
+		n--; // no trailing blank row on the panel
+	out[n] = 0;
+	return n > 0;
+}
+#endif
