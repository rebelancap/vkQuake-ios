 void IN_Init (void)
 {
 	textmode = Key_TextEntry ();
 
+#ifdef VKQ_IOS
+	VKQ_iOS_SetTextActive (textmode ? 1 : 0);
+#else
 	if (textmode)
 		SDL_StartTextInput (SDL3_GET_WINDOW);
 	else
 		SDL_StopTextInput (SDL3_GET_WINDOW);
+#endif
 
+#ifdef VKQ_IOS
+	// iOS has no mouse; relative-mouse-mode calls fail and spam the console every
+	// activate. Force no_mouse so IN_Activate/IN_HideCursor early-return. Aim is
+	// touch / gyro / gamepad.
+	no_mouse = true;
+	IN_BeginIgnoringMouseEvents ();
+	// The menu is driven straight from finger events (in_sdl3.c) — SDL's touch->mouse
+	// synthesis freezes at the first tap's position on this hardware, so every menu
+	// tap stuck on the first item. Turn the synthesis OFF so its stale-position mouse
+	// buttons don't also fire spurious menu clicks.
+	SDL_SetHint (SDL_HINT_TOUCH_MOUSE_EVENTS, "0");
+	// Console seam for the touch look bridge. Without it the touch aim path is
+	// unreachable from the console — on a simulator synthetic events bypass
+	// UIKit entirely, so a touch-look regression could never be caught without
+	// hands on glass. Feeds the same accumulator a finger drag does.
+	Cmd_AddCommand ("vkq_touchlook", IN_TouchLook_f);
+#endif
 	if (safemode || COM_CheckParm ("-nomouse"))
 	{
 		no_mouse = true;
