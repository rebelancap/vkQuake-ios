+#ifdef VKQ_IOS
+// iOS uses a NATIVE UIKeyInput keyboard in the shell, not SDL's soft keyboard
+// (SDL's was a persistent source of bugs on this hardware — backspace gated by
+// SDL_HasKeyboard(), touch->mouse gated by SDL_HasMouse()). The engine just tells
+// the shell when a text field / console is active; the shell shows/hides its own
+// keyboard and feeds characters back via VKQ_TouchChar / VKQ_TouchKey.
+extern void VKQ_iOS_SetTextActive (int active);
+static void IN_TouchLook_f (void); // defined with the touch bridge below
+// Shell still uses this to position SDL's view-shift when the native keyboard shows.
+void VKQ_iOS_SetTextInputRect (int x, int y, int w, int h)
+{
+	SDL_Window *win = SDL3_GET_WINDOW;
+	SDL_Rect	r;
+	if (!win)
+		return;
+	r.x = x;
+	r.y = y;
+	r.w = w;
+	r.h = h;
+	SDL_SetTextInputArea (win, &r, 0);
+}
+#endif
