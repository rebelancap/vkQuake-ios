+#ifdef VKQ_IOS
+// --- vkquake-ios overlay 0004: touch input bridge --------------------------
+// The native UIKit overlay (ios/shell/ios_touch.m) calls these C setters; the
+// per-frame IN_TouchMove folds them into the usercmd/viewangles, mirroring
+// IN_JoyMove. Display link + UIKit both run on the main thread — no locking.
+extern cvar_t cl_forwardspeed, cl_sidespeed, cl_movespeedkey;
+static float vkq_move_fwd, vkq_move_side;  // analog stick, [-1, 1]
+static float vkq_look_yaw, vkq_look_pitch; // accumulated look degrees (consumed/frame)
+static int	 vkq_touch_run = 1;			   // always-run toggle (iOS settings)
+
+void VKQ_TouchSetRun (int on) { vkq_touch_run = on; }
+
+void VKQ_TouchMove (float fwd, float side)
+{
+	vkq_move_fwd = fwd;
+	vkq_move_side = side;
 }
+void VKQ_TouchLook (float dyaw_deg, float dpitch_deg)
+{
+	vkq_look_yaw += dyaw_deg;
+	vkq_look_pitch += dpitch_deg;
+}
+// `vkq_touchlook <dyaw> <dpitch>` (degrees; +dpitch looks DOWN, as in viewangles)
+static void IN_TouchLook_f (void)
+{
+	if (Cmd_Argc () != 3)
+	{
+		Con_Printf ("vkq_touchlook <dyaw> <dpitch> : inject a touch-look delta, in degrees\n");
+		return;
+	}
+	VKQ_TouchLook ((float)atof (Cmd_Argv (1)), (float)atof (Cmd_Argv (2)));
+}
+void VKQ_TouchKey (int key, int down) { Key_Event (key, down ? true : false); }
+void VKQ_TouchChar (int c) { Char_Event (c); } // native iOS keyboard -> engine text input
+void VKQ_TouchCommand (const char *text) { Cbuf_AddText (text); }
+int	 VKQ_TouchKeyDest (void) { return (int)key_dest; }
+int	 VKQ_TouchInGame (void) { return (key_dest == key_game && cls.state == ca_connected && !cls.demoplayback) ? 1 : 0; }
+int	 VKQ_TouchIsDemo (void) { return cls.demoplayback ? 1 : 0; }
+int	 VKQ_HasActiveController (void)
+{
+	extern SDL_Gamepad *joy_active_controller; // in_sdl3.c: the engine's open gamepad
+	return joy_active_controller != NULL ? 1 : 0;
+}
 
+static void IN_TouchMove (usercmd_t *cmd)
+{
+	float run = (vkq_touch_run && cl_movespeedkey.value > 0) ? cl_movespeedkey.value : 1.0f;
+	cmd->forwardmove += cl_forwardspeed.value * run * vkq_move_fwd;
+	cmd->sidemove += cl_sidespeed.value * run * vkq_move_side;
+
+	// Touch and gyro look must stop pitch drift, exactly as the mouse and stick
+	// paths do (IN_MouseMove / IN_JoyMove). Without this, cl.nodrift is never
+	// set on a touch-only device, so V_DriftPitch springs the view back to
+	// level within a second of every aim — you cannot hold a look up or down.
+	if (vkq_look_yaw != 0.0f || vkq_look_pitch != 0.0f)
+		V_StopPitchDrift ();
+
+	cl.viewangles[YAW] -= vkq_look_yaw;
+	cl.viewangles[PITCH] += vkq_look_pitch;
+	if (cl.viewangles[PITCH] > cl_maxpitch.value)
+		cl.viewangles[PITCH] = cl_maxpitch.value;
+	if (cl.viewangles[PITCH] < cl_minpitch.value)
+		cl.viewangles[PITCH] = cl_minpitch.value;
+	vkq_look_yaw = vkq_look_pitch = 0;
+}
+#endif
