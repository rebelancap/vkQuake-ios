+/*
+==================
+VKQ_VR_HudIcon -- overlay 0022 (VR R5 item 5)
+
+Quake's OWN status-bar iconography, handed to the shell as RGBA.
+
+R4's head-locked HUD drew its own 3x5 glyphs, and the user's verdict on the result
+was blunt: "unclear" — a diamond, a number and a small box. The icons a Quake
+player recognises without thinking already exist, in gfx.wad, in every data set
+and in every mod that replaces them: the face, the armour plates, the four ammo
+boxes. Nothing needs to be authored, and a mod that ships its own sbar art gets
+its own art in VR for free.
+
+The shell cannot reach them the normal way — Draw_PicFromWad uploads to Vulkan
+and hands back a gltexture_t, and the HUD is a Metal texture the shell rasterises
+itself — so this reads the WAD lump directly and converts 8-bit indices through
+the live palette. Index 255 is Quake's transparent index (the same rule
+TEXPREF_ALPHA applies), so it becomes alpha 0 and the icon composites over the
+world instead of sitting in a box.
+
+Returns 0 (and touches nothing) when the lump is absent, which is a missing
+decoration rather than a failure: the HUD falls back to its own glyph.
+==================
+*/
+int VKQ_VR_HudIcon (const char *name, unsigned *out, int maxw, int maxh, int *ow, int *oh)
+{
+	lumpinfo_t *info = NULL;
+	qpic_t	   *p;
+	int			x, y, w, h;
+	if (!name || !out || maxw <= 0 || maxh <= 0)
+		return 0;
+	p = (qpic_t *)W_GetLumpName (name, &info);
+	if (!p || !info)
+		return 0;
+	w = LittleLong (p->width);
+	h = LittleLong (p->height);
+	if (w <= 0 || h <= 0 || w > maxw || h > maxh)
+		return 0;
+	// Same sanity check Draw_PicFromWad makes: the lump must actually hold the
+	// pixels its header claims (a truncated or mislabelled lump is a crash).
+	if ((size_t)info->size < (size_t) (w * h) + 8)
+		return 0;
+	for (y = 0; y < h; y++)
+		for (x = 0; x < w; x++)
+		{
+			const byte idx = p->data[y * w + x];
+			out[y * maxw + x] = (idx == 255) ? 0u : (d_8to24table[idx] | 0xFF000000u);
+		}
+	if (ow)
+		*ow = w;
+	if (oh)
+		*oh = h;
+	return 1;
+}
