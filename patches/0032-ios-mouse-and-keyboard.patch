+/*
+================
+M_MouseHover -- a hardware mouse's ABSOLUTE pointer position, in DRAWABLE PIXELS
+(issue #6). Called from the in_sdl3.c event filter while a menu is up and the
+pointer is unlocked. Moves the same cursor a finger does, so the row under the
+pointer highlights and a real click (K_MOUSE1 straight from SDL) lands on it. A
+finger mid-gesture keeps ownership of the cursor.
+================
+*/
+void M_MouseHover (float px, float py)
+{
+	if (vkq_touch_down)
+		return;
+	vkq_menu_touch_x = px;
+	vkq_menu_touch_y = py;
+}
