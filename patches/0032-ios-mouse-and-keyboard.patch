 static void IN_UIAction_f (void);   // ditto (issue #5: console by touch)
+// `vkq_fakemouseclick <x 0..1> <y 0..1> [touchid]` — a hardware-mouse left click
+// as SDL3 delivers it on iOS (the sim cannot present a GCMouse): absolute motion,
+// button down, the synthetic SDL_EVENT_FINGER_DOWN that SDL_HINT_MOUSE_TOUCH_EVENTS
+// pairs with it (touchID = SDL_MOUSE_TOUCHID), button up, finger up. Pushed through
+// the normal queue so the event filter and IN_Commands see exactly that sequence.
+// Passing another touchid (e.g. 7) makes the synthetic finger look real — the
+// pre-fix behaviour, where every menu click fired twice (issue #6 follow-up).
+static void IN_FakeMouseClick_f (void)
+{
+	SDL_Window *win = SDL3_GET_WINDOW;
+	SDL_Event	ev;
+	SDL_TouchID tid = SDL_MOUSE_TOUCHID;
+	float		nx, ny;
+	int			w = 0, h = 0, i;
+	if (Cmd_Argc () < 3 || Cmd_Argc () > 4 || !win)
+	{
+		Con_Printf ("vkq_fakemouseclick <x 0..1> <y 0..1> [touchid]\n");
+		return;
+	}
+	nx = (float)atof (Cmd_Argv (1));
+	ny = (float)atof (Cmd_Argv (2));
+	if (Cmd_Argc () == 4)
+		tid = (SDL_TouchID)strtoll (Cmd_Argv (3), NULL, 10);
+	SDL_GetWindowSize (win, &w, &h);
+	SDL_zero (ev);
+	ev.type = SDL_EVENT_MOUSE_MOTION;
+	ev.motion.windowID = SDL_GetWindowID (win);
+	ev.motion.x = nx * (float)w;
+	ev.motion.y = ny * (float)h;
+	SDL_PushEvent (&ev);
+	for (i = 0; i < 2; i++)
+	{
+		SDL_zero (ev);
+		ev.type = i ? SDL_EVENT_MOUSE_BUTTON_UP : SDL_EVENT_MOUSE_BUTTON_DOWN;
+		ev.button.windowID = SDL_GetWindowID (win);
+		ev.button.button = SDL_BUTTON_LEFT;
+		ev.button.down = !i;
+		ev.button.clicks = 1;
+		ev.button.x = nx * (float)w;
+		ev.button.y = ny * (float)h;
+		SDL_PushEvent (&ev);
+		SDL_zero (ev);
+		ev.type = i ? SDL_EVENT_FINGER_UP : SDL_EVENT_FINGER_DOWN;
+		ev.tfinger.windowID = SDL_GetWindowID (win);
+		ev.tfinger.touchID = tid;
+		ev.tfinger.fingerID = SDL_BUTTON_LEFT;
+		ev.tfinger.x = nx;
+		ev.tfinger.y = ny;
+		ev.tfinger.pressure = i ? 0.0f : 1.0f;
+		SDL_PushEvent (&ev);
+	}
+	Con_Printf ("fakemouseclick: (%.3f,%.3f) window %dx%d synthetic touchid %lld\n", nx, ny, w, h, (long long)tid);
+}
