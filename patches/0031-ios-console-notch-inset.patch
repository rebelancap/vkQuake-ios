vkquake-ios overlay 0031: notch-side console inset (issue #5 follow-up).

On a notched / Dynamic Island iPhone in landscape the cutout covers one edge of
the console (drawn edge to edge). The shell pushes the cutout side's safe-area
inset in drawable pixels via VKQ_TouchSetConsoleInset(left, right): with the
cutout on the left the console buffer, input line, notify lines, selection and
hit-testing move right by that many whole console characters; on either side
con_linewidth shrinks by the inset, so wrapped text and the version string end
clear of it. iPhone only (VKQ_IOS and not VKQ_VISIONOS); menus and HUD are
untouched. Applies on top of 0030.

--- a/Quake/console.c
+++ b/Quake/console.c
@@ -38,6 +38,48 @@
 
 int con_linewidth;
 
+#if defined(VKQ_IOS) && !defined(VKQ_VISIONOS)
+/*
+vkquake-ios overlay 0031: notch-side console indent (issue #5 follow-up).
+
+On a notched / Dynamic Island phone in landscape the cutout covers one edge of
+the console, which is drawn edge to edge of the Metal view. The shell pushes
+the inset of the CUTOUT side only, in drawable pixels (iOS reports symmetric
+left/right safe-area insets on these phones, so the shell picks the side from
+the interface orientation). Cutout on the left: the text moves right by the
+inset (rounded up to whole 8-unit characters of the console canvas). Either
+side: the line width shrinks by the inset, so wrapped text and the version
+string end clear of the cutout.
+*/
+static int vkq_con_inset_l, vkq_con_inset_r; // drawable pixels
+void	   VKQ_TouchSetConsoleInset (int left_px, int right_px)
+{
+	left_px = q_max (left_px, 0);
+	right_px = q_max (right_px, 0);
+	if (left_px != vkq_con_inset_l || right_px != vkq_con_inset_r)
+		Sys_Printf ("[vkquake] console inset: left %d px, right %d px (vid %dx%d, conwidth %d)\n", left_px, right_px, vid.width, vid.height,
+					vid.conwidth);
+	vkq_con_inset_l = left_px;
+	vkq_con_inset_r = right_px;
+}
+// An inset in console characters (8 canvas units each), capped to an eighth of
+// the line per side so a bogus value can never collapse the console.
+static int VKQ_ConInsetChars (int px)
+{
+	int units, chars;
+	if (px <= 0 || vid.width <= 0 || vid.conwidth <= 0)
+		return 0;
+	units = (int)(((long long)px * vid.conwidth + vid.width - 1) / vid.width);
+	chars = (units + 7) >> 3;
+	return q_min (chars, (vid.conwidth >> 3) / 8);
+}
+#define VKQ_CON_INDENT (VKQ_ConInsetChars (vkq_con_inset_l))
+#define VKQ_CON_RINSET (VKQ_ConInsetChars (vkq_con_inset_r))
+#else
+#define VKQ_CON_INDENT 0
+#define VKQ_CON_RINSET 0
+#endif
+
 float con_cursorspeed = 4;
 
