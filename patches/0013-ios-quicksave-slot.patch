vkquake-ios overlay 0013: quick save / quick load as a first-class slot.

vkQuake already had 'save quick' / 'load quick' (bindable in the Keys menu)
but the Load menu enumerates s0..s19 by filename, so quick.sav was invisible
and recoverable only from the console. This surfaces it as a TOP-MOST
pseudo-slot (LOAD cursor 0 = quick, 1..MAX = s0..s(MAX-1)) drawn bright, so
no numbered slot is stolen. Adds vkq_quicksave / vkq_quickload for the iOS
menu chrome, which do the same teardown the menu's own load path does, and
VKQ_iOS_QuickSaveAvailable() so the shell only offers them from the first
main menu of a live single-player game.

--- a/Quake/menu.c
+++ b/Quake/menu.c
@@ -60,6 +60,9 @@
 static void M_Quit_Draw (cb_context_t *cbx);
 
 static void M_Main_Key (int key);
+#ifdef VKQ_IOS
+static void M_ScanSaves (void); // main menu refreshes the quick-slot state
+#endif
 static void M_SinglePlayer_Key (int key);
 static void M_Load_Key (int key);
 static void M_Save_Key (int key);
@@ -629,6 +632,13 @@
 	IN_Deactivate (true);
 	key_dest = key_menu;
 	m_state = m_main;
+#ifdef VKQ_IOS
+	// Refresh the quick-slot state here, not just when the Load/Save menu opens:
+	// the shell's QUICK LOAD button reads it, and a quicksave made from the
+	// button or a keybind would otherwise leave it stale until you happened to
+	// visit the Load menu — the button simply would not appear.
+	M_ScanSaves ();
+#endif
 }
 
 static qpic_t *Get_Menu2 ()
@@ -841,6 +851,15 @@
 #define MAX_SAVEGAMES 20 /* johnfitz -- increased from 12 */
 char m_filenames[MAX_SAVEGAMES][SAVEGAME_COMMENT_LENGTH + 1];
 int	 loadable[MAX_SAVEGAMES];
+#ifdef VKQ_IOS
+// `save quick` writes quick.sav, which the Load menu never listed because it
+// enumerates s0..s19 by filename — so a quicksave was invisible and only
+// recoverable by `load quick`. Surface it as a TOP-MOST pseudo-slot instead of
+// stealing a numbered one: LOAD cursor 0 is quick, 1..MAX map to s0..s(MAX-1).
+static qboolean vkq_quick_loadable;
+static char		vkq_quick_comment[SAVEGAME_COMMENT_LENGTH + 1];
+#define VKQ_LOAD_ROWS (MAX_SAVEGAMES + 1)
+#endif
 
 static void M_ScanSaves (void)
 {
@@ -881,9 +900,75 @@
 		}
 	}
 
+#ifdef VKQ_IOS
+	// same dual lookup the numbered slots use (prefpath when multiuser, else gamedir)
+	q_strlcpy (vkq_quick_comment, "--- NO QUICK SAVE ---", sizeof (vkq_quick_comment));
+	vkq_quick_loadable = false;
+	for (j = (multiuser ? 0 : 1); j < 2; ++j)
+	{
+		if (j == 0)
+			q_snprintf (name, sizeof (name), "%squick.sav", save_path);
+		else
+			q_snprintf (name, sizeof (name), "%s/quick.sav", com_gamedir);
+		f = fopen (name, "r");
+		if (!f)
+			continue;
+		if (fscanf (f, "%i\n", &version) == 1 && fscanf (f, "%79s\n", name) == 1)
+		{
+			q_strlcpy (vkq_quick_comment, name, SAVEGAME_COMMENT_LENGTH + 1);
+			for (k = 0; k < SAVEGAME_COMMENT_LENGTH; k++)
+				if (vkq_quick_comment[k] == '_')
+					vkq_quick_comment[k] = ' ';
+			vkq_quick_loadable = true;
+		}
+		fclose (f);
+		if (vkq_quick_loadable)
+			break;
+	}
+#endif
+
 	SDL_free (save_path);
 }
 
+#ifdef VKQ_IOS
+// Availability for the shell's quick save/load chrome: a LIVE single-player game
+// AND the first main menu — not a submenu, and never over the HUD.
+int VKQ_iOS_QuickSaveAvailable (void)
+{
+	return (sv.active && !cl.intermission && svs.maxclients == 1 && key_dest == key_menu && m_state == m_main) ? 1 : 0;
+}
+int VKQ_iOS_QuickSaveExists (void) { return vkq_quick_loadable ? 1 : 0; }
+
+// The menu's own load path does teardown (m_state, key_dest, loading plaque)
+// before issuing the command; a raw `load quick` from a button would leave the
+// menu up over a loading level. Both of these return you to the game, which is
+// the point of "quick".
+static void VKQ_QuickSave_f (void)
+{
+	if (!VKQ_iOS_QuickSaveAvailable ())
+		return;
+	Cbuf_AddText ("save quick\n");
+	m_state = m_none;
+	IN_Activate ();
+	key_dest = key_game;
+}
+
+static void VKQ_QuickLoad_f (void)
+{
+	M_ScanSaves (); // refresh: the quicksave may have been made this session
+	if (!vkq_quick_loadable)
+	{
+		Con_Printf ("No quick save.\n");
+		return;
+	}
+	m_state = m_none;
+	IN_Activate ();
+	key_dest = key_game;
+	SCR_BeginLoadingPlaque ();
+	Cbuf_AddText ("load quick\n");
+}
+#endif
+
 static void M_Menu_Load_f (void)
 {
 	M_MenuChanged ();
