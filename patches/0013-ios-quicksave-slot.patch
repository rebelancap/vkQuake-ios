vkquake-ios overlay 0013: quick save / quick load as a first-class slot.

vkQuake already had 'save quick' / 'load quick' (bindable in the Keys menu)
but the Load menu enumerates s0..s19 by filename, so quick.sav was invisible
and recoverable only from the console. This surfaces it as a TOP-MOST
pseudo-slot (LOAD cursor 0 = quick, 1..MAX = s0..s(MAX-1)) drawn bright, so
no numbered slot is stolen. Adds vkq_quicksave / vkq_quickload for the iOS
menu chrome, which do the same teardown the menu's own load path does, and
VKQ_iOS_QuickSaveAvailable() so the shell only offers them from the first
main menu of a live single-player game.

diff --git a/Quake/menu.c b/Quake/menu.c
--- a/Quake/menu.c
+++ b/Quake/menu.c
@@ -64,6 +64,9 @@ static void M_Help_Draw (cb_context_t *cbx);
 static void M_Quit_Draw (cb_context_t *cbx);
 
 static void M_Main_Key (int key);
+#ifdef VKQ_IOS
+static void M_ScanSaves (void); // main menu refreshes the quick-slot state
+#endif
 static void M_SinglePlayer_Key (int key);
 static void M_Load_Key (int key);
 static void M_Save_Key (int key);
@@ -683,6 +686,13 @@ void M_Menu_Main_f (void)
 	IN_Deactivate (true);
 	key_dest = key_menu;
 	m_state = m_main;
+#ifdef VKQ_IOS
+	// Refresh the quick-slot state here, not just when the Load/Save menu opens:
+	// the shell's QUICK LOAD button reads it, and a quicksave made from the
+	// button or a keybind would otherwise leave it stale until you happened to
+	// visit the Load menu — the button simply would not appear.
+	M_ScanSaves ();
+#endif
 }
 
 static qpic_t *Get_Menu2 ()
@@ -980,6 +990,15 @@ int load_cursor; // 0 < load_cursor < MAX_SAVEGAMES
 #define MAX_SAVEGAMES 20 /* johnfitz -- increased from 12 */
 char m_filenames[MAX_SAVEGAMES][SAVEGAME_COMMENT_LENGTH + 1];
 int	 loadable[MAX_SAVEGAMES];
+#ifdef VKQ_IOS
+// `save quick` writes quick.sav, which the Load menu never listed because it
+// enumerates s0..s19 by filename — so a quicksave was invisible and only
+// recoverable by `load quick`. Surface it as a TOP-MOST pseudo-slot instead of
+// stealing a numbered one: LOAD cursor 0 is quick, 1..MAX map to s0..s(MAX-1).
+static qboolean vkq_quick_loadable;
+static char		vkq_quick_comment[SAVEGAME_COMMENT_LENGTH + 1];
+#define VKQ_LOAD_ROWS (MAX_SAVEGAMES + 1)
+#endif
 
 static void M_ScanSaves (void)
 {
@@ -1018,7 +1037,71 @@ static void M_ScanSaves (void)
 			break;
 		}
 	}
+
+#ifdef VKQ_IOS
+	// same dual lookup the numbered slots use above: com_gamedir first, then the
+	// legacy save dir when there is one (upstream 1.36.0's COM_GetLegacySaveDir).
+	q_strlcpy (vkq_quick_comment, "--- NO QUICK SAVE ---", sizeof (vkq_quick_comment));
+	vkq_quick_loadable = false;
+	for (j = 0; j < (have_legacy_saves ? 2 : 1); ++j)
+	{
+		q_snprintf (name, sizeof (name), "%s/quick.sav", j ? legacy_dir : com_gamedir);
+		f = Sys_fopen (name, "r");
+		if (!f)
+			continue;
+		if (fscanf (f, "%i\n", &version) == 1 && fscanf (f, "%79s\n", name) == 1)
+		{
+			q_strlcpy (vkq_quick_comment, name, SAVEGAME_COMMENT_LENGTH + 1);
+			for (k = 0; k < SAVEGAME_COMMENT_LENGTH; k++)
+				if (vkq_quick_comment[k] == '_')
+					vkq_quick_comment[k] = ' ';
+			vkq_quick_loadable = true;
+		}
+		fclose (f);
+		if (vkq_quick_loadable)
+			break;
+	}
+#endif
+}
+
+#ifdef VKQ_IOS
+// Availability for the shell's quick save/load chrome: a LIVE single-player game
+// AND the first main menu — not a submenu, and never over the HUD.
+int VKQ_iOS_QuickSaveAvailable (void)
+{
+	return (sv.active && !cl.intermission && svs.maxclients == 1 && key_dest == key_menu && m_state == m_main) ? 1 : 0;
+}
+int VKQ_iOS_QuickSaveExists (void) { return vkq_quick_loadable ? 1 : 0; }
+
+// The menu's own load path does teardown (m_state, key_dest, loading plaque)
+// before issuing the command; a raw `load quick` from a button would leave the
+// menu up over a loading level. Both of these return you to the game, which is
+// the point of "quick".
+static void VKQ_QuickSave_f (void)
+{
+	if (!VKQ_iOS_QuickSaveAvailable ())
+		return;
+	Cbuf_AddText ("save quick\n");
+	m_state = m_none;
+	IN_Activate ();
+	key_dest = key_game;
+}
+
+static void VKQ_QuickLoad_f (void)
+{
+	M_ScanSaves (); // refresh: the quicksave may have been made this session
+	if (!vkq_quick_loadable)
+	{
+		Con_Printf ("No quick save.\n");
+		return;
+	}
+	m_state = m_none;
+	IN_Activate ();
+	key_dest = key_game;
+	SCR_BeginLoadingPlaque ();
+	Cbuf_AddText ("load quick\n");
 }
+#endif
 
 static void M_Menu_Load_f (void)
 {
@@ -1044,6 +1127,12 @@ static void M_Menu_Save_f (void)
 	IN_Deactivate (true);
 	key_dest = key_menu;
 	M_ScanSaves ();
+#ifdef VKQ_IOS
+	// LOAD has one extra row (quick) and both menus share load_cursor — coming
+	// from the bottom of LOAD would otherwise index past the SAVE list.
+	if (load_cursor >= MAX_SAVEGAMES)
+		load_cursor = MAX_SAVEGAMES - 1;
+#endif
 }
 
 static void M_Load_Draw (cb_context_t *cbx)
@@ -1054,11 +1143,21 @@ static void M_Load_Draw (cb_context_t *cbx)
 	p = Draw_CachePic ("gfx/p_load.lmp");
 	M_DrawPic (cbx, (320 - p->width) / 2, 4, p);
 
+#ifdef VKQ_IOS
+	// quick save on top, drawn bright so it reads as a different kind of slot
+	M_PrintWhite (cbx, 16, 32, vkq_quick_comment);
+	for (i = 0; i < MAX_SAVEGAMES; i++)
+		M_Print (cbx, 16, 32 + 8 * (i + 1), m_filenames[i]);
+
+	// line cursor
+	M_Mouse_UpdateListCursor (&load_cursor, 16, 320, 32, 8, VKQ_LOAD_ROWS, 0);
+#else
 	for (i = 0; i < MAX_SAVEGAMES; i++)
 		M_Print (cbx, 16, 32 + 8 * i, m_filenames[i]);
 
 	// line cursor
 	M_Mouse_UpdateListCursor (&load_cursor, 16, 320, 32, 8, MAX_SAVEGAMES, 0);
+#endif
 	Draw_Character (cbx, 8, 32 + load_cursor * 8, 12 + ((int)(realtime * 4) & 1));
 }
 
@@ -1093,8 +1192,13 @@ static void M_Load_Key (int k)
 	case K_KP_ENTER:
 	case K_ABUTTON:
 		S_LocalSound ("misc/menu2.wav");
+#ifdef VKQ_IOS
+		if (load_cursor == 0 ? !vkq_quick_loadable : !loadable[load_cursor - 1])
+			return;
+#else
 		if (!loadable[load_cursor])
 			return;
+#endif
 
 		// Draw before leaving the menu so disconnected loads don't expose the console.
 		SCR_BeginLoadingPlaque ();
@@ -1104,23 +1208,40 @@ static void M_Load_Key (int k)
 		key_dest = key_game;
 
 		// issue the load command
+#ifdef VKQ_IOS
+		if (load_cursor == 0)
+			Cbuf_AddText ("load quick\n");
+		else
+			Cbuf_AddText (va ("load s%i\n", load_cursor - 1));
+#else
 		Cbuf_AddText (va ("load s%i\n", load_cursor));
+#endif
 		return;
 
 	case K_UPARROW:
 	case K_LEFTARROW:
 		S_LocalSound ("misc/menu1.wav");
 		load_cursor--;
+#ifdef VKQ_IOS
+		if (load_cursor < 0)
+			load_cursor = VKQ_LOAD_ROWS - 1;
+#else
 		if (load_cursor < 0)
 			load_cursor = MAX_SAVEGAMES - 1;
+#endif
 		break;
 
 	case K_DOWNARROW:
 	case K_RIGHTARROW:
 		S_LocalSound ("misc/menu1.wav");
 		load_cursor++;
+#ifdef VKQ_IOS
+		if (load_cursor >= VKQ_LOAD_ROWS)
+			load_cursor = 0;
+#else
 		if (load_cursor >= MAX_SAVEGAMES)
 			load_cursor = 0;
+#endif
 		break;
 	}
 }
@@ -4846,6 +4967,10 @@ void M_Init (void)
 	Cmd_AddCommand ("menu_load", M_Menu_Load_f);
 	Cmd_AddCommand ("menu_save", M_Menu_Save_f);
 	Cmd_AddCommand ("menu_maps", M_Menu_Maps_Cmd_f);
+#ifdef VKQ_IOS
+	Cmd_AddCommand ("vkq_quicksave", VKQ_QuickSave_f);
+	Cmd_AddCommand ("vkq_quickload", VKQ_QuickLoad_f);
+#endif
 	Cmd_AddCommand ("menu_multiplayer", M_Menu_MultiPlayer_f);
 	Cmd_AddCommand ("menu_setup", M_Menu_Setup_f);
 	Cmd_AddCommand ("menu_options", M_Menu_Options_f);
