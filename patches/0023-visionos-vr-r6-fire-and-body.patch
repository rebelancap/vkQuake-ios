+// Before the think: put the clock belonging to the weapon that is about to act
+// onto the edict, and remember the value so "a shot left" is a comparison.
+static void VKQ_VR_PreThink (edict_t *ent, int num)
+{
+	float *af;
+	vkq_vr_af_watch = 0;
+	VKQ_VR_ShiftToMuzzle (ent, num);
+	if (!vkq_vr_active || num != cl.viewentity || !VKQ_VR_ImmersiveActive ())
+		return;
+	af = vkq_vr_attack_finished (ent);
+	if (!af)
+		return;
+	if (vkqvr_dualclock.value >= 0.5f && vkq_vr_dual_wield ())
+	{
+		// WHICH weapon is about to act, from the server's own state only: the
+		// impulse QC has not consumed yet if there is one (W_WeaponFrame runs
+		// ImpulseCommands before it tests button0), otherwise the weapon it is
+		// already holding.
+		const int pend = (int)ent->v.impulse;
+		const int imp = (pend >= 1 && pend <= 8) ? pend : VKQ_VR_WeaponImpulse ((int)ent->v.weapon);
+		if (imp >= 1 && imp <= 8 && imp != vkq_vr_af_cur)
+		{
+			if (vkq_vr_af_cur >= 1 && vkq_vr_af_cur <= 8)
+				vkq_vr_af_wclock[vkq_vr_af_cur] = *af;
+			*af = vkq_vr_af_wclock[imp];
+			vkq_vr_af_cur = imp;
+		}
+	}
+	vkq_vr_af_before = *af;
+	vkq_vr_ammo_before = ent->v.currentammo;
+	vkq_vr_weap_before = ent->v.weapon;
+	vkq_vr_af_watch = 1;
+}
