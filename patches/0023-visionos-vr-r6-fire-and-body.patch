+extern cvar_t vkqvr_dualclock;
+extern int	  VKQ_VR_FireOwner (void);
+extern int	  vkq_vr_fire_auth_hand; // whose shot THIS usercmd authorised, or -1
+extern void	  VKQ_VR_NoteDischarge (int serverWeapon);
+extern int	  VKQ_VR_ImmersiveActive (void);
