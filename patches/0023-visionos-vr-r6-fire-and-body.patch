 // The hand a shot leaves from THIS frame. Normally the aim hand; in Immersive
 // dual wield it is whichever trigger is firing, so aim, muzzle, crosshair and
 // the barrel-true projectile origin all follow the hand that pulled. One
 // accessor, so they cannot disagree.
 static int vkq_vr_active_hand (void) { return (vkq_vr_shoot_hand >= 0) ? vkq_vr_shoot_hand : vkq_vr_aim_hand (); }
+
+// ============================================================================
+// overlay 0023 — R6 part A: THE FIRE SCHEDULER
+//
+// R4/R5 fired from a bare latch (`vkq_vr_shoot_hand`) that was recomputed from
+// scratch every frame: aim hand first, off hand only if the aim hand was idle.
+// the user reported both of the defects that shape implies.
+//
+// BUG 1 — "if I'm shooting the nail gun with my right hand it won't let me
+// shoot with my left". The aim hand wins the `if` every frame it is held, so the
+// off hand is never selected while the aim trigger is down. The off hand was not
+// starved by an arbitration policy; there was no arbitration.
+//
+// BUG 2 — the cross-fire: a nail out of the rocket launcher while only the LEFT
+// trigger was held. This one is a race, and it is worth writing down because the
+// shape recurs anywhere an impulse and a button share a usercmd.
+//
+//   * stock weapons.qc: W_WeaponFrame runs ImpulseCommands() and THEN tests
+//     self.button0, in that order, in one frame. A queued weapon switch is
+//     therefore consumed by the same frame that services a held trigger.
+//   * an unprocessed impulse PERSISTS: SV_ReadClientMove only writes
+//     ent->v.impulse when the incoming byte is nonzero, and QC clears it in
+//     ImpulseCommands. So an impulse we sent frames ago can still be sitting on
+//     the edict.
+//   * W_WeaponFrame's FIRST line is `if (time < self.attack_finished) return;`,
+//     so while a refire clock is running the impulse is not even read — it waits.
+//   * `cl.stats[STAT_ACTIVEWEAPON]` is a server round-trip stale, so the client
+//     cannot see a switch that is in flight.
+//
+// Put together: the idle "keep the server holding what the aim hand holds" sync
+// queues an impulse for the AIM hand's weapon; the player pulls the OFF hand's
+// trigger; the client sees ACTIVEWEAPON already equal to the off hand's weapon
+// (the stale value), sends no impulse, and holds +attack; QC then processes the
+// queued aim-hand switch first and fires THAT weapon. A nail leaves the rocket
+// launcher, exactly as reported.
+//
+// The scheduler below owns `in_impulse` and `in_attack` for firing, and both
+// bugs die structurally rather than by tuning:
+//
+//   THE WEAPON-MATCH GATE. `in_attack` is held only when the server's active
+//   weapon IS the owner hand's weapon and no switch is unresolved, or when the
+//   scheduler is itself issuing that exact weapon's select impulse in this same
+//   usercmd (which overwrites any stale one on the edict). A switch we could not
+//   send, or a foreign impulse we do not own, always means a skipped attack.
+//
+//   FAIR HANDOFF. Ownership passes on the DISCHARGE, not on a timer: the
+//   server-side barrel-true hook (overlay 0020, sv_phys.c) watches the player
+//   edict's attack_finished across the think that fires and reports the moment a
+//   shot actually left. A timer backstop exists only for the case a discharge
+//   can never come (an empty gun must not own the pipeline forever).
+// ============================================================================
+
+// Ownership. -1 = nobody is firing.
+static int	  vkq_vr_fire_owner = -1;
+static int	  vkq_vr_fire_last = -1;	 // whose shot went out most recently (handoff order)
+static double vkq_vr_fire_since = 0.0;	 // when the current owner took the pipeline
+static double vkq_vr_fire_yield_until = 0.0; // hold +attack RELEASED until this time
+static int	  vkq_vr_fire_pending = 0;	 // weapon we asked for and have not seen land (-1 = a foreign impulse)
+static double vkq_vr_fire_pending_t = 0.0;
+static int	  vkq_vr_fire_gate_block = 0; // frames the match gate suppressed a trigger (diagnostic)
+static int	  vkq_vr_fire_handoffs = 0;
+static int	  vkq_vr_fire_shots[2] = {0, 0};
+
+// A2's availability is decided in sv_phys.c (does this progs have an
+// attack_finished field?) and reported here, so one line answers both "is the
+// scheduler arbitrating" and "is each hand keeping its own refire clock".
+extern int	VKQ_VR_ClockAvailable (void);
+extern void VKQ_VR_ClockReset (void);
+extern int	VKQ_VR_ClockReady (int hand);
+
+// The discharge signal, written by the server hook (sv_phys.c) and read here.
+// `vkq_vr_fire_owner` is what it attributes the shot to, so the two agree by
+// construction rather than by a second guess about which hand was firing.
+int	   vkq_vr_fire_discharged = 0;
+double vkq_vr_fire_discharge_t = 0.0;
+static int vkq_vr_fire_crossfire = 0; // the invariant, CHECKED at every shot
+// The weapon the scheduler AUTHORISED +attack for, this frame and last frame.
+//
+// The first version of this check compared the server's fired weapon against
+// whatever hand owned the pipeline at the instant of the discharge, and counted
+// 44 "cross-fires" in 91 handoffs — one per handoff, because the server is
+// consuming a usercmd the client built a frame or two ago while the client has
+// already flipped ownership. That is frame skew in the INSTRUMENT, not a defect
+// in the thing measured, and a counter that fires once per handoff would have
+// been useless for the bug it exists to catch.
+//
+// Two frames of history make the check say exactly what the gate promises: a
+// shot may only ever leave a weapon the scheduler authorised a trigger for.
+// the user's bug fails it loudly — there, the weapon that fired was the AIM hand's
+// while only the OFF hand's trigger was held, so it was never authorised at all.
+static int vkq_vr_fire_auth[2] = {0, 0};
+// The HAND the current usercmd authorises a shot for, or -1. The server's clock
+// swap follows THIS, not the client's live owner: the client re-decides
+// ownership every rendered frame while the server consumes usercmds at the net
+// rate, so "who owns the pipeline right now" and "whose shot is in the packet
+// the server is about to run" are different questions. Answering the first one
+// let a rocket launcher's 0.8 s refire land on the NAILGUN's clock, which is
+// exactly the jam per-hand clocks exist to remove (measured: 3.50 nails/s
+// against 10.12 solo).
+int vkq_vr_fire_auth_hand = -1;
+// When each weapon (by impulse 1-8) was last authorised. A discharge of anything
+// not authorised inside VKQ_VR_FIRE_AUTH_WINDOW is a cross-fire.
+static double vkq_vr_fire_authtime[9] = {0};
+#define VKQ_VR_FIRE_AUTH_WINDOW 0.35
+
+// A hand that cannot discharge (out of ammo, a weapon whose refire is longer
+// than the other's whole cycle) must not own the pipeline forever, so ownership
+// times out as well. Long enough that it never pre-empts a legitimately slow
+// weapon's shot, short enough that a dry gun does not read as a jam.
+#define VKQ_VR_FIRE_YIELD_MAX	0.60
+// How long a select impulse may be unresolved before we assume it was refused
+// (no ammo, a mod that ignores it) and stop suppressing the trigger for it.
+#define VKQ_VR_FIRE_PENDING_MAX 0.50
+// How long +attack stays released at a handoff. Long enough that the release is
+// certain to reach the server at the net rate (~14 ms per usercmd at 72 Hz) and
+// that a chain-fire weapon leaves its think chain; short enough to be invisible.
+#define VKQ_VR_FIRE_YIELD_MS	0.06
+
+int VKQ_VR_FireOwner (void) { return vkq_vr_fire_owner; }
+void VKQ_VR_FireReset (void);
+
+/*
+==================
+VKQ_VR_NoteDischarge -- overlay 0023 (R6 part A1)
+
+Called from the server think hook at the exact moment a shot left, with the
+SERVER's own idea of which weapon fired (`self.weapon`, not the client's
+round-trip-stale STAT_ACTIVEWEAPON — comparing against that would false-alarm on
+the frame a switch is in flight, which is precisely the frame under suspicion).
+
+Two jobs: it is the handoff signal, and it is the cross-fire ASSERTION. The
+match gate is supposed to make "the weapon that fired is the owner hand's
+weapon" structurally true; this counts every time it was not. A number that
+stays 0 through a two-minute dual-fire soak is the evidence; a comment is not.
+==================
+*/
+void VKQ_VR_NoteDischarge (int serverWeapon)
+{
+	const int owner = vkq_vr_fire_owner;
+	vkq_vr_fire_discharge_t = Sys_DoubleTime ();
+	// Attributed to whoever owns the pipeline. Requiring the fired weapon to
+	// MATCH the owner's was tried, and it starves the incoming hand: a weapon
+	// mid-burst keeps firing for a frame or two after the handoff, so the new
+	// owner's turn never registers and it is handed back before it can shoot.
+	// The cross-fire check below does not rely on this attribution — it compares
+	// against what the triggers authorised, which is skew-proof.
+	vkq_vr_fire_discharged = 1;
+	if (owner >= 0)
+		vkq_vr_fire_shots[owner]++;
+	// Only meaningful while the scheduler is actually driving a trigger: a shot
+	// from the gamepad, the touch layer or a bind authorises nothing here and is
+	// not a cross-fire.
+	{
+		const int	 imp = vkq_vr_weapon_impulse (serverWeapon);
+		const double now = Sys_DoubleTime ();
+		int			 anyRecent = 0, i;
+		for (i = 1; i <= 8; i++)
+			if (vkq_vr_fire_authtime[i] > 0.0 && now - vkq_vr_fire_authtime[i] <= VKQ_VR_FIRE_AUTH_WINDOW)
+				anyRecent = 1;
+		// Only meaningful while the scheduler is actually driving a trigger: a
+		// shot from the gamepad, the touch layer or a bind authorises nothing
+		// here and is not a cross-fire.
+		if (anyRecent && (imp < 1 || imp > 8 || now - vkq_vr_fire_authtime[imp] > VKQ_VR_FIRE_AUTH_WINDOW))
+		{
+			vkq_vr_fire_crossfire++;
+			Con_DPrintf ("VR CROSS-FIRE: the server fired imp%d, which no trigger authorised in the last %.2f s\n", imp, VKQ_VR_FIRE_AUTH_WINDOW);
+		}
+	}
+}
 
+// Anything OUTSIDE the scheduler that sends a weapon-select impulse says so
+// here, so the match gate can see the switch it would otherwise be blind to.
+static void vkq_vr_fire_note_pending (int itembit)
+{
+	vkq_vr_fire_pending = itembit;
+	vkq_vr_fire_pending_t = Sys_DoubleTime ();
+}
+
+void VKQ_VR_FireReset (void)
+{
+	vkq_vr_fire_owner = vkq_vr_fire_last = -1;
+	vkq_vr_fire_since = vkq_vr_fire_discharge_t = vkq_vr_fire_pending_t = 0.0;
+	vkq_vr_fire_pending = vkq_vr_fire_discharged = 0;
+	vkq_vr_fire_yield_until = 0.0;
+	vkq_vr_fire_auth[0] = vkq_vr_fire_auth[1] = 0;
+	vkq_vr_fire_auth_hand = -1;
+	memset (vkq_vr_fire_authtime, 0, sizeof (vkq_vr_fire_authtime));
+	// NOT the counters: gateblocked / handoffs / shots / crossfire are session
+	// totals a harness and a device log read, and zeroing them on every mode
+	// change would hide exactly the runs worth looking at.
+	VKQ_VR_ClockReset ();
+}
+
+/*
+==================
+vkq_vr_fire_schedule -- overlay 0023 (R6 part A1)
+
+Runs once per input frame in Immersive, from VKQ_VR_ApplyHandInput, and is the
+ONLY writer of in_attack and of in_impulse-for-firing while a trigger is down.
+Returns the weapon the owner hand is firing (0 = nobody).
+
+`want[hand]` is "this trigger is down on a hand that is holding something". The
+policy is small on purpose:
+  - nobody wants it            -> release, forget the owner
+  - one hand wants it          -> that hand owns it continuously (SOLO: identical
+                                  to 1.0.7.8, full rate, no handoff, no gate
+                                  churn — the other hand is not in the picture)
+  - both want it               -> alternate on each discharge
+==================
+*/
+static int vkq_vr_fire_schedule (double now, int aim, int off, unsigned bAim, unsigned bOff)
+{
+	const int wantA = ((bAim & VKQ_VRB_TRIGGER) != 0) && vkq_vr_held_item_get (aim) != 0;
+	const int wantO = ((bOff & VKQ_VRB_TRIGGER) != 0) && vkq_vr_held_item_get (off) != 0;
+	const int activeW = cl.stats[STAT_ACTIVEWEAPON];
+	int		  ownerW, issued = 0, fire = 0;
+
+	// --- resolve the pending switch ------------------------------------------
+	// A pending impulse is one we cannot see the result of yet. It clears when
+	// the server confirms it, and it EXPIRES so that an impulse the progs
+	// refused (no ammo for that weapon, a mod that ignores it) cannot suppress
+	// firing forever. Failing open here is safe because the match gate below
+	// still requires activeW to equal the owner's weapon.
+	if (vkq_vr_fire_pending > 0 && activeW == vkq_vr_fire_pending)
+		vkq_vr_fire_pending = 0;
+	if (vkq_vr_fire_pending != 0 && (now - vkq_vr_fire_pending_t) > VKQ_VR_FIRE_PENDING_MAX)
+		vkq_vr_fire_pending = 0;
+
+	// AN ACTIVE WEAPON WE DID NOT ASK FOR is somebody else changing it under us —
+	// `impulse 9` (the All Weapons cheat) force-sets the server's weapon, and so
+	// does a mod, a bind or the console. Treat it as an unresolved switch so the
+	// match gate stops firing until things settle; without this the frames still
+	// in flight put shots through a gun no trigger is holding. (Measured: three
+	// lightning-gun shots in a two-minute soak that pressed All Weapons every 20 s
+	// while both triggers were down. The residual is pure round-trip lag and
+	// cannot be closed from the client.)
+	if (vkq_vr_fire_owner >= 0 && activeW && activeW != vkq_vr_held_item_get (vkq_vr_fire_owner) && vkq_vr_fire_pending == 0)
+	{
+		vkq_vr_fire_pending = -1;
+		vkq_vr_fire_pending_t = now;
+	}
+
+	// --- ownership ------------------------------------------------------------
+	if (vkq_vr_fire_owner >= 0)
+	{
+		const int stillWants = (vkq_vr_fire_owner == aim) ? wantA : wantO;
+		const int otherWants = (vkq_vr_fire_owner == aim) ? wantO : wantA;
+		if (!stillWants)
+			vkq_vr_fire_owner = -1;
+		else
+		{
+			// A discharge means this owner is doing its job, so the starvation
+			// timeout below measures "how long since this hand last managed a
+			// shot" rather than "how long it has held the pipeline". Without
+			// this the timeout fires mid-burst and hands the pipeline to a
+			// weapon that is still reloading — the stall again, on a clock.
+			if (vkq_vr_fire_discharged)
+				vkq_vr_fire_since = now;
+		}
+		if (vkq_vr_fire_owner >= 0 && otherWants)
+		{
+			// HANDOFF, on two conditions and never on a guess.
+			//
+			// The discharge is the signal: the server hook reports the exact
+			// think in which a shot left, so the pipeline changes hands on a real
+			// shot rather than on an estimate of how long one takes. But it hands
+			// over only to a hand that can ACTUALLY SHOOT — parking the pipeline
+			// on a weapon whose refire clock is still running would stall the
+			// hand that was firing for exactly the interval per-hand clocks exist
+			// to remove, and plain alternation would therefore throttle a nailgun
+			// to the rocket launcher's 0.8 s. (With no per-hand clocks available
+			// ClockReady answers 1 and this degrades to strict alternation, which
+			// is the documented fallback.)
+			//
+			// The timeout is the second door, and it is for the hand that can
+			// never discharge at all — dry, or holding something the progs will
+			// not fire. It must not be able to starve a hand that can.
+			const int other = vkq_vr_fire_owner ^ 1;
+			if ((vkq_vr_fire_discharged && VKQ_VR_ClockReady (other)) || (now - vkq_vr_fire_since) > VKQ_VR_FIRE_YIELD_MAX)
+			{
+				vkq_vr_fire_last = vkq_vr_fire_owner;
+				vkq_vr_fire_owner = -1;
+				// +attack RELEASED for a fixed WALL-CLOCK interval, not one frame.
+				//
+				// One frame is not enough and the reason is not obvious: usercmds
+				// go out at the net rate while this runs per rendered frame, so a
+				// single frame's release can be overwritten before any packet
+				// carries it — the server never sees the button clear. It has to
+				// see it, because stock QC's chain-fire weapons only leave their
+				// think chain on a frame where button0 is clear, and until the
+				// chain leaves, `W_WeaponFrame` returns above ImpulseCommands and
+				// the other hand's weapon switch is never read at all.
+				vkq_vr_fire_yield_until = now + VKQ_VR_FIRE_YIELD_MS;
+				vkq_vr_fire_handoffs++;
+			}
+		}
+	}
+	vkq_vr_fire_discharged = 0;
+
+	if (vkq_vr_fire_owner < 0 && (wantA || wantO) && now >= vkq_vr_fire_yield_until)
+	{
+		if (wantA && wantO)
+			vkq_vr_fire_owner = (vkq_vr_fire_last == aim) ? off : aim; // alternate
+		else
+			vkq_vr_fire_owner = wantA ? aim : off;
+		vkq_vr_fire_since = now;
+	}
+
+	if (vkq_vr_fire_owner < 0)
+	{
+		vkq_vr_hold (&in_attack, false);
+		vkq_vr_shoot_hand = -1;
+		vkq_vr_fire_auth[1] = vkq_vr_fire_auth[0];
+		vkq_vr_fire_auth[0] = 0;
+		vkq_vr_fire_auth_hand = -1;
+		return 0;
+	}
+
+	ownerW = vkq_vr_held_item_get (vkq_vr_fire_owner);
+	vkq_vr_shoot_hand = vkq_vr_fire_owner;
+
+	// --- the weapon-match gate -------------------------------------------------
+	if (activeW != ownerW || (vkq_vr_fire_pending != 0 && vkq_vr_fire_pending != ownerW))
+	{
+		// A switch is needed. We may only take in_impulse if nothing else has it
+		// this frame — the cycle path, a holster select and the console all write
+		// the same latch, and quietly stomping one of those is how a gesture goes
+		// missing. Our impulse overwrites any STALE one already on the edict
+		// (SV_ReadClientMove writes every nonzero byte), which is what makes a
+		// same-frame switch-and-fire safe.
+		const int imp = vkq_vr_weapon_impulse (ownerW);
+		if (imp > 0 && (in_impulse == 0 || in_impulse == imp))
+		{
+			in_impulse = imp;
+			vkq_vr_fire_pending = ownerW;
+			vkq_vr_fire_pending_t = now;
+			issued = 1;
+		}
+		else if (in_impulse != 0)
+		{
+			// Somebody else's impulse is going out this frame. It may well change
+			// the weapon, so this frame CANNOT fire: an attack that rides out
+			// beside a foreign switch is precisely the cross-fire.
+			vkq_vr_fire_pending = -1;
+			vkq_vr_fire_pending_t = now;
+		}
+	}
+
+	// The impulse and the attack may ride the SAME usercmd (weapons.qc runs
+	// ImpulseCommands and then tests button0 inside one frame), but only when the
+	// scheduler issued that impulse itself — which is the weapon-match gate.
+	//
+	// Requiring the switch to LAND first was tried and is much worse: it costs a
+	// round trip at every handoff, and because stock QC's chain-fire weapons
+	// re-arm attack_finished on every nail, the waiting hand's switch then sits
+	// behind the OTHER weapon's refire. Measured, that configuration ran the
+	// nailgun at 0.12 nails/s against 10.12 solo.
+	fire = (ownerW != 0) && ((activeW == ownerW && vkq_vr_fire_pending == 0) || issued);
+	// Record what this usercmd authorises, keeping one frame of history: the
+	// server consumes the cmd a frame or two later and the check at the discharge
+	// compares against both (see vkq_vr_fire_auth).
+	vkq_vr_fire_auth[1] = vkq_vr_fire_auth[0];
+	vkq_vr_fire_auth[0] = fire ? ownerW : 0;
+	vkq_vr_fire_auth_hand = fire ? vkq_vr_fire_owner : -1;
+	// A weapon is AUTHORISED while a trigger is down on the hand holding it —
+	// both hands, every frame, not only the hand the gate let through. That is
+	// the invariant the user cares about ("nothing leaves a gun whose trigger I am
+	// not holding"), and stamping only the firing hand made the OTHER held
+	// weapon's in-flight shots read as cross-fire during a two-minute soak in
+	// which both triggers were down the whole time.
+	{
+		int h;
+		for (h = 0; h < 2; h++)
+		{
+			const int down = (h == aim) ? ((bAim & VKQ_VRB_TRIGGER) != 0) : ((bOff & VKQ_VRB_TRIGGER) != 0);
+			const int imp = vkq_vr_weapon_impulse (vkq_vr_held_item_get (h));
+			if (down && imp >= 1 && imp <= 8)
+				vkq_vr_fire_authtime[imp] = now;
+		}
+	}
+	if (!fire)
+		vkq_vr_fire_gate_block++;
+	vkq_vr_hold (&in_attack, fire != 0);
+	if (!fire)
+		vkq_vr_shoot_hand = -1; // nothing is leaving a barrel this frame
+	return fire ? ownerW : 0;
+}
