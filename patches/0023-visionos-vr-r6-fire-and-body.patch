+// PER-WEAPON refire clocks, by impulse 1-8, and which weapon's clock the edict
+// is currently carrying.
+//
+// R6 KEYED THESE BY HAND FIRST, AND THAT WAS WRONG TWICE OVER. A refire clock
+// belongs to the WEAPON, not to the hand holding it — and keying by hand meant
+// asking the client "who owns the pipeline?", whose answer has already moved on
+// by the time the server runs the usercmd (the client re-decides every rendered
+// frame; usercmds go out at the net rate). The rocket launcher's 0.8 s therefore
+// landed on the NAILGUN's slot, and the measured cadence under dual fire was
+// 3.50 nails/s against 10.12 solo — 35 %, the very jam A2 exists to remove, in a
+// new place. Keying by weapon is derived entirely from the SERVER's own state
+// (the pending impulse, else self.weapon) and cannot skew.
+static float vkq_vr_af_wclock[9];
+static int	 vkq_vr_af_cur = 0;
+
+extern int VKQ_VR_WeaponImpulse (int itembit); // gl_vidsdl.c
+extern int VKQ_VR_HeldItem (int hand);
+
+// Per-weapon clocks apply to DUAL WIELD and nothing else. With one weapon in
+// play the shared clock is stock behaviour — switching weapons carries the
+// cooldown with you, exactly as every Quake ever — and this must not change it.
+static int vkq_vr_dual_wield (void) { return VKQ_VR_ImmersiveActive () && VKQ_VR_HeldItem (0) && VKQ_VR_HeldItem (1); }
+
+// Resolve (once per progs) and return the pointer, or NULL when unavailable.
+static float *vkq_vr_attack_finished (edict_t *ent)
+{
+	if (!ent || !qcvm || !qcvm->progs)
+		return NULL;
+	// Re-resolve whenever the loaded progs changes (a `game` switch, a mod), so
+	// the offset can never belong to a different progs than the edict does.
+	if (vkq_vr_af_progs != qcvm->progshash)
+	{
+		vkq_vr_af_progs = qcvm->progshash;
+		vkq_vr_af_ofs = ED_FindFieldOffset ("attack_finished");
+		memset (vkq_vr_af_wclock, 0, sizeof (vkq_vr_af_wclock));
+		vkq_vr_af_cur = 0;
+		Con_DPrintf (
+			"VR dual clock: attack_finished %s in this progs (%s)\n", vkq_vr_af_ofs >= 0 ? "found" : "ABSENT",
+			vkq_vr_af_ofs >= 0 ? "per-weapon refire clocks available" : "falling back to the shared clock");
+	}
+	if (vkq_vr_af_ofs < 0)
+		return NULL;
+	return &GetEdictFieldValue (ent, vkq_vr_af_ofs)->_float;
+}
+
+void VKQ_VR_ClockReset (void)
+{
+	memset (vkq_vr_af_wclock, 0, sizeof (vkq_vr_af_wclock));
+	vkq_vr_af_cur = 0;
+}
