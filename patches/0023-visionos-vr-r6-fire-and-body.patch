+*/
+int VKQ_VR_ClockReady (int hand)
+{
+	edict_t *ent;
+	eval_t	*val;
+	float	 t;
+	int		 imp;
+	if (hand < 0 || hand > 1 || vkq_vr_af_ofs < 0 || vkqvr_dualclock.value < 0.5f)
+		return 1;
+	if (!sv.active || !svs.clients || svs.maxclients < 1 || !svs.clients[0].active)
+		return 1;
+	if (vkq_vr_af_progs != sv.qcvm.progshash)
+		return 1; // resolved against a different progs: fail open until the next think
+	imp = VKQ_VR_WeaponImpulse (VKQ_VR_HeldItem (hand));
+	if (imp < 1 || imp > 8)
+		return 1;
+	t = (float)sv.qcvm.time;
+	if (imp != vkq_vr_af_cur)
+		return (vkq_vr_af_wclock[imp] <= t) ? 1 : 0;
+	ent = svs.clients[0].edict;
+	val = GetEdictFieldValue (ent, vkq_vr_af_ofs);
+	return (!val || val->_float <= t) ? 1 : 0;
 }
