+static int		vkq_vr_af_ofs = -1;	 // field offset, or -1 = absent
+static unsigned vkq_vr_af_progs = 0; // which progs that offset was resolved against
+static float	vkq_vr_af_before = 0.0f;
+static int		vkq_vr_af_watch = 0;
+// A shot also spends ammo, and for some weapons that is the ONLY signal.
+static float vkq_vr_ammo_before = 0.0f;
+static float vkq_vr_weap_before = 0.0f;
