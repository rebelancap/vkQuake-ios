+#ifdef VKQ_IOS
+// overlay 0039: the shell changed the layer's contentsScale — adopt the new
+// natural size and rebuild the swapchain next frame (same steps as the
+// SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED handler in in_sdl3.c).
+void VKQ_iOS_DrawableSizeChanged (void)
+{
+	int w = VID_GetCurrentWidth ();
+	int h = VID_GetCurrentHeight ();
+	if (!draw_context || w <= 0 || h <= 0 || (w == (int)vid.width && h == (int)vid.height))
+		return;
+	Con_Printf ("vkQuake: drawable %dx%d -> %dx%d\n", (int)vid.width, (int)vid.height, w, h);
+	vid.width = w;
+	vid.height = h;
+	vid.restart_next_frame = true;
+	Cvar_FindVar ("scr_conscale")->callback (NULL);
+}
+#endif
