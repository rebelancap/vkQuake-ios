+// other extent — so the size the engine believes in must come from the layer,
+// not from SDL's bounds x screen.nativeScale.
+extern int VKQ_iOS_DrawableSize (int *w, int *h);
+#endif
 static int VID_GetCurrentWidth (void)
 {
